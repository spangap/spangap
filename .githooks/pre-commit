#!/bin/sh
# Keep spangap.sha256 in sync with the launcher.
#
# install.sh verifies the downloaded `spangap` launcher against spangap.sha256
# and hard-fails on a mismatch, so a stale checksum would break every install.
# This hook regenerates + re-stages it whenever `spangap` is part of the commit,
# so the two can never drift. Enabled per-clone (same as the DCO hook) via:
#
#     git config core.hooksPath .githooks
#
# See CONTRIBUTING.md.

# Only act when the launcher itself is staged.
if git diff --cached --name-only | grep -qx 'spangap'; then
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum spangap > spangap.sha256
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 spangap > spangap.sha256
    else
        echo "pre-commit: no sha256 tool found — cannot refresh spangap.sha256" >&2
        exit 1
    fi
    git add spangap.sha256
fi

exit 0
