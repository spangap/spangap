SCHEMA_PATH = Path("/usr/local/share/spangap/straddle.schema.json")
# Straddles live under one of two flat, container-native roots — no symlinks,
# no host paths inside:
#   /straddles/<repo>  the flat --straddles checkout, bind-mounted here whole
#                      when `init --straddles` was used (one mount, every
#                      straddle a direct child). Because it's flat, the browser
#                      `file:../../<sibling>` deps resolve straight through.
#   <workspace>/<repo> git clones (the no-straddles case), plus any dep cloned
#                      because it wasn't present under --straddles.
# The workspace dir itself also holds the marker, the dotfiles, and the per-host
# venv; non-straddle entries have no straddle.yaml and are skipped. Builds bake
# the container path (e.g. /straddles/<repo>) into CMakeCache, so it's stable
# and host-independent.
#
# The workspace is bind-mounted at /home/spangap/<basename-of-host-workspace>
# (nested under the persistent ~ = /home/spangap mount), not a fixed path — so
# spangap-outside passes its container path in via SPANGAP_WORKSPACE on every
# `docker exec`. Fall back to walking up from cwd for the marker (covers a
# hand-run spangap-inside with no env set).
def _discover_workspace() -> Path:
    env = os.environ.get("SPANGAP_WORKSPACE")
    if env:
        return Path(env)
    cur = Path.cwd()
    for d in (cur, *cur.parents):
        if (d / "spangap.workspace.yaml").is_file():
            return d
    return cur


WORKSPACE = _discover_workspace()
