# ---------------------------------------------------------------------------
# `spangap cli [<cmd and args>]` — reach the device, foolproof.
#
# One address (.spangap-tcp, a bare host) drives every transport. The flow makes
# a working connection out of nothing, in order:
#   1. ensure a local ed25519 key (ssh-keygen on first use).
#   2. ssh in (port 22) — one-shot `exec` with args, an interactive shell without.
#   3. ssh failed → the legacy TCP CLI (port 2323) if that socket answers.
#   4. ssh port open but our key refused → print the `sshd add <pubkey>` line.
#   5. nothing answers → the device is unreachable: ask for its IP/host and retry.
#
# Inside the container we can't route to the device's LAN, so every probe goes
# through host.docker.internal and the bridge `spangap monitor` owns splices to
# the device (it forwards 22 and 2323 only — so those two ports are all we can
# probe here). On a native-Linux host host.docker.internal isn't injected and the
# bridge network reaches the LAN directly, so we dial the device host itself.
# `-h <host>` (re)writes .spangap-tcp; the port belongs to the transport, not the
# address, so a stray ":port" is tolerated on read but never stored.
# ---------------------------------------------------------------------------
PROMPT = b"$ "
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new",
            "-o", "ConnectTimeout=10"]


def parse_endpoint(text: str, default_port: int) -> tuple[str, int]:
    """Split "<host>:<port>" (port optional) on the last colon. Bracketed IPv6
    literals ("[::1]:22") keep their colons inside the brackets."""
    text = text.strip()
    if text.startswith("[") and "]" in text:
        hostpart, _, rest = text[1:].partition("]")
        port = int(rest[1:]) if rest.startswith(":") and rest[1:] else default_port
        return hostpart, port
    host, sep, p = text.rpartition(":")
    if sep and host and p.isdigit():
        return host, int(p)
    return text, default_port


def _connect_host(host: str, port: int) -> str:
    """Reach the device via the monitor's bridge at host.docker.internal when it
    resolves (Docker Desktop), else dial the device host directly (native Linux)."""
    try:
        socket.getaddrinfo("host.docker.internal", port)
        return "host.docker.internal"
    except OSError:
        return host


def _default_device_host() -> str:
    """The project's `<default_hostname>.local` — the device's out-of-the-box
    mDNS name, used when .spangap-tcp was never set."""
    m = default_project()
    if m is None:
        # find_project walks up from cwd; it die()s when nothing resolves, which
        # is fine to absorb here — a missing default just yields a bare guess.
        try:
            m = find_project()
        except SystemExit:
            m = None
    return f"{m.default_hostname}.local" if m is not None else "device.local"


def device_host(set_to: str | None = None) -> str:
    """The active device address. With `set_to`, persist it (bare host) first.
    Otherwise read .spangap-tcp, falling back to the project default — which is
    written through so the monitor's bridge and the web UI see the same address."""
    if set_to is not None:
        host = parse_endpoint(set_to, SSH_PORT)[0]
        # Constrain to the hostname / IPv4 / IPv6-literal grammar (brackets are
        # already unwrapped by parse_endpoint). Not because anything evaluates it
        # — every consumer passes it as argv — but so the file can't hold spaces
        # or glob chars that would split/expand in the host bridge's `$specs`.
        if not re.fullmatch(r"[A-Za-z0-9._:%-]+", host):
            die(f"invalid device address {set_to!r} — expected a hostname or IP")
        TCP_FILE.write_text(f"{host}\n")
        return host
    if TCP_FILE.is_file():
        host = parse_endpoint(TCP_FILE.read_text(), SSH_PORT)[0]
        if host:
            return host
    host = _default_device_host()
    TCP_FILE.write_text(f"{host}\n")
    return host


def _ensure_ssh_key() -> Path:
    key = Path.home() / ".ssh" / "id_ed25519"
    if not key.is_file():
        key.parent.mkdir(mode=0o700, exist_ok=True)
        subprocess.run(["ssh-keygen", "-t", "ed25519", "-N", "", "-f", str(key), "-q"],
                       check=True)
    return key


def _ssh_argv(host: str, rest: list[str]) -> list[str]:
    ssh = shutil.which("ssh") or "ssh"
    return [ssh, "-p", str(SSH_PORT), *SSH_OPTS, _connect_host(host, SSH_PORT), *rest]


def _ssh_auth_ok(host: str) -> bool:
    """Can we ssh in non-interactively right now? Probe with a no-op remote."""
    try:
        r = subprocess.run(_ssh_argv(host, ["true"]),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=15)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def _port_answers(host: str, port: int, timeout: float = 5.0) -> bool:
    """True only when <host>:<port> speaks — at least one byte arrives. A bare
    connect proves nothing here: on Docker Desktop every probe lands on the
    host-side bridge, which accepts unconditionally and only then dials the
    device, so a dead device port still connects and then falls silent. Both
    ports we probe talk first (sshd its version banner, the TCP CLI its
    prompt), so silence means unreachable."""
    try:
        s = socket.create_connection((_connect_host(host, port), port), timeout=timeout)
    except OSError:
        return False
    try:
        s.settimeout(timeout)
        return bool(s.recv(1))
    except OSError:
        return False
    finally:
        s.close()


def _print_authorize(host: str, key: Path) -> None:
    pub = key.with_suffix(".pub").read_text().strip()
    print(f"\nReached {host}, but its sshd won't accept this key. In the device "
          f"serial monitor, authorize it:\n")
    print(f"    sshd add {pub}\n")
    print("sshd ships enabled; on an older build also run: sshd enable")
    print("If sshd isn't in your build, rebuild with: spangap build --with spangap/sshd")
    print("\nThen re-run `spangap cli`.")


def cmd_cli(argv: list[str]) -> int:
    override: str | None = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-h":
            if i + 1 >= len(argv):
                die("spangap cli: -h needs a hostname")
            override = argv[i + 1]
            i += 2
        elif a == "--":
            i += 1
            break
        else:
            break
    rest = argv[i:]

    host = device_host(set_to=override)
    key = _ensure_ssh_key()

    while True:
        if _ssh_auth_ok(host):                       # 2. ssh in
            argv2 = _ssh_argv(host, rest)
            os.execvp(argv2[0], argv2)               # replaces this process
        if _port_answers(host, TCP_CLI_PORT):        # 3. legacy TCP CLI
            return _tcp_cli_client(host, rest)
        if _port_answers(host, SSH_PORT):            # 4. sshd up, key not trusted
            _print_authorize(host, key)
            return 1
        # 5. nothing answers — the device is unreachable from here.
        print(f"spangap cli: can't reach {host} on ssh ({SSH_PORT}) or the TCP "
              f"CLI ({TCP_CLI_PORT}).", file=sys.stderr)
        print("If this is a Mac, make sure `spangap monitor` is running on the "
              "host — it bridges the container to the device.", file=sys.stderr)
        try:
            entry = input("Device IP or hostname (blank to give up): ").strip()
        except EOFError:
            entry = ""
        if not entry:
            return 1
        host = device_host(set_to=entry)


def _tcp_cli_client(host: str, rest: list[str]) -> int:
    """Legacy line-oriented TCP CLI (builds without the sshd straddle)."""
    port = int(os.environ.get("SPANGAP_CLI_PORT", TCP_CLI_PORT))
    connect_host = _connect_host(host, port)
    try:
        s = socket.create_connection((connect_host, port), timeout=10)
    except OSError as e:
        die(f"cli: connect {connect_host}:{port} (bridge → {host}): {e}")
    s.settimeout(None)

    def drain():
        buf = b""
        while not buf.endswith(PROMPT):
            d = s.recv(4096)
            if not d:
                break
            buf += d
        return buf

    if rest:
        drain()
        s.sendall((" ".join(rest) + "\n").encode())
        out = drain()
        # Filter the trailing prompt line. drain() returns the moment the buffer
        # ends with the device's prompt, and that prompt is a whole line —
        # "<name> $ " (e.g. "reticulous $ "), not a bare "$ " — so the final
        # line is always the re-emitted prompt. Drop everything after the last
        # newline; if there's none, the whole response was just the prompt.
        nl = out.rfind(b"\n")
        out = out[: nl + 1] if nl != -1 else b""
        sys.stdout.buffer.write(out)
        sys.stdout.flush()
        return 0

    sel = selectors.DefaultSelector()
    sel.register(sys.stdin, selectors.EVENT_READ)
    sel.register(s, selectors.EVENT_READ)
    try:
        while True:
            for key, _ in sel.select():
                if key.fileobj is sys.stdin:
                    data = sys.stdin.buffer.read1(4096)
                    if not data:
                        return 0
                    s.sendall(data)
                else:
                    data = s.recv(4096)
                    if not data:
                        return 0
                    sys.stdout.buffer.write(data)
                    sys.stdout.flush()
    except KeyboardInterrupt:
        return 0


# ---------------------------------------------------------------------------
# `spangap web [-w/--with …] [-x/--without …]` — regenerate the browser half
# alone, no compile.
#
# A build's only contribution to the SPA is generated input in the buildable's
# browser dir: src/boot/straddles.gen.ts (the registration dispatcher + the
# declarative settings panels), src/app-icons/, and the `file:` deps in
# package.json. Everything else Vite serves is source it reads live — the
# straddle browser halves are npm-linked and kept out of dep pre-bundling
# (quasar.config.ts), so an edit there is picked up by HMR with no build at all.
# This verb writes exactly that generated set, so a straddle-set change reaches
# a running `spangap dev` without an IDF run.
#
# Bare, it regenerates for the remembered build (.spangap-build) — the browser
# half then matches the firmware the device is running. -w/-x override the
# staged set for a one-off and are NOT remembered; a build re-asserts its own.
# ---------------------------------------------------------------------------
def cmd_web(args: argparse.Namespace) -> int:
    all_straddles = scan_workspace_straddles()
    proj = find_project()
    if not proj.has_browser:
        die(f"spangap web: {proj.name} has no web SPA "
            f"({proj.browser_dir.name}/package.json missing)")

    included = {_resolve_org_repo(r, all_straddles, "--with")
                for r in (args.include or [])}
    excluded = {_resolve_org_repo(r, all_straddles, "--without")
                for r in (args.exclude or [])}
    if not included and not excluded:
        rb = remembered_build()
        if rb is not None:
            r_inc, r_exc, _, _ = parse_selection(rb[1])
            included |= r_inc
            excluded |= r_exc

    deps, _ = resolve_requires(
        proj, all_straddles, excluded=excluded, included=included)
    pkg_path = proj.browser_dir / "package.json"
    before = pkg_path.read_text()
    write_browser_dispatch(proj, deps)
    print(f"spangap web: regenerated {proj.name}'s browser half "
          f"({len(deps)} straddles staged)", file=sys.stderr)
    # The generated imports only resolve once node_modules holds a link per
    # `file:` dep, so a changed dep set needs npm to relink. Steady state
    # rewrites nothing and this is skipped.
    if not (proj.browser_dir / "node_modules").is_dir() or pkg_path.read_text() != before:
        print("spangap web: browser deps changed — npm install…", file=sys.stderr)
        if subprocess.run(["npm", "install"], cwd=proj.browser_dir).returncode != 0:
            die("spangap web: npm install failed")
    return 0


# ---------------------------------------------------------------------------
# `spangap make-builds [entry…]` — build an image catalogue.
#
# A catalogue is a directory holding a `builds.yaml` that lists what to compile.
# Run in one, it builds that catalogue; run in a directory whose children are
# catalogues, it builds every one of them.
#
#     spangap make-builds                 build this catalogue (or every child one)
#     spangap make-builds hw-x [hw-y …]   build only these entries, in a catalogue
#
# Each entry's `invocation:` is the argument list of a `spangap build`. The
# flasher.zip that build leaves behind is copied in beside the config as
# <slug>_<name>_<datetime>.zip, and every image built in one run shares that one
# datetime. That entry's earlier images in that catalogue are then deleted: one
# entry in one catalogue means one image, and the flasher only ever offers the
# newest per name, so the older ones are download weight in the deployment and
# noise in the listing. Only the entries a run actually built are pruned, and
# only strictly older stamps, so a subset run disturbs nothing else. Alongside
# the zips this writes:
#
#     index.html   the listing, and the record of which images exist at which
#                  stamp — a consumer reads it to learn what the newest image for
#                  a board is
#     timestamp    the newest stamp present, for cheap polling: a consumer that
#                  sees it change re-reads index.html
#
# A catalogue directory holding `.unlisted` still builds and is still reachable
# by name; it is simply left out of the parent listing.
#
# **Every straddle a run compiles has to be in the workspace already.** Cloning
# one is the host's job and only the host's: a missing dependency is fetched with
# the host's git credentials, which this container does not have. So the host
# dispatcher asks a run for the invocations it covers (`--invocations`) and puts
# each of them through its clone + list-deps loop before handing the run in here.
# A target still absent by then is an operator-visible fault rather than
# something to paper over, so the pre-flight in cmd_make_builds names it and
# stops before anything is built.
#
# A clean run prints one line per catalogue and one per image, and nothing else:
# each build's output is captured. The first failing build ends the run — the
# entries built before it keep their fresh images, the listing is still rewritten
# to match what is on disk, the captured output of the failure is printed so it
# can be diagnosed, and the exit status is non-zero.
# ---------------------------------------------------------------------------

CATALOGUE_CONFIG = "builds.yaml"
CATALOGUE_UNLISTED = ".unlisted"


def _catalogue_config(path: Path) -> tuple[str, list[tuple[str, str]], dict[str, str]]:
    """Return (project, [(name, invocation), …], {name: onboarding}) from a
    builds.yaml. Keys this doesn't use (a consumer's branding, per-entry photos)
    are ignored rather than rejected.

    `onboarding:` is the one optional per-entry key that ends up in the listing:
    `device` says this image sets a fresh node up from its own screen, so a
    flasher has nothing to ask and should get out of the way once the image is
    written. Anything else (and the absence of the key) means the flasher asks —
    which is the only safe default, since a build that cannot ask for itself and
    is never asked is a node nobody ever set up.
    """
    try:
        doc = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as exc:
        die(f"{path}: {exc}")
    if not isinstance(doc, dict):
        die(f"{path}: expected a mapping with a `builds:` list")
    project = str(doc.get("project") or "")
    entries: list[tuple[str, str]] = []
    onboarding: dict[str, str] = {}
    for n, raw in enumerate(doc.get("builds") or [], 1):
        if not isinstance(raw, dict) or not raw.get("name"):
            die(f"{path}: build #{n} has no name")
        name = str(raw["name"])
        if not raw.get("invocation"):
            die(f"{path}: build '{name}' has no invocation")
        entries.append((name, str(raw["invocation"])))
        if raw.get("onboarding"):
            onboarding[name] = str(raw["onboarding"])
    return project, entries, onboarding


def _catalogue_slug(project: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", project.lower()).strip("-") or "builds"


def _catalogue_zips(d: Path) -> list[str]:
    """The images in a catalogue directory, newest first. The stamp is the last
    underscore-separated field of the name, and sorts lexicographically."""
    names = [p.name for p in d.iterdir() if p.suffix == ".zip"]
    return sorted(names, key=lambda n: (n[:-4].rsplit("_", 1)[-1], n), reverse=True)


def _split_image_name(name: str) -> tuple[str, str] | None:
    """An image filename as (entry, stamp), or None if it isn't one of ours.
    Images are <slug>_<entry>_<stamp>.zip; the entry may carry underscores, the
    stamp never does, so the split is from the right."""
    if not name.endswith(".zip"):
        return None
    head, _, stamp = name[:-4].rpartition("_")
    if not head or not stamp.isdigit():
        return None
    _, _, entry = head.partition("_")            # drop the project slug
    return (entry, stamp) if entry else None


def _prune_older_images(d: Path, entry: str, keep_stamp: str) -> None:
    """Delete this entry's earlier images from this catalogue, now that a newer
    one is in. One entry in one catalogue means one image: the older ones are the
    same distribution at a stamp nothing will ever ask for again — the flasher
    offers the newest per name, so they are download weight in the deployment and
    noise in the listing.

    Scoped to the entry, and only to what is strictly older, so a subset run
    leaves every other board's images exactly as they were. The slug is ignored
    when matching, so images from before a `project:` rename are collected too —
    the entry name and the directory are what identify a distribution, and the
    slug is branding that rode along."""
    for name in sorted(p.name for p in d.iterdir()):
        got = _split_image_name(name)
        if not got:
            continue
        e, stamp = got
        if e != entry or stamp >= keep_stamp:
            continue
        try:
            (d / name).unlink()
        except OSError as exc:
            warn(f"make-builds: could not remove {name}: {exc}")


def _fmt_bytes(n: int) -> str:
    for unit, div in (("MB", 1 << 20), ("KB", 1 << 10)):
        if n >= div:
            v = n / div
            return "%s %s" % (int(v) if v == int(v) else round(v, 1), unit)
    return f"{n} bytes"


def _listing_page(title: str, rows: list[tuple[str, str, str, str]]) -> str:
    """A listing page. Deliberately plain: it is read by a browser and parsed by
    the flasher, and all a parser wants is the hrefs.

    A row may carry attributes on its anchor (`attrs`) — facts about that image
    the flasher needs BEFORE it fetches it. They go on the anchor rather than
    into an HTML comment because a comment is only ever near the row it is about,
    while an attribute is part of it: one parser pass reads the href and the
    facts together, and no amount of reordering or reformatting can separate
    them. A browser shows the page exactly as before."""
    items = "\n".join('<li><a href="%s"%s>%s</a>%s</li>' % (href, attrs, text, extra)
                      for href, text, extra, attrs in rows)
    return ("<!doctype html>\n"
            "<meta charset=\"utf-8\">\n"
            "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
            "<title>%s</title>\n"
            "<h1>%s</h1>\n"
            "<ul>\n%s\n</ul>\n" % (title, title, items))


def _write_listing(d: Path, project: str, onboarding: dict[str, str]) -> None:
    """Rewrite a catalogue's index.html + timestamp from what is on disk, so both
    describe the images actually there — including any a subset run left alone.

    `onboarding` maps entry name → the mode declared in builds.yaml, and each
    image whose entry declares one carries it as `data-onboarding` on its link.
    Derived from the config rather than from the zip, so an entry that changes
    its answer is re-described by the next run over that catalogue even if the
    image itself was not rebuilt."""
    names = _catalogue_zips(d)
    rows = []
    for n in names:
        got = _split_image_name(n)
        mode = onboarding.get(got[0]) if got else None
        rows.append((n, n,
                     " <small>(%s)</small>" % _fmt_bytes((d / n).stat().st_size),
                     ' data-onboarding="%s"' % mode if mode else ""))
    title = "%s builds — %s" % (project or "spangap", d.name)
    (d / "index.html").write_text(_listing_page(title, rows), encoding="utf-8")
    newest = names[0][:-4].rsplit("_", 1)[-1] if names else ""
    (d / "timestamp").write_text(newest + "\n", encoding="utf-8")


def _write_root_listing(root: Path, catalogues: list[Path]) -> None:
    """Rewrite the tree's own index.html: every catalogue except the ones marked
    .unlisted, which stay reachable by name and out of the listing."""
    rows = [(d.name + "/", d.name, "", "")
            for d in sorted(catalogues)
            if not (d / CATALOGUE_UNLISTED).exists()]
    (root / "index.html").write_text(_listing_page("builds", rows), encoding="utf-8")


def _build_catalogue(d: Path, project: str, chosen: list[tuple[str, str]],
                     onboarding: dict[str, str], all_straddles: dict[str, Manifest],
                     run_dt: str) -> str | None:
    """Build the selected entries of one catalogue. Returns the name of the entry
    that failed, or None."""
    slug = _catalogue_slug(project)
    failed = None
    print(f"Catalog: {d.name}", flush=True)
    for name, inv in chosen:
        toks = shlex.split(inv)
        # The invocation leads with the buildable (the pre-flight resolved it);
        # its own straddle dir is where the build leaves esp-idf/build/flasher.zip.
        target = resolve_target_straddle(toks[0], all_straddles)
        assert target is not None
        zip_src = target.firmware_dir / "build" / "flasher.zip"
        sys.stdout.write(f"  {inv} ...")
        sys.stdout.flush()
        # This entry's name is the image's distribution identity: free-format, and
        # separate from the sortable stamp because the two answer different
        # questions — which image this is, versus whether something newer exists.
        # The build bakes it in; the device reports it back as sys.build.dist.
        #
        # The catalogue's own directory name (`stable`, `dev`, …) goes in beside
        # it: it is the channel the image was published on, which a flasher needs
        # to know before any stamp comparison means anything — the newest image
        # in `stable` is not newer than a `dev` image that happens to sort below
        # it. The device reports it back as sys.build.catalogue.
        env = {**os.environ,
               "SPANGAP_BUILD_DATETIME": run_dt,
               "SPANGAP_BUILD_DIST": name,
               "SPANGAP_BUILD_CATALOGUE": d.name}
        # The `spangap` wrapper rather than this file, so each image is compiled
        # by exactly the command an operator would type, with the IDF environment
        # set up the way every other build gets it. Output is captured, not
        # streamed: a clean run says nothing beyond the line above.
        proc = subprocess.run(
            ["spangap", "build", *toks], cwd=WORKSPACE, env=env,
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, text=True,
        )
        if proc.returncode != 0 or not zip_src.is_file():
            # The first failure ends the run: the remaining entries build from the
            # same tree, so whatever broke this one most likely breaks them too,
            # and stopping here leaves the error at the end of the output. The
            # suppression lifts with it — a build nobody can see fail is worse
            # than a noisy one.
            sys.stdout.write(" FAILED\n")
            sys.stdout.flush()
            sys.stderr.write(proc.stdout or "")
            reason = (f"exited {proc.returncode}" if proc.returncode
                      else f"left no {zip_src}")
            sys.stderr.write(f"spangap: make-builds: `spangap build {inv}` {reason}\n")
            failed = name
            break
        zipname = f"{slug}_{name}_{run_dt}.zip"
        shutil.copyfile(zip_src, d / zipname)
        sys.stdout.write(" done (%.1f MB)\n" % ((d / zipname).stat().st_size / (1 << 20)))
        sys.stdout.flush()
        # The new image is on disk, so this entry's older ones are superseded.
        # After the copy, never before: a failed build must leave the image that
        # is still the current one exactly where it was.
        _prune_older_images(d, name, run_dt)
    _write_listing(d, project, onboarding)
    return failed


def cmd_make_builds(args: argparse.Namespace) -> int:
    sel = set(args.entries or [])
    cwd = Path.cwd()
    run_dt = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")

    # One catalogue (a builds.yaml here) or every catalogue below us. Either way
    # the parent of the catalogues gets its own listing rewritten, so a run in
    # one of them still leaves the tree's index describing all of them.
    if (cwd / CATALOGUE_CONFIG).is_file():
        catalogues = [cwd]
        root = cwd.parent
    else:
        catalogues = sorted(p for p in cwd.iterdir()
                            if (p / CATALOGUE_CONFIG).is_file())
        if not catalogues:
            die(f"make-builds: no {CATALOGUE_CONFIG} here, and no subdirectory "
                f"holding one — run this in a catalogue directory or in the tree "
                f"above them")
        if sel:
            die(f"make-builds: naming entries only works inside a single "
                f"catalogue directory (this run covers {len(catalogues)} of them)")
        root = cwd
    siblings = sorted(p for p in root.iterdir() if (p / CATALOGUE_CONFIG).is_file())

    plan = []
    for d in catalogues:
        project, entries, onboarding = _catalogue_config(d / CATALOGUE_CONFIG)
        if not entries:
            die(f"make-builds: {d / CATALOGUE_CONFIG}: no builds")
        known = {n for n, _ in entries}
        for want in sorted(sel - known):
            die(f"make-builds: no build named '{want}' in {d / CATALOGUE_CONFIG}")
        plan.append((d, project, [e for e in entries if not sel or e[0] in sel],
                     onboarding))

    if args.invocations:
        # The host dispatcher's shopping list: what this exact run would compile,
        # so it can clone each invocation's straddles before the run itself.
        for _, _, chosen, _ in plan:
            for _, inv in chosen:
                print(inv)
        return 0

    # Pre-flight. Nothing here clones — the host does that, with the credentials
    # this container hasn't got — so a target that is not on disk ends the run
    # before it starts, naming what is missing and who wants it.
    all_straddles = scan_workspace_straddles()
    absent: dict[str, list[str]] = {}
    for d, _, chosen, _ in plan:
        for name, inv in chosen:
            toks = shlex.split(inv)
            if not toks or toks[0].startswith("-"):
                die(f"make-builds: {d.name}/{name}: an entry's invocation must "
                    f"start with the straddle it builds ({inv!r})")
            if resolve_target_straddle(toks[0], all_straddles) is None:
                absent.setdefault(toks[0], []).append(f"{d.name}/{name}")
    if absent:
        die("make-builds: not in the workspace: "
            + "; ".join(f"{t} (wanted by {', '.join(w)})"
                        for t, w in sorted(absent.items()))
            + "\n       Clone it from the HOST — `spangap build <org>/<repo>` or "
              "`spangap get-deps` there fetches with the host's git credentials. "
              "This container has none, so it cannot fetch it for you.")

    failed = None
    for d, project, chosen, onboarding in plan:
        failed = _build_catalogue(d, project, chosen, onboarding, all_straddles, run_dt)
        if failed:
            break
    _write_root_listing(root, siblings)
    if failed:
        die(f"make-builds: build '{failed}' failed")
    return 0


# ---------------------------------------------------------------------------
# `spangap dev [-h <host>]` — run the project's Quasar dev server, reachable
# from outside the container.
#
# The buildable's `browser:` dir (reticulous → web-interface/) is the Quasar SPA.
# We bind 0.0.0.0 on the port the host picked for us out of the published range
# (SPANGAP_DEV_BIND — one per concurrent run, see spangap-outside
# ensure_container), and the host-side `spangap dev` passes the browser URL that
# ends up fronting it in SPANGAP_DEV_URL. The dev server reverse-proxies the
# device, so the page is same-origin with it and drives the real hardware. Runs
# in the foreground: Quasar's console streams until you quit it (Ctrl-C). The URL
# is printed here; the host-side `spangap dev` also opens it in the OS browser.
# ---------------------------------------------------------------------------
def cmd_dev(argv: list[str]) -> int:
    override: str | None = None
    i = 0
    while i < len(argv):
        if argv[i] == "-h":
            if i + 1 >= len(argv):
                die("spangap dev: -h needs a hostname")
            override = argv[i + 1]
            i += 2
        elif argv[i] == "--":
            i += 1
            break
        else:
            break
    rest = argv[i:]

    proj = find_project()
    if not proj.has_browser:
        die(f"spangap dev: {proj.name} has no web SPA "
            f"({proj.browser_dir.name}/package.json missing)")
    web = proj.browser_dir
    if not (web / "node_modules").is_dir():
        print(f"spangap dev: installing {web.name} deps (first run)…", file=sys.stderr)
        if subprocess.run(["npm", "install"], cwd=web).returncode != 0:
            die("spangap dev: npm install failed")

    host = device_host(set_to=override)
    # The dev server's proxy runs in the container, which on Docker Desktop can't
    # route to the device's LAN — so it dials the host at host.docker.internal,
    # where the host-side `spangap dev` is relaying this device's TLS port for
    # the length of the run (SPANGAP_DEV_PROXY_PORT names the relay's port; it is
    # this run's own, so a second run can serve a second device). On a
    # native-Linux host the container reaches the LAN directly and _connect_host
    # hands back the device address itself, relay or no relay.
    proxy_target = _connect_host(host, WSS_PORT)
    relay_port = os.environ.get("SPANGAP_DEV_PROXY_PORT", "")
    if proxy_target != host and relay_port:
        proxy_target = f"{proxy_target}:{relay_port}"
    # The host picks which port in the published range we bind (one per
    # concurrent run), publishes it to an ephemeral host port, fronts that on a
    # predictable one and passes the resulting browser URL in SPANGAP_DEV_URL —
    # none of which we can see from in here. Both fall back to the range's first
    # port for a bare `spangap dev` run straight inside the container.
    bind_port = os.environ.get("SPANGAP_DEV_BIND") or str(DEV_PORT)
    url = os.environ.get("SPANGAP_DEV_URL") or f"http://localhost:{bind_port}/"
    print(f"\nspangap dev: serving {proj.name}, proxying the device ({host}) "
          f"via {proxy_target}. Browse to:\n\n    {url}\n", file=sys.stderr)
    if proxy_target != host and not relay_port:
        print("(reached through the `spangap monitor` bridge — make sure a "
              "monitor is running)\n", file=sys.stderr)

    # SPANGAP_DEVICE tells quasar.config.ts what to proxy /auth, /state and the
    # /webrtc signaling to, so the dev origin is same-origin with the device and
    # the session cookie / login flow work unchanged. A bare host means the
    # device's own https port (443); host:port names a relay that splices to it.
    env = {**os.environ, "SPANGAP_DEVICE": proxy_target}
    cmd = ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", bind_port, *rest]
    proc = subprocess.Popen(cmd, cwd=web, env=env)
    # Ctrl-C reaches quasar directly (it's in our foreground process group); don't
    # let the SIGINT we also catch surface as a traceback — just wait quasar out
    # and hand back its exit code.
    while True:
        try:
            return proc.wait()
        except KeyboardInterrupt:
            continue


def main(argv: list[str] | None = None) -> int:
    raw = sys.argv[1:] if argv is None else argv
    # Pass-through subcommands whose own flag parsing would clash with argparse
    # (their own -h is a hostname, not argparse's --help).
    if raw and raw[0] == "claude":
        return cmd_claude(raw[1:])
    if raw and raw[0] == "cli":
        return cmd_cli(raw[1:])
    if raw and raw[0] == "dev":
        return cmd_dev(raw[1:])

    p = argparse.ArgumentParser(prog="spangap", description="spangap straddles CLI (in-container)")
    # Bare `spangap` (no subcommand) lists the project + deps + environment —
    # what used to be `spangap show`. `show` stays as an explicit alias.
    p.set_defaults(func=cmd_show)
    sub = p.add_subparsers(dest="cmd", required=False)

    sub.add_parser("heal", help="repair workspace repos whose git object store is unreadable in-container (virtiofs truncated packs) by refetching from origin; runs automatically before each build").set_defaults(func=cmd_heal)
    sub.add_parser("validate", help="parse + validate manifest and dep graph").set_defaults(func=cmd_validate)
    sub.add_parser("clean", help="run idf.py fullclean").set_defaults(func=cmd_clean)
    sub.add_parser("reallyclean", help="strip ALL workspace straddles back to source-only state (build/, managed_components/, node_modules/, …)").set_defaults(func=cmd_reallyclean)

    p_build = sub.add_parser("build", help="build the project (default: idf.py build)")
    p_build.add_argument(
        "-v", "--verbose", action="store_true",
        help="show the full IDF / Vite build output. Quiet by default — only "
             "real compiler/build-tool diagnostics (plus a little context) are "
             "kept.",
    )
    p_build.add_argument(
        "-x", "--without", dest="exclude", action="append", default=[], metavar="STRADDLE",
        help="drop a straddle from this build's staged set (repeatable; <org>/<repo> "
             "or bare <repo>). Cascades: every straddle that hard-requires the "
             "target drops with it. Refused only if it would remove spangap-core "
             "or a straddle the buildable hard-requires.",
    )
    p_build.add_argument(
        "-w", "--with", dest="include", action="append", default=[], metavar="STRADDLE",
        help="pull an extra straddle into this build (repeatable). Bare "
             "<repo> must already be a workspace sibling; <org>/<repo> "
             "form is auto-cloned from github if missing.",
    )
    p_build.add_argument(
        "--flash-size", type=int, default=None, metavar="MB",
        help=f"override CONFIG_ESPTOOLPY_FLASHSIZE_*MB for this build. One of "
             f"{', '.join(str(n) for n in _VALID_FLASH_MB)}. Useful for generic "
             f"builds against differently-sized hardware. Probe a chip's actual "
             f"flash size with `esptool.py -p <dev> flash_id`.",
    )
    p_build.add_argument(
        "--kconfig", action="append", default=[], metavar="CONFIG_X=y",
        help="force a Kconfig value for this build (repeatable): a raw "
             "`CONFIG_NAME=value` or `# CONFIG_NAME is not set` line, written to "
             "staging/sdkconfig.spangap-overrides as the highest-priority "
             "SDKCONFIG_DEFAULTS entry (sdkconfig is reseeded when the set "
             "changes, so no clean is needed). This is how a build *flavour* is "
             "expressed — a board's own hardware values belong in its `kconfig:`. "
             "Remembered in .spangap-build alongside --with/--without.",
    )
    for short, full in _NO_SHORTHANDS.items():
        p_build.add_argument(
            f"--no-{short}", dest=f"no_{short}", action="store_true",
            help=f"shorthand for --without {full}",
        )
    p_build.add_argument(
        "idf_args", nargs="*", metavar="[TARGET] [idf args…]",
        help="optional leading TARGET names the buildable to build (its "
             "<org>/<repo>, repo dir, or buildable product name) so you need "
             "not cd into it; everything else is forwarded to idf.py. Without "
             "a TARGET the straddle is resolved from cwd, else the last build "
             "(.spangap-build). TARGET + --with/--without are remembered there.",
    )
    p_build.set_defaults(func=cmd_build)

    p_web = sub.add_parser(
        "web",
        help="regenerate the browser half only (straddles.gen.ts, app-icons, "
             "package.json file: deps) — no IDF compile, so a running "
             "`spangap dev` picks the change up live",
    )
    p_web.add_argument(
        "-w", "--with", dest="include", action="append", default=[], metavar="STRADDLE",
        help="stage an extra straddle's browser half for this run (repeatable). "
             "Not remembered — with no -w/-x the staged set is the last build's.",
    )
    p_web.add_argument(
        "-x", "--without", dest="exclude", action="append", default=[], metavar="STRADDLE",
        help="drop a straddle for this run (repeatable), cascading like the "
             "build's --without. Not remembered.",
    )
    p_web.set_defaults(func=cmd_web)

    p_mb = sub.add_parser(
        "make-builds",
        help="build the image catalogue described by the builds.yaml in cwd "
             "(or every catalogue below it): one datetime stamp across the run, "
             "index.html + timestamp rewritten from what is on disk",
    )
    p_mb.add_argument(
        "entries", nargs="*", metavar="ENTRY",
        help="build only these entries of the catalogue (default: all of them). "
             "The listing is still rewritten from what is on disk, so the "
             "entries you don't name keep their images at their old stamps. "
             "Only inside a single catalogue — a run over the tree above them "
             "refuses it.",
    )
    p_mb.add_argument(
        "--invocations", action="store_true",
        help="print the `spangap build` argument list of every entry this run "
             "would compile, one per line, and exit. Read by the host "
             "dispatcher, which clones each one's missing straddles with the "
             "host's git credentials (this container has none) before handing "
             "the run in here.",
    )
    p_mb.set_defaults(func=cmd_make_builds)

    sub.add_parser(
        "detect-build",
        help="build flashmon/esp-idf (the peripheral detector) with idf.py; "
             "leaves build/spangap_detect.bin for its Makefile to stage",
    ).set_defaults(func=cmd_detect_build)

    p_mc = sub.add_parser(
        "menuconfig",
        help="interactive Kconfig editor (idf.py menuconfig) over the staged project",
    )
    p_mc.add_argument(
        "--save", action="store_true",
        help="after editing, write the minimal sdkconfig.defaults via "
             "idf.py save-defconfig — persists the config into this straddle "
             "(the 'clone a board straddle, configure, save as hw-whatever' step).",
    )
    p_mc.set_defaults(func=cmd_menuconfig)

    sub.add_parser(
        "autoconfig",
        help="leave manual kconfig mode (drop .spangap-manual-kconfig) and reseed "
             "sdkconfig from sdkconfig.defaults on the next build",
    ).set_defaults(func=cmd_autoconfig)

    sub.add_parser(
        "flash",
        help="signal a host running `spangap monitor` to reflash (touches .spangap-flashme)",
    ).set_defaults(func=cmd_flash)

    sub.add_parser(
        "reset",
        help="signal a host running `spangap monitor` to reset the device for a clean boot (touches .spangap-resetme)",
    ).set_defaults(func=cmd_reset)

    p_log = sub.add_parser(
        "log",
        help="print the device serial log captured by `spangap monitor` (streamed from the host relay; -f to follow)",
    )
    p_log.add_argument(
        "-f", "--follow", action="store_true",
        help="follow the log like tail -f, surviving flash/reset truncations (Ctrl-C to stop)",
    )
    p_log.set_defaults(func=cmd_log)

    sub.add_parser(
        "show",
        help="list the project straddle and its dependencies in initialization order",
    ).set_defaults(func=cmd_show)

    p_ld = sub.add_parser(
        "list-deps",
        help="print transitive requires: not yet present as workspace siblings (used by host-side `spangap get-deps`)",
    )
    # The host fetch loop forwards the build's selection so the missing-walk
    # sees what the build will: a --with straddle's additional_installs are
    # only reachable when that straddle seeds the walk as a root. Without this,
    # `build --with hw-lilygo-tdeck` never clones hw-lilygo-tdeck's additional_installs (e.g.
    # spangap-lcd) — the build then silently drops them as soft-and-absent.
    p_ld.add_argument(
        "-w", "--with", dest="include", action="append", default=[], metavar="STRADDLE",
        help="seed the missing-walk with an extra --with straddle (repeatable; "
             "<org>/<repo> or bare <repo>), so its additional_installs are "
             "reported for cloning too.",
    )
    p_ld.add_argument(
        "-x", "--without", dest="exclude", action="append", default=[], metavar="STRADDLE",
        help="mirror the build's --without so the missing-walk matches what the "
             "build will resolve (repeatable).",
    )
    p_ld.set_defaults(func=cmd_list_deps)

    sub.add_parser(
        "list-requires",
        help="print the project's full transitive requires set, in dependency order (read-only diagnostic)",
    ).set_defaults(func=cmd_list_requires)

    args = p.parse_args(argv)
    # Faithful `spangap build ...` command line, baked into the image by
    # cmd_build (via SPANGAP_BUILD_ARGS) and logged on boot.
    args.spangap_invocation = "spangap " + shlex.join(raw)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
