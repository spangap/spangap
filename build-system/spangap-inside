    """Show the last build invocation, its resolved straddle, and the deps.

    The straddle is resolved like a build: the straddle at/above cwd if any,
    else the target of the last build (.spangap-build). The dependency order is
    THE init order (init_order()) — the same order the generated
    spangapInitStraddles() dispatcher fires the straddles in, derived from the
    same resolve_requires() walk that get-deps and the build use. Paths are the
    container-native straddle dirs (<workspace>/<repo> for a git clone).
    """
    cwd_dir = straddle_at_or_above(Path.cwd())
    proj = load_manifest(cwd_dir / "straddle.yaml") if cwd_dir else default_project()

