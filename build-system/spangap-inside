# LOG_PORT — spangap-outside passes it through on every docker exec.
LOG_PORT = int(os.environ.get("SPANGAP_LOG_PORT", "2324"))
# Canonical assistant-instructions file, baked into the image (Dockerfile) and
# seeded into the workspace as CLAUDE.md on first `spangap claude`.
README_PATH = Path("/usr/local/share/spangap/README.md")
WORKSPACE_README_MD = WORKSPACE / "README.md"
WORKSPACE_CLAUDE_MD = WORKSPACE / "CLAUDE.md"
# Readiness-probe marker: `spangap show` drops this and a host-side `spangap
# monitor` deletes it on sight, so its disappearance proves a monitor is up and
# able to flash. Lives at the workspace root (the bind mount) like the other
