SSH_PORT = 22         # device sshd (the spangap/sshd straddle)
TCP_CLI_PORT = 2323   # legacy TCP CLI socket (builds without sshd)
WSS_PORT = 443        # device TLS — what the browser SPA dials (?port= default)
