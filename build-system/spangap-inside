SCHEMA_PATH = Path("/usr/local/share/spangap/straddle.schema.json")
# Straddles live under one of two flat, container-native roots — no symlinks,
# no host paths inside:
#   /repos/<repo>      the flat repo_path checkout, bind-mounted here whole
#                      when `init --repo-path` was used (one mount, every
#                      straddle a direct child). Because it's flat, the browser
#                      `file:../../<sibling>` deps resolve straight through.
#   /workspace/<repo>  git clones (the no-repo_path case), plus any dep cloned
#                      because it wasn't present under repo_path.
# The workspace dir itself (/workspace) also holds the marker, the dotfiles,
# and the per-host venv; non-straddle entries have no straddle.yaml and are
# skipped. Builds bake the container path (e.g. /repos/<repo>) into
# CMakeCache, so it's stable and host-independent.
WORKSPACE = Path("/workspace")
REPOS = Path("/repos")
STRADDLE_ROOTS = (REPOS, WORKSPACE)
HOST_FILE = WORKSPACE / ".spangap-host"


class Manifest:
    """Validated straddle.yaml plus its on-disk location."""

    def __init__(self, manifest_path: Path, data: dict[str, Any]) -> None:
        self.path = manifest_path
        self.dir = manifest_path.parent
        self.data = data

    @property
    def name(self) -> str: return self.data["name"]
    @property
    def org(self) -> str: return self.name.split("/", 1)[0]
    @property
    def repo(self) -> str: return self.name.split("/", 1)[1]
    @property
    def prefix(self) -> str: return self.data["prefix"]
    @property
    def version(self) -> str: return self.data["version"]
    @property
    def firmware_dir(self) -> Path:
        return (self.dir / self.data.get("firmware", "idf")).resolve()
    @property
    def browser_dir(self) -> Path:
        return (self.dir / self.data.get("browser", "browser")).resolve()
    @property
    def has_firmware(self) -> bool:
        return self.firmware_dir.exists() and (self.firmware_dir / "CMakeLists.txt").exists()
    @property
    def has_browser(self) -> bool:
        return self.browser_dir.exists() and (self.browser_dir / "package.json").exists()
    @property
    def requires(self) -> list[str]:
        return list(self.data.get("requires", []))
    @property
    def optional_requires(self) -> list[str]:
        return list(self.data.get("optional_requires", []))
    @property
    def init(self) -> list[dict[str, Any]]:
        return list(self.data.get("init", []))
    @property
    def is_buildable(self) -> bool:
        return "buildable" in self.data


def die(msg: str, exit_code: int = 1):
    sys.stderr.write(f"spangap: {msg}\n")
    sys.exit(exit_code)


def find_project(start: Path | None = None) -> Manifest:
    """Resolve the project straddle for the current invocation.

    Walk up from cwd until straddle.yaml. Each straddle has one container-
    native location (/repos/<repo> or /workspace/<repo>) — no symlinks, no
    host paths — so the CMAKE_HOME_DIRECTORY baked into build/CMakeCache.txt is
    stable and host-independent.

    If nothing is found and we're at the workspace root, fall back to the
    project `spangap init <project>` recorded in .spangap-project — this mirrors
    spangap-outside's require_straddle/default_straddle so `spangap build` (and
    friends) work from the workspace root inside the container too, not only
    from inside the straddle dir.
    """
    origin = (start or Path.cwd()).resolve()
    cur = origin
    while True:
        cand = cur / "straddle.yaml"
        if cand.is_file():
            return load_manifest(cand)
        if cur == cur.parent:
            break
        cur = cur.parent
    if origin == WORKSPACE:
        proj = default_project()
        if proj is not None:
            return proj
        die(
            f"no straddle.yaml at or above {WORKSPACE} and no usable "
            ".spangap-project default.\n"
            "       Run from inside a straddle, or `spangap init <project>` "
            "to set a workspace default."
        )
    die(
        f"no straddle.yaml found at or above {Path.cwd()}.\n"
        "       Run from inside a straddle (a dir with straddle.yaml at its root)."
    )


def default_project() -> Manifest | None:
    """The straddle named by .spangap-project, or None.

    The straddle is at /repos/<name> (repo_path mount) or /workspace/<name>
    (git clone); check both roots.
    """
    proj_file = WORKSPACE / ".spangap-project"
    if not proj_file.is_file():
        return None
    name = proj_file.read_text().strip()
    if not name:
        return None
    for root in STRADDLE_ROOTS:
        cand = root / name / "straddle.yaml"
        if cand.is_file():
            return load_manifest(cand)
    return None


def load_manifest(path: Path) -> Manifest:
    try:
        raw = yaml.safe_load(path.read_text())
    except yaml.YAMLError as e:
        die(f"{path}: invalid YAML — {e}")
    if not isinstance(raw, dict):
        die(f"{path}: top-level must be a mapping")
    schema = json.loads(SCHEMA_PATH.read_text())
    errs = sorted(Draft202012Validator(schema).iter_errors(raw), key=lambda e: e.path)
    if errs:
        for e in errs:
            loc = "/".join(str(p) for p in e.path) or "<root>"
            sys.stderr.write(f"spangap: {path}: {loc}: {e.message}\n")
        die(f"{path}: schema validation failed ({len(errs)} error(s))")
    return Manifest(path, raw)


def scan_workspace_straddles() -> dict[str, Manifest]:
    """Every straddle.yaml visible to the container, indexed by name.

    Walks the two flat straddle roots — /repos (the repo_path mount) and
    /workspace (git clones) — in that order. Both are plain directories of
    real straddle dirs; non-straddle entries (dotfiles, the per-host venv,
    the workspace marker) have no straddle.yaml and are skipped. A name seen
    twice is an error: repo_path and clones are disjoint by construction (a
    dep present under repo_path is never also cloned), so this only fires on
    a mis-set `name:` in a straddle.yaml.
    """
    found: dict[str, Manifest] = {}
    if not WORKSPACE.is_dir():
        die(
            f"{WORKSPACE} not mounted — is the container running with "
            "-v <ws>:/workspace (and -v <repo_path>:/repos when a repo_path "
            "is set)?"
        )

    for root in STRADDLE_ROOTS:
        if not root.is_dir():
            continue
        for child in sorted(root.iterdir()):
            if not child.is_dir():
                continue
            m_path = child / "straddle.yaml"
            if not m_path.is_file():
                continue
            m = load_manifest(m_path)
            if m.name in found:
                die(f"two straddles claim the same name '{m.name}':\n  {found[m.name].path}\n  {m.path}")
            found[m.name] = m
    return found


def resolve_requires(
    proj: Manifest,
    all_straddles: dict[str, Manifest],
    missing_ok: bool = False,
    excluded: set[str] | None = None,
    included: set[str] | None = None,
) -> tuple[list[Manifest], list[str]]:
    """Walk requires: and optional_requires: transitively, plus any
    user-named `included` straddles as extra roots.

    Two tiers in the manifest:
      requires:           hard — always pulled in, missing = error
      optional_requires:  soft, default-on — pruned silently if absent/excluded

    `included` (from --include <name>) seeds the walk with additional roots
    treated as soft: their own requires: / optional_requires: are followed
    transitively just like the buildable's own. The caller is responsible
    for ensuring every name in `included` is on disk (the host-side build
    dispatcher pre-clones slash-form --includes; bare-form is validated
    against the workspace).

    Missing behavior:
      Hard requires: missing → die (unless missing_ok, then collected).
      Soft optional missing from workspace: if missing_ok, COLLECTED for
        cloning; otherwise silently skipped.
      Excluded: silently dropped, no recursion. Excluding a hard
        requires: target is contradictory and errors.
    """
    excluded = excluded or set()
    included = included or set()
    out: list[Manifest] = []
    seen: set[str] = set()
    on_stack: set[str] = set()
    missing: dict[str, str] = {}

    def visit(spec: str, requested_by: str, hard: bool) -> None:
        bare = spec.split("@", 1)[0]
        if bare in seen:
            return
        if bare in excluded:
            if hard:
                die(
                    f"--exclude: {bare} was dropped, but {requested_by} lists it "
                    f"under `requires:` (hard). Either don't exclude it, or "
                    f"reclassify it as optional in {requested_by}'s straddle.yaml."
                )
            return  # soft drop
        if bare in missing:
            return
        if bare in on_stack:
            die(f"requires: cycle through {bare} (from {requested_by})")
        if bare not in all_straddles:
            if missing_ok:
                missing[bare] = spec
                return
            if hard:
                die(
                    f"missing workspace sibling: {bare} (required by {requested_by}).\n"
                    "       Run `spangap get-deps` from this straddle to clone it."
                )
            return  # build path: soft + absent → silently skip
        on_stack.add(bare)
        for dep in all_straddles[bare].requires:
            visit(dep, bare, hard=True)
        for dep in all_straddles[bare].optional_requires:
            visit(dep, bare, hard=False)
        on_stack.discard(bare)
        seen.add(bare)
        out.append(all_straddles[bare])

    for r in proj.requires:
        visit(r, proj.name, hard=True)
    for r in proj.optional_requires:
        visit(r, proj.name, hard=False)
    for r in included:
        visit(r, f"{proj.name} (--include)", hard=False)
    return out, list(missing.values())


def _bare(spec: str) -> str:
    """Strip @<ref> suffix from a requires entry."""
    return spec.split("@", 1)[0]


def _repo(bare_name: str) -> str:
    """Strip org/ prefix — what CMake REQUIRES uses."""
    return bare_name.split("/", 1)[1] if "/" in bare_name else bare_name


def effective_requires(m: Manifest, staged_repos: set[str]) -> list[str]:
    """Cross-straddle REQUIRES list for one component, in repo-only form.

    = hard requires + (optional_requires ∩ staged), order-preserved, deduped.
    Anything in the staged set that this straddle declared as a dep flows
    into its CMake REQUIRES so the include paths line up. Straddles added
    via --include don't appear here directly — they enter the staged set,
    and any straddle that declares them in its own requires/optional_requires
    picks them up through that path.
    """
    out: list[str] = []
    seen: set[str] = set()
    for spec in m.requires:
        r = _repo(_bare(spec))
        if r not in seen:
            seen.add(r); out.append(r)
    for spec in m.optional_requires:
        r = _repo(_bare(spec))
        if r in staged_repos and r not in seen:
            seen.add(r); out.append(r)
    return out


# Top-level docstring (Markdown is fine; reads as `head -1` of the generated file).
_GEN_HEADER_CMAKE = (
    "# AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
    "# Effective cross-straddle REQUIRES for this component, derived from the\n"
    "# straddle's requires: / optional_requires: intersected with the staged set.\n"
)
_GEN_HEADER_KCONFIG = (
    "# AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
    "# Presence symbols for every staged straddle. The hidden STRADDLE_<NAME>\n"
    "# generic is always emitted; SPANGAP_LCD / SPANGAP_WEB shortcuts are also\n"
    "# emitted when those two central straddles are staged (source code gates\n"
    "# on the shortcuts).\n"
)


def _name_to_kconfig(repo: str) -> str:
    """spangap-lcd → SPANGAP_LCD, reticulous-tdeck → RETICULOUS_TDECK."""
    return repo.upper().replace("-", "_").replace(".", "_")


def write_spangap_requires(out_dir: Path, requires_list: list[str]) -> None:
    body = " ".join(requires_list)
    text = _GEN_HEADER_CMAKE + f"set(SPANGAP_REQUIRES {body})\n"
    (out_dir / "spangap_requires.cmake").write_text(text)


def write_presence_component(staging: Path, staged: list[Manifest]) -> None:
    """Emit staging/components/_spangap_present/ — empty IDF component that
    contributes a Kconfig.projbuild defining presence symbols for the staged set.

    Short-form aliases (CONFIG_SPANGAP_<NAME>) are emitted for the well-known
    central straddles below. Source code gates on these; they're a stable
    spelling that survives as the straddle set evolves.
    """
    comp = staging / "_spangap_present"
    comp.mkdir(parents=True, exist_ok=True)
    (comp / "CMakeLists.txt").write_text(
        _GEN_HEADER_CMAKE
        + "# Empty register — this component exists only for its Kconfig.projbuild.\n"
        + "idf_component_register()\n"
    )
    lines: list[str] = [_GEN_HEADER_KCONFIG]
    # repo → short-form Kconfig symbol (the alias used in #if statements).
    shortcut_aliases = {
        "spangap-lcd": "SPANGAP_LCD",
        "spangap-web": "SPANGAP_WEB",
        "ota":         "SPANGAP_OTA",
        "wg":          "SPANGAP_WG",
        "upnp":        "SPANGAP_UPNP",
        "duckdns":     "SPANGAP_DUCKDNS",
        "acme":        "SPANGAP_ACME",
    }
    for m in staged:
        sym = _name_to_kconfig(m.repo)
        lines.append(f"config STRADDLE_{sym}\n    bool\n    default y\n")
        alias = shortcut_aliases.get(m.repo)
        if alias:
            lines.append(f"config {alias}\n    bool\n    default y\n")
    (comp / "Kconfig.projbuild").write_text("\n".join(lines))


_CMAKE_COMMENT_RE = None  # lazily compiled below


def _strip_cmake_comments(text: str) -> str:
    """Drop CMake # comments; bracket-comments are rare and we don't bother."""
    out: list[str] = []
    for line in text.splitlines():
        idx = line.find("#")
        out.append(line[:idx] if idx >= 0 else line)
    return "\n".join(out)


def _extract_requires_tokens(text: str) -> list[str]:
    """Find every idf_component_register(...) REQUIRES list and return the tokens.

    Robust enough for our codebase — CMake parsing is otherwise a rabbit hole.
    Anything that looks like a CMake variable expansion (${...}) is dropped;
    we want to lint hand-written names only.
    """
    stripped = _strip_cmake_comments(text)
    tokens: list[str] = []
    i = 0
    needle = "idf_component_register"
    while True:
        i = stripped.find(needle, i)
        if i < 0:
            break
        # Find the opening paren after the call name.
        op = stripped.find("(", i + len(needle))
        if op < 0:
            break
        # Find the matching closing paren (no nesting in idf_component_register).
        cl = stripped.find(")", op + 1)
        if cl < 0:
            break
        body = stripped[op + 1 : cl]
        i = cl + 1
        # Scan body for REQUIRES <tokens> until the next ALL_CAPS keyword.
        words = body.split()
        in_req = False
        for w in words:
            if w == "REQUIRES":
                in_req = True
                continue
            if w.isupper() and w.replace("_", "").isalpha():
                # New keyword (PRIV_REQUIRES, SRCS, INCLUDE_DIRS, ...). Ends REQUIRES section.
                in_req = (w == "REQUIRES")
                continue
            if in_req and not w.startswith("${"):
                tokens.append(w)
    return tokens


def lint_cmakelists(proj: Manifest, deps: list[Manifest], all_straddles: dict[str, Manifest]) -> None:
    """Fail loud if any staged CMakeLists hand-writes a known straddle name in REQUIRES.

    Forces consumers to flow cross-straddle deps through ${SPANGAP_REQUIRES}, so the
    --no-X / optional_requires machinery actually narrows the dep graph.
    """
    known_repos = {m.repo for m in all_straddles.values()}
    staging = proj.firmware_dir / "staging" / "components"
    targets: list[Path] = []
    for dep in deps:
        cml = staging / dep.repo / "CMakeLists.txt"
        if cml.is_symlink() or cml.is_file():
            targets.append(cml)
    if proj.is_buildable:
        main_cml = proj.firmware_dir / "main" / "CMakeLists.txt"
        if main_cml.is_file():
            targets.append(main_cml)

    offenses: list[tuple[Path, str]] = []
    for cml in targets:
        try:
            text = cml.read_text()
        except OSError:
            continue
        for tok in _extract_requires_tokens(text):
            if tok in known_repos:
                offenses.append((cml, tok))

    if offenses:
        for cml, tok in offenses:
            sys.stderr.write(
                f"spangap: {cml}: hand-written straddle '{tok}' in REQUIRES.\n"
                f"         Cross-straddle deps must flow through ${{SPANGAP_REQUIRES}} so the\n"
                f"         optional_requires / --no-X machinery can narrow them. List '{tok}'\n"
                f"         in the straddle.yaml's requires: or optional_requires: instead.\n"
            )
        die(f"REQUIRES lint failed ({len(offenses)} hand-written straddle name(s))")


def write_main_requires(proj: Manifest, staged_repos: set[str]) -> None:
    """For a buildable straddle, write staging/main_requires.cmake — the
    effective cross-straddle REQUIRES list for the buildable's main component.
    """
    if not proj.is_buildable:
        return
    requires_list = effective_requires(proj, staged_repos)
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    body = " ".join(requires_list)
    text = _GEN_HEADER_CMAKE + f"set(SPANGAP_REQUIRES {body})\n"
    (staging_dir / "main_requires.cmake").write_text(text)


def write_init_dispatch(proj: Manifest, deps: list[Manifest]) -> None:
    """For a buildable, generate staging/spangap_init_dispatch.gen.cpp — the
    spangapInitStraddles() dispatcher that calls every staged straddle's
    declared init: hooks.

    Boot init is order-sensitive, so each hook carries an `order:` and we break
    ties by the dependency-topo order `deps` already arrives in (a straddle
    after the ones it requires:). We forward-declare each init symbol and call
    it directly — referencing the symbol is what keeps it off the linker's
    static-lib GC list (a self-registration constructor in an otherwise-
    unreferenced TU would be dropped). No per-straddle header #include: an
    `--include`d straddle isn't in the buildable's requires graph, so its
    include/ dir isn't on the main component's path — but its component lib IS
    on the link line, so a bare forward decl + call resolves at link time
    regardless.

    Linkage: the decls are emitted with default (C++) linkage to match the
    convention every straddle follows today — a global `void xInit()` /
    `void xInit(void)` declared in its public header with no `extern "C"`
    wrapper (in C++ the two spellings are the same symbol). An init defined
    with C linkage (e.g. in a .c file) would need an `extern "C"` wrapper to
    match; that's the documented contract for the `init:` hook.

    Always written for a buildable (empty body if no straddle declares init:)
    so spangapInitStraddles() is always defined and the buildable's single call
    site never dangles — same contract as write_main_requires /
    write_sdkconfig_overrides.
    """
    if not proj.is_buildable:
        return
    # (order, topo_index, call) — topo_index is the position in the resolved
    # dep list, so ties within the same `order:` keep dependency order.
    entries: list[tuple[int, int, str]] = []
    seen_calls: set[str] = set()
    for idx, dep in enumerate(deps):
        for hook in dep.init:
            call = hook["call"]
            if call in seen_calls:
                continue
            seen_calls.add(call)
            entries.append((int(hook.get("order", 100)), idx, call))
    entries.sort(key=lambda e: (e[0], e[1]))

    # Forward decls carry default (C++) linkage to match the straddle init
    # convention (global `void xInit()` in a header, no extern "C"). The
    # dispatcher itself is extern "C" to match its spangap.h prototype — an
    # extern "C" function may freely call C++-linkage functions.
    externs = "".join(f"void {c}(void);\n" for _, _, c in entries)
    calls = "".join(f"    {c}();\n" for _, _, c in entries)
    body = (
        "/* AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
        " * spangapInitStraddles() calls every staged straddle's declared init:\n"
        " * hooks, ordered by (order, dependency-topo). The buildable calls this\n"
        " * once from app_main; adding a straddle that declares init: is then\n"
        " * enough to have it initialize — no consumer edit.\n"
        " *\n"
        " * Forward decls use default (C++) linkage — the init convention is a\n"
        " * global `void xInit()` with no extern \"C\". No header is included: an\n"
        " * --include'd straddle's include/ dir may not be on this component's\n"
        " * path, but its lib is on the link line, so the call resolves. */\n"
        f"{externs}"
        "\n"
        'extern "C" void spangapInitStraddles(void) {\n'
        f"{calls}"
        "}\n"
    )
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    (staging_dir / "spangap_init_dispatch.gen.cpp").write_text(body)


def signal_preamble(proj: Manifest, deps: list[Manifest], missing: list[str] = ()) -> None:
    n = len(deps)
    dep_summary = f"{n} dep" + ("s" if n != 1 else "")
    print(f"workspace: {WORKSPACE}", file=sys.stderr)
    print(f"project:   {proj.name} ({proj.version})", file=sys.stderr)
    if deps:
        print(f"requires:  {dep_summary} — {', '.join(d.name for d in deps)}", file=sys.stderr)
    if missing:
        print(f"missing:   {len(missing)} not yet cloned — {', '.join(missing)}", file=sys.stderr)
        print("           run `spangap get-deps` from this straddle to fetch them.", file=sys.stderr)


def stage_components(proj: Manifest, deps: list[Manifest], log_staged: bool = True) -> Path:
    """Stage each transitive dep into <fw>/staging/components/<repo>/, as a
    real dir of per-entry symlinks to the dep's firmware_dir contents plus
    generated build-system files. The per-entry layout (vs. one symlink to
    the whole dep) lets us drop generated files into the staged dir without
    polluting the source tree.

    Also writes the synthetic _spangap_present component and the buildable's
    main_requires.cmake. log_staged=False suppresses the per-dep `staged:`
    lines (quiet builds).
    """
    staging = proj.firmware_dir / "staging" / "components"
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(parents=True, exist_ok=True)

    staged_repos: set[str] = {d.repo for d in deps}

    for dep in deps:
        src = dep.firmware_dir
        if not src.is_dir() or not (src / "CMakeLists.txt").exists():
            die(f"{dep.name}: firmware dir {src} has no CMakeLists.txt — can't stage")
        dst = staging / dep.repo
        dst.mkdir()
        for entry in sorted(src.iterdir()):
            (dst / entry.name).symlink_to(entry)
        write_spangap_requires(dst, effective_requires(dep, staged_repos))
        if log_staged:
            print(f"  staged: {dep.repo} -> {src}", file=sys.stderr)

    write_presence_component(staging, deps)
    write_main_requires(proj, staged_repos)
    write_init_dispatch(proj, deps)
    return staging


def run_idf(args: list[str], cwd: Path, env: dict[str, str] | None = None) -> int:
    cmd = ["idf.py", *args]
    print(f"+ {' '.join(cmd)}  (in {cwd})", file=sys.stderr)
    return subprocess.run(cmd, cwd=cwd, env={**os.environ, **(env or {})}).returncode


# ---------------------------------------------------------------------------
# `spangap build` output filtering. Quiet by default — IDF/Vite build output
# is mostly per-file compiler noise — with -v|--verbose restoring the full
# stream. This used to live host-side in a separate spangap-build-filter that
# spangap-outside piped the container's stdout through; it now lives here so
# the in-container build behaves identically however it's reached (`spangap
# build` from the host, `spangap docker spangap build`, or a shell inside the
# container) and there's a single copy of the filter rules. spangap-outside
# just forwards argv (and the sticky port via $SPANGAP_PORT) now.
# ---------------------------------------------------------------------------

# idf.py's "all done" banner. Both modes rewrite it: idf.py's own multi-line
# flash hints don't apply in a spangap workspace (you flash via `spangap
# flash`), so we replace the banner with the spangap invocation and drop
# whatever idf.py prints after it.
_FLASH_MARKER = "Project build complete. To flash, run:"
_TAIL = 3  # follow-up lines kept after each diagnostic in quiet mode

# Ninja progress lines like `[44/2091] Building C object ...`. Never kept in
# quiet mode, even when the path contains the literal "error"/"warning".
_PROGRESS_RE = re.compile(r"^\[\d+/\d+\]\s")

# What counts as a real diagnostic worth keeping in quiet mode. Each
# alternative anchors the keyword in a context filenames can't fake (a
# trailing colon, a line-leading meta-tool prefix, a marker glyph) so
# `error.c.obj` / `chunkSizeWarningLimit` don't sneak through. `^spangap:`
# keeps our own die()/status messages — without it a fast in-container die in
# quiet mode would surface as a silent rc=1.
_KEEP_RE = re.compile(
    r"""
    (?: \b (?: warning | error | fatal\s+error ) \b \s* :
      | ^ CMake \s+ (?: Warning | Error ) \b
      | ^ FAILED:
      | \b note:
      | \(!\) \s
      | ^ spangap:
      | \b Rollup \s+ failed \b
      | \b App \s+ build \s+ (?: failed | successful ) \b
      | \b Build \s+ failed \s+ in \b
      | ^ ninja: \s* build \s+ stopped \b
      | ^ ninja \s+ failed \b
    )
    """,
    re.IGNORECASE | re.VERBOSE,
)


def run_build_idf(args: list[str], cwd: Path, quiet: bool, env: dict[str, str] | None = None) -> int:
    """Run `idf.py <args>` for a build, streaming output through the filter.

    quiet=True keeps only real diagnostics (+ a few lines of trailing context,
    with `[...]` between non-adjacent blocks); quiet=False is pass-through.
    Both modes rewrite idf.py's flash banner to `spangap flash <port>`, where
    <port> is $SPANGAP_PORT (the host's sticky serial port, forwarded by
    spangap-outside) or the literal `<serial port>` placeholder.
    """
    cmd = ["idf.py", *args]
    if not quiet:
        print(f"+ {' '.join(cmd)}  (in {cwd})", file=sys.stderr)
    port = os.environ.get("SPANGAP_PORT") or "<serial port>"
    proc = subprocess.Popen(
        cmd, cwd=cwd, env={**os.environ, **(env or {})},
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, bufsize=1,
    )
    assert proc.stdout is not None
    out = sys.stdout
    remaining = 0
    try:
        for raw in proc.stdout:
            line = raw.rstrip("\n")
            if _FLASH_MARKER in line:
                out.write("build: done. To flash, run:\n")
                out.write(f"  spangap flash {port}\n")
                out.flush()
                for _ in proc.stdout:  # drop idf.py's own flash instructions
                    pass
                break
            if not quiet:
                out.write(line + "\n"); out.flush(); continue
            if _PROGRESS_RE.match(line):
                continue
            if _KEEP_RE.search(line):
                out.write(line + "\n"); out.flush(); remaining = _TAIL
            elif remaining > 0:
                out.write(line + "\n"); out.flush(); remaining -= 1
                if remaining == 0:
                    out.write("[...]\n"); out.flush()
    except BrokenPipeError:
        pass
    return proc.wait()


_NO_SHORTHANDS = {  # --no-<x> maps to --exclude <bare>
    "lcd": "spangap/spangap-lcd",
    "web": "spangap/spangap-web",
}

# Flash sizes the ESP-IDF `CONFIG_ESPTOOLPY_FLASHSIZE_*MB` choice supports.
_VALID_FLASH_MB = (4, 8, 16, 32, 64, 128)


def _resolve_org_repo(raw: str, all_straddles: dict[str, Manifest], flag: str) -> str:
    """--exclude/--include accept bare repo names or org/repo. Disambiguate."""
    if "/" in raw:
        return raw
    matches = [n for n in all_straddles if all_straddles[n].repo == raw]
    if not matches:
        die(f"{flag} {raw}: no workspace straddle with that repo name")
    if len(matches) > 1:
        die(f"{flag} {raw}: ambiguous ({', '.join(matches)}); use org/repo form")
    return matches[0]


_FLASH_LINE_RE = re.compile(
    r"^(# )?CONFIG_ESPTOOLPY_FLASHSIZE_\d+MB( is not set|=y)$|"
    r"^CONFIG_ESPTOOLPY_FLASHSIZE=\".+\"$"
)


def write_sdkconfig_overrides(proj: Manifest, flash_mb: int | None) -> None:
    """Drop staging/sdkconfig.spangap-overrides — picked up by bootstrap.cmake
    as the highest-priority SDKCONFIG_DEFAULTS entry (first build / regen path).
    Always written (even if empty body) so bootstrap can rely on its presence.

    Also edits an existing sdkconfig in-place when --flash-size is given. IDF's
    SDKCONFIG_DEFAULTS only seeds on first build; once sdkconfig exists,
    defaults can't override it. So for the steady-state case we rewrite the
    FLASHSIZE lines directly. The next idf.py reconfigure picks the new value
    up, the partition generator reads the same value from sdkconfig, and the
    layout snaps to match.
    """
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    body: list[str] = []
    if flash_mb is not None:
        body.append(f"CONFIG_ESPTOOLPY_FLASHSIZE_{flash_mb}MB=y")
    text = (
        "# AUTO-GENERATED by spangap-inside. Reflects this build's CLI overrides.\n"
        "# Highest-priority SDKCONFIG_DEFAULTS entry — bootstrap.cmake picks it up\n"
        "# on first build / regen.\n"
        + ("\n".join(body) + "\n" if body else "")
    )
    (staging_dir / "sdkconfig.spangap-overrides").write_text(text)

    if flash_mb is None:
        return
    sdkconfig = proj.firmware_dir / "sdkconfig"
    if not sdkconfig.exists():
        return  # first build — SDKCONFIG_DEFAULTS path handles it
    target = f"CONFIG_ESPTOOLPY_FLASHSIZE_{flash_mb}MB=y"
    existing = sdkconfig.read_text()
    if target in existing.splitlines():
        return  # already correct
    # Strip all FLASHSIZE_* lines (set, not-set, and the synthesized
    # FLASHSIZE="<N>MB" string) and append the new value. IDF will canonicalize
    # the rest of the surrounding lines on its next reconfigure.
    kept = [ln for ln in existing.splitlines() if not _FLASH_LINE_RE.match(ln)]
    kept.append(target)
    sdkconfig.write_text("\n".join(kept) + "\n")


def cmd_build(args: argparse.Namespace) -> int:
    proj = find_project()
    if not proj.is_buildable:
        die(
            f"{proj.name} is not a buildable straddle (no `buildable:` block in straddle.yaml).\n"
            "       `spangap build` only builds buildable straddles. Build a consumer of this one."
        )
    if not proj.has_firmware:
        die(f"{proj.name}: firmware dir {proj.firmware_dir} has no CMakeLists.txt")

    all_straddles = scan_workspace_straddles()

    # --exclude (with --no-X shorthands) → drop from staged set.
    excluded: set[str] = set()
    for raw in (args.exclude or []):
        excluded.add(_resolve_org_repo(raw, all_straddles, "--exclude"))
    for short, full in _NO_SHORTHANDS.items():
        if getattr(args, f"no_{short}", False):
            excluded.add(full)

    # --include → pull additional straddles into the build. Slash-form is
    # trusted (the host dispatcher pre-clones missing ones); bare-form must
    # resolve to a workspace straddle.
    included: set[str] = set()
    for raw in (args.include or []):
        included.add(_resolve_org_repo(raw, all_straddles, "--include"))

    # --flash-size validation.
    if args.flash_size is not None and args.flash_size not in _VALID_FLASH_MB:
        die(f"--flash-size {args.flash_size}: choose one of {_VALID_FLASH_MB}")

    deps, _ = resolve_requires(
        proj, all_straddles, excluded=excluded, included=included,
    )
    quiet = not args.verbose
    if not quiet:
        signal_preamble(proj, deps)
        if excluded:
            print(f"excluded:  {', '.join(sorted(excluded))}", file=sys.stderr)
        if included:
            print(f"included:  {', '.join(sorted(included))}", file=sys.stderr)
        if args.flash_size is not None:
            print(f"flash:     {args.flash_size} MB (--flash-size override)", file=sys.stderr)
    stage_components(proj, deps, log_staged=not quiet)
    write_sdkconfig_overrides(proj, args.flash_size)
    lint_cmakelists(proj, deps, all_straddles)
    return run_build_idf(args.idf_args or ["build"], cwd=proj.firmware_dir, quiet=quiet)


def cmd_flash(args: argparse.Namespace) -> int:
    """In-container flash: touch <project>/build/flashme, wait for a monitor to consume it.

    The container can't see a serial port — only the host running
    `spangap monitor` can actually flash. We signal via flashme and watch
    for it to disappear (the monitor loop deletes it just before flashing).
    """
    proj = find_project()
    if not proj.is_buildable:
        die(f"{proj.name} is not a buildable straddle (no `buildable:` block) — nothing to flash.")
    flashme = proj.firmware_dir / "build" / "flashme"
    flashme.parent.mkdir(parents=True, exist_ok=True)
    flashme.touch()
    print(f"spangap: signaled {flashme} — waiting for a monitor to pick it up...", file=sys.stderr)
    for _ in range(5):
        time.sleep(1)
        if not flashme.exists():
            print("spangap: flashing.", file=sys.stderr)
            return 0
    print(
        "spangap: flashme still present after 5s — nobody seems to be running\n"
        "         `spangap monitor <dev>`. Start it on a host with the serial port.",
        file=sys.stderr,
    )
    return 1


def cmd_clean(args: argparse.Namespace) -> int:
    proj = find_project()
    return run_idf(["fullclean"], cwd=proj.firmware_dir)


def cmd_doctor(args: argparse.Namespace) -> int:
    print("spangap doctor (in-container)")
    print(f"  python:      {sys.version.split()[0]}")
    print(f"  workspace:   {WORKSPACE} ({'mounted' if WORKSPACE.is_dir() else 'MISSING'})")
    try:
        proj = find_project()
        print(f"  project:     {proj.name} ({proj.version}) at {proj.dir}")
    except SystemExit:
        print("  project:     <none — cwd not under a straddle>")
    print(f"  IDF_PATH:    {os.environ.get('IDF_PATH', '<unset>')}")
    print(f"  IDF_TOOLS:   {os.environ.get('IDF_TOOLS_PATH', '<unset>')}")
    print(f"  node:        {_capture(['node', '--version'])}")
    print(f"  npm:         {_capture(['npm', '--version'])}")
    print(f"  idf.py:      {_capture(['idf.py', '--version'])}")
    return 0


def _capture(cmd: list[str]) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, check=False)
        return (r.stdout or r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr) else "<no output>"
    except FileNotFoundError:
        return "<not installed>"


def cmd_validate(args: argparse.Namespace) -> int:
    proj = find_project()
    deps, _ = resolve_requires(proj, scan_workspace_straddles())
    print(f"{proj.name} v{proj.version} — OK")
    if deps:
        print("requires (topo):")
        for d in deps:
            print(f"  - {d.name} v{d.version}")
    return 0


def cmd_list_deps(args: argparse.Namespace) -> int:
    """Print transitive requires: not yet present as workspace siblings.

    One spec per line; nothing else on stdout — parsed by host-side
    `spangap get-deps` orchestrator in spangap-outside.
    """
    proj = find_project()
    _, missing = resolve_requires(proj, scan_workspace_straddles(), missing_ok=True)
    for spec in missing:
        print(spec)
    return 0


def cmd_list_requires(args: argparse.Namespace) -> int:
    """Print the project's full transitive requires set (resolved, present).

    One `<org>/<repo>` per line, in dependency order. Skips the project
    itself. Optional requires that aren't present are silently dropped
    (same semantics as `build` without --no-X). A read-only diagnostic for
    seeing exactly what a build of this straddle would pull in.
    """
    proj = find_project()
    deps, _ = resolve_requires(proj, scan_workspace_straddles())
    for d in deps:
        print(d.name)
    return 0


# Per-straddle build artifacts reallyclean strips. Firmware: idf build/,
# generated staging/, downloaded managed_components/. Browser: node_modules/,
# dist/, .quasar/, package-lock.json.
_FW_ARTIFACTS = ("build", "staging", "managed_components")
_BROWSER_ARTIFACTS = ("node_modules", "dist", ".quasar", "package-lock.json")


def cmd_reallyclean(args: argparse.Namespace) -> int:
    """Strip EVERY workspace straddle back to source-only state.

    A build touches more than the buildable: staged deps accumulate build/ and
    managed_components/ in their firmware dirs, and every browser dir that gets
    installed grows a node_modules/. So reallyclean sweeps all straddles, not
    just the current project — and needs no project context (runs from
    anywhere). Only ever removes generated/gitignored artifacts, never source.
    """
    straddles = scan_workspace_straddles()
    removed = 0

    def rm(t: Path) -> None:
        nonlocal removed
        if t.is_symlink() or t.is_file():
            t.unlink()
            removed += 1
            print(f"  rm {t}", file=sys.stderr)
        elif t.is_dir():
            shutil.rmtree(t)
            removed += 1
            print(f"  rm -r {t}", file=sys.stderr)

    for m in straddles.values():
        for sub in _FW_ARTIFACTS:
            rm(m.firmware_dir / sub)
        for sub in _BROWSER_ARTIFACTS:
            rm(m.browser_dir / sub)
    print(
        f"spangap: reallyclean done — removed {removed} path(s) across "
        f"{len(straddles)} straddle(s).",
        file=sys.stderr,
    )
    return 0


def cmd_claude(claude_args: list[str]) -> int:
    """Lazy-install @anthropic-ai/claude-code (if absent) and exec `claude`."""
    if not shutil.which("claude"):
        print("spangap: claude not installed in container — running `npm install -g @anthropic-ai/claude-code`...", file=sys.stderr)
        r = subprocess.run(["npm", "install", "-g", "@anthropic-ai/claude-code"], check=False)
        if r.returncode != 0:
            die("npm install -g @anthropic-ai/claude-code failed; see output above")
    claude_path = shutil.which("claude")
    if not claude_path:
        die("claude still not on PATH after npm install — check /home/ubuntu/.npm-global/bin")
    os.execvp(claude_path, [claude_path, *claude_args])
    return 1


# ---------------------------------------------------------------------------
# `spangap cli` — TCP CLI client. Same UX as the host-side `spangap cli`:
# -h persists hostname to /workspace/.spangap-host (= $SPANGAP_WORKSPACE/.spangap-host
# on the host through the bind mount), subsequent calls can omit it.
# ---------------------------------------------------------------------------
PROMPT = b"$ "


def cmd_cli(argv: list[str]) -> int:
    host: str | None = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-h":
            if i + 1 >= len(argv):
                die("spangap cli: -h needs a hostname")
            host = argv[i + 1]
            HOST_FILE.write_text(host + "\n")
            i += 2
        elif a == "--":
            i += 1
            break
        else:
            break
    if host is None:
        host = os.environ.get("SPANGAP_HOST") or (HOST_FILE.read_text().strip() if HOST_FILE.is_file() else "")
        if not host:
            die("spangap cli: no host — pass -h <host> first to persist it")
    port = int(os.environ.get("SPANGAP_CLI_PORT", "2323"))

    try:
        s = socket.create_connection((host, port), timeout=10)
    except OSError as e:
        die(f"cli: connect {host}:{port}: {e}")
    s.settimeout(None)

    def drain():
        buf = b""
        while not buf.endswith(PROMPT):
            d = s.recv(4096)
            if not d:
                break
            buf += d
        return buf

    rest = argv[i:]
    if rest:
        drain()
        s.sendall((" ".join(rest) + "\n").encode())
        out = drain()
        if out.endswith(PROMPT):
            out = out[: -len(PROMPT)]
        sys.stdout.buffer.write(out)
        sys.stdout.flush()
        return 0

    sel = selectors.DefaultSelector()
    sel.register(sys.stdin, selectors.EVENT_READ)
    sel.register(s, selectors.EVENT_READ)
    try:
        while True:
            for key, _ in sel.select():
                if key.fileobj is sys.stdin:
                    data = sys.stdin.buffer.read1(4096)
                    if not data:
                        return 0
                    s.sendall(data)
                else:
                    data = s.recv(4096)
                    if not data:
                        return 0
                    sys.stdout.buffer.write(data)
                    sys.stdout.flush()
    except KeyboardInterrupt:
        return 0


def main(argv: list[str] | None = None) -> int:
    raw = sys.argv[1:] if argv is None else argv
    # Pass-through subcommands whose own flag parsing would clash with argparse.
    if raw and raw[0] == "claude":
        return cmd_claude(raw[1:])
    if raw and raw[0] == "cli":
        return cmd_cli(raw[1:])

    p = argparse.ArgumentParser(prog="spangap", description="spangap straddles CLI (in-container)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor", help="report environment info").set_defaults(func=cmd_doctor)
    sub.add_parser("validate", help="parse + validate manifest and dep graph").set_defaults(func=cmd_validate)
    sub.add_parser("clean", help="run idf.py fullclean").set_defaults(func=cmd_clean)
    sub.add_parser("reallyclean", help="strip ALL workspace straddles back to source-only state (build/, managed_components/, node_modules/, …)").set_defaults(func=cmd_reallyclean)

    p_build = sub.add_parser("build", help="build the project (default: idf.py build)")
    p_build.add_argument(
        "-v", "--verbose", action="store_true",
        help="show the full IDF / Vite build output. Quiet by default — only "
             "real compiler/build-tool diagnostics (plus a little context) are "
             "kept.",
    )
    p_build.add_argument(
        "-e", "--exclude", action="append", default=[], metavar="STRADDLE",
        help="drop a straddle from this build's staged set (repeatable; <org>/<repo> "
             "or bare <repo>). Targets optional_requires: entries — excluding a hard "
             "requires: is an error.",
    )
    p_build.add_argument(
        "-i", "--include", action="append", default=[], metavar="STRADDLE",
        help="pull an extra straddle into this build (repeatable). Bare "
             "<repo> must already be a workspace sibling; <org>/<repo> "
             "form is auto-cloned from github if missing.",
    )
    p_build.add_argument(
        "--flash-size", type=int, default=None, metavar="MB",
        help=f"override CONFIG_ESPTOOLPY_FLASHSIZE_*MB for this build. One of "
             f"{', '.join(str(n) for n in _VALID_FLASH_MB)}. Useful for generic "
             f"builds against differently-sized hardware. Probe a chip's actual "
             f"flash size with `esptool.py -p <dev> flash_id`.",
    )
    for short, full in _NO_SHORTHANDS.items():
        p_build.add_argument(
            f"--no-{short}", dest=f"no_{short}", action="store_true",
            help=f"shorthand for --exclude {full}",
        )
    p_build.add_argument("idf_args", nargs="*", help="forwarded to idf.py")
    p_build.set_defaults(func=cmd_build)

    sub.add_parser(
        "flash",
        help="signal a host running `spangap monitor` to reflash (touches build/flashme)",
    ).set_defaults(func=cmd_flash)

    sub.add_parser(
        "list-deps",
        help="print transitive requires: not yet present as workspace siblings (used by host-side `spangap get-deps`)",
    ).set_defaults(func=cmd_list_deps)

    sub.add_parser(
        "list-requires",
        help="print the project's full transitive requires set, in dependency order (read-only diagnostic)",
    ).set_defaults(func=cmd_list_requires)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
