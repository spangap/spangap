CLAUDE_MD_POINTER = (
    "Read README.md in this directory as if it is CLAUDE.md, information in "
    "there only to be overridden by explicit user directives.\n"
)

# spangap-core is the implicit platform foundation. Its prefix is "" — its
# symbols (storageGet, cliRegister, info, …) read as language primitives, so
# every straddle links it the way C code links libc: you never declare it. The
# build always stages it (it can't be dropped with --without) and auto-injects it into
# every component's cross-straddle REQUIRES. No straddle.yaml lists it.
CORE_NAME = "spangap/spangap-core"

# spangap's own platform components, brought up first and in exactly this order
# by the generated dispatcher (each only if staged), ahead of every other
# straddle. The contract: anything the dispatcher starts after this band can
# count on the whole spangap ecosystem — storage/cron, networking, the web
# stack, the LCD launcher — already being up, so it never has to defer, retry,
# or order itself against them. core leads (it's the foundation), then net
# (services need the IP stack), then web (needs net), then lcd (its status bar
# reads net/storage/web state). Everything not in this list is a plain straddle
# ordered only by its declared requires: (see write_init_dispatch).
PLATFORM_ORDER = [
    CORE_NAME,
    "spangap/spangap-net",
    "spangap/spangap-web",
    "spangap/spangap-lcd",
]

# The prefix of PLATFORM_ORDER that a SAFE-MODE boot brings up (spangap-core
# service.h, service_band_t). A safe-mode boot exists to back up, restore, or
# wipe the state store with nothing else touching it, so it runs storage, the
# IP stack, the HTTP server and the screen — and stops there. The whole straddle
# band registers in SERVICE_BAND_FULL and simply never has its onInit called.
# The band is emitted per registration below; no straddle opts in or out.
#
# The screen is in the band because a boot that erases the store can take
# minutes, and on a device that has a panel the panel is where an operator looks
# to find out whether it is working — the wipe's own progress bar
# (spangap-lcd's safe_screen.cpp) is the only report a headless-of-network
# device gets. It touches no store: it reads an ephemeral percentage and draws.
# The shell it brings up is covered by that screen and never reachable.
SAFE_BAND = {
    CORE_NAME,
    "spangap/spangap-net",
    "spangap/spangap-web",
    "spangap/spangap-lcd",
}


def service_band(name: str) -> str:
    """The C enumerator naming `name`'s bring-up band."""
    return "SERVICE_BAND_SAFE" if name in SAFE_BAND else "SERVICE_BAND_FULL"


class Manifest:
    """Validated straddle.yaml plus its on-disk location."""

    def __init__(self, manifest_path: Path, data: dict[str, Any]) -> None:
        self.path = manifest_path
        self.dir = manifest_path.parent
        self.data = data

    @property
    def name(self) -> str: return self.data["name"]
    @property
    def org(self) -> str: return self.name.split("/", 1)[0]
    @property
    def repo(self) -> str: return self.name.split("/", 1)[1]
    @property
    def prefix(self) -> str: return self.data["prefix"]
    @property
    def version(self) -> str: return self.data["version"]
    @property
    def default_hostname(self) -> str:
        """The device's mDNS/DHCP hostname — `default_hostname:` if set, else the
        repo name. `<this>.local` is the out-of-the-box device address."""
        return str(self.data.get("default_hostname") or self.repo)
    @property
    def firmware_dir(self) -> Path:
        return (self.dir / self.data.get("firmware", "idf")).resolve()
    @property
    def browser_dir(self) -> Path:
        return (self.dir / self.data.get("browser", "browser")).resolve()
    @property
    def has_firmware(self) -> bool:
        return self.firmware_dir.exists() and (self.firmware_dir / "CMakeLists.txt").exists()
    @property
    def has_browser(self) -> bool:
        return self.browser_dir.exists() and (self.browser_dir / "package.json").exists()
    @property
    def requires(self) -> list[str]:
        return list(self.data.get("requires", []))
    @property
    def additional_installs(self) -> list[str]:
        """Spec names only — a gated entry contributes its install: name."""
        return [spec for spec, _ in self.additional_installs_gated]
    @property
    def additional_installs_gated(self) -> list[tuple[str, str | None]]:
        """(spec, when) pairs. A plain-string entry is ungated (when=None). The
        object form { install:, when: } stages install: only when the when:
        straddle is itself in the resolved closure — evaluated to a fixpoint in
        resolve_requires(), so gate order doesn't matter."""
        out: list[tuple[str, str | None]] = []
        for e in self.data.get("additional_installs", []):
            if isinstance(e, str):
                out.append((e, None))
            else:
                out.append((e["install"], e.get("when")))
        return out
    @property
    def start(self) -> list[dict[str, Any]]:
        return list(self.data.get("start", []))
    @property
    def init(self) -> list[dict[str, Any]]:
        return list(self.data.get("init", []))
    @property
    def browser_register(self) -> list[dict[str, Any]]:
        return list(self.data.get("browser_register", []))
    @property
    def services(self) -> list[dict[str, Any]]:
        """Boot-registered Service subclasses (see schema `services:` and
        spangap-core service.h). Each entry {class, header, when?} is lowered by
        the init codegen into a per-straddle trampoline TU (spangapService_<class>,
        which serviceRegister(new <class>())'s) plus a call in the generated
        spangapRegisterServices()."""
        return list(self.data.get("services", []))
    @property
    def kconfig(self) -> list[str]:
        return list(self.data.get("kconfig", []))
    @property
    def settings(self) -> list[dict[str, Any]]:
        """Declarative settings panels (see schema `settings:`). Each panel is
        lowered into the LCD pane, the web descriptor, and the storage defaults
        by the settings codegen (write_init_dispatch / write_browser_dispatch)."""
        return list(self.data.get("settings", []))
    @property
    def identity_kconfig(self) -> list[str]:
        """Desugar the immutable-identity root keys (stub/display_name/banner)
        plus default_hostname into CONFIG_SPANGAP_FW_* sdkconfig lines. These
        ride the same fragment-collection + dependency-order precedence as
        kconfig: (write_sdkconfig_fragments), so the built straddle — highest in
        the dependency tree — wins and spangap-core, deepest, loses."""
        mapping = (
            ("stub",             "CONFIG_SPANGAP_FW_STUB"),
            ("display_name",     "CONFIG_SPANGAP_FW_NAME"),
            ("banner",           "CONFIG_SPANGAP_FW_BANNER"),
            ("default_hostname", "CONFIG_SPANGAP_FW_HOSTNAME"),
        )
        out: list[str] = []
        for yaml_key, cfg in mapping:
            val = self.data.get(yaml_key)
            if val is None:
                continue
            esc = str(val).replace("\\", "\\\\").replace('"', '\\"')
            out.append(f'{cfg}="{esc}"')
        return out


def die(msg: str, exit_code: int = 1):
    sys.stderr.write(f"spangap: {msg}\n")
    sys.exit(exit_code)


def warn(msg: str) -> None:
    sys.stderr.write(f"spangap: warning: {msg}\n")


def find_project(start: Path | None = None) -> Manifest:
    """Resolve the project straddle for the current invocation.

    Walk up from cwd until straddle.yaml. Each straddle has one container-
    native location (<workspace>/<repo>) — no symlinks, no host paths — so the
    CMAKE_HOME_DIRECTORY baked into build/CMakeCache.txt is stable and
    host-independent.

    If nothing is found and we're at the workspace root, fall back to the
    target of the last build, recorded in .spangap-build — this mirrors
    spangap-outside's require_straddle/default_straddle so `spangap build` (and
    friends) work from the workspace root inside the container too, not only
    from inside the straddle dir.
    """
    origin = (start or Path.cwd()).resolve()
    cur = origin
    while True:
        cand = cur / "straddle.yaml"
        if cand.is_file():
            return load_manifest(cand)
        if cur == cur.parent:
            break
        cur = cur.parent
    if origin == WORKSPACE:
        proj = default_project()
        if proj is not None:
            return proj
        die(
            f"no straddle.yaml at or above {WORKSPACE} and no remembered "
            "build (.spangap-build) to fall back on.\n"
            "       Run from inside a straddle, or name one with "
            "`spangap build <org>/<repo>` (it's cloned + remembered)."
        )
    die(
        f"no straddle.yaml found at or above {Path.cwd()}.\n"
        "       Run from inside a straddle (a dir with straddle.yaml at its root)."
    )


SPANGAP_BUILD_FILE = WORKSPACE / ".spangap-build"


def remembered_build() -> tuple[str, list[str]] | None:
    """Parse .spangap-build into (target_token, selection_tokens), or None.

    .spangap-build holds the last *explicit* build invocation, target first:
        <org/repo> [--with <org/repo>]... [--without <org/repo>]... [--flash-size N]
    Written by cmd_build (canonical org/repo form) so a bare `spangap build`
    repeats the last one. None if the file is absent or empty.
    """
    if not SPANGAP_BUILD_FILE.is_file():
        return None
    line = SPANGAP_BUILD_FILE.read_text().strip()
    if not line:
        return None
    toks = shlex.split(line)
    return (toks[0], toks[1:]) if toks else None


def parse_selection(
    tokens: list[str],
) -> tuple[set[str], set[str], int | None, list[str]]:
    """Parse remembered selection tokens → (included, excluded, flash_mb, kconfig)."""
    inc: set[str] = set()
    exc: set[str] = set()
    flash: int | None = None
    kconfig: list[str] = []
    it = iter(tokens)
    for t in it:
        if t in ("--with", "-w"):
            inc.add(next(it, ""))
        elif t in ("--without", "-x"):
            exc.add(next(it, ""))
        elif t == "--flash-size":
            v = next(it, "")
            flash = int(v) if v.isdigit() else None
        elif t == "--kconfig":
            kconfig.append(next(it, ""))
        elif t.startswith("--with="):
            inc.add(t.split("=", 1)[1])
        elif t.startswith("--without="):
            exc.add(t.split("=", 1)[1])
        elif t.startswith("--flash-size="):
            v = t.split("=", 1)[1]
            flash = int(v) if v.isdigit() else None
        elif t.startswith("--kconfig="):
            kconfig.append(t.split("=", 1)[1])
    inc.discard("")
    exc.discard("")
    return inc, exc, flash, [k for k in kconfig if k]


def write_remembered_build(
    proj: Manifest, included: set[str], excluded: set[str], flash_mb: int | None,
    kconfig: list[str] | None = None,
) -> None:
    """Record the build target + selection in .spangap-build (canonical form)."""
    parts = [proj.name]
    for inc in sorted(included):
        parts += ["--with", inc]
    for exc in sorted(excluded):
        parts += ["--without", exc]
    if flash_mb is not None:
        parts += ["--flash-size", str(flash_mb)]
    for line in (kconfig or []):
        parts += ["--kconfig", line]     # order-preserving: later lines win
    SPANGAP_BUILD_FILE.write_text(shlex.join(parts) + "\n")


def straddle_at_or_above(start: Path) -> Path | None:
    """Dir of the nearest straddle.yaml at/above `start`, or None."""
    cur = start.resolve()
    while True:
        if (cur / "straddle.yaml").is_file():
            return cur
        if cur == cur.parent:
            return None
        cur = cur.parent


def default_project() -> Manifest | None:
    """The straddle named by .spangap-build's remembered target, or None."""
    rb = remembered_build()
    if rb is None:
        return None
    return resolve_target_straddle(rb[0], scan_workspace_straddles())


def resolve_target_straddle(
    name: str, all_straddles: dict[str, Manifest]
) -> Manifest | None:
    """Resolve an explicit `spangap build <target>` token to a straddle.

    This is what lets you name the image to build instead of cd-ing into its
    dir (or relying on .spangap-build). Matches:

      - the full <org>/<repo> name        (spangap/hw-lilygo-tdeck)
      - the straddle's directory basename  (hw-lilygo-tdeck)

    Returns the Manifest, or None if the token names no straddle at all (so the
    caller can leave it for idf.py — keeping `spangap build menuconfig`, idf
    build targets, etc. working as passthrough). Any straddle resolves here —
    there is no buildable gate; whether the build produces a useful image is up
    to the straddle. Dies only on a genuinely ambiguous match (the same token
    naming two straddles).
    """
    if name in all_straddles:  # exact <org>/<repo>
        return all_straddles[name]
    matches: dict[Path, Manifest] = {}
    for m in all_straddles.values():
        keys = {m.repo, m.dir.name}
        if name in keys:
            matches[m.path] = m
    if len(matches) > 1:
        names = ", ".join(sorted(m.name for m in matches.values()))
        die(f"`spangap build {name}`: ambiguous — '{name}' names more than one "
            f"straddle ({names}). Use the full <org>/<repo> form.")
    return next(iter(matches.values())) if matches else None


def load_manifest(path: Path) -> Manifest:
    try:
        raw = yaml.safe_load(path.read_text())
    except yaml.YAMLError as e:
        die(f"{path}: invalid YAML — {e}")
    if not isinstance(raw, dict):
        die(f"{path}: top-level must be a mapping")
    schema = json.loads(SCHEMA_PATH.read_text())
    errs = sorted(Draft202012Validator(schema).iter_errors(raw), key=lambda e: e.path)
    if errs:
        for e in errs:
            loc = "/".join(str(p) for p in e.path) or "<root>"
            sys.stderr.write(f"spangap: {path}: {loc}: {e.message}\n")
        die(f"{path}: schema validation failed ({len(errs)} error(s))")
    return Manifest(path, raw)


def scan_workspace_straddles() -> dict[str, Manifest]:
    """Every straddle.yaml visible to the container, indexed by name.

    Walks the flat workspace root: git clones laid out as direct children of the
    workspace. It's a plain directory of real straddle dirs; non-straddle entries
    (dotfiles, the per-host venv, the workspace marker) have no straddle.yaml and
    are skipped. A name seen twice is an error — it only fires on a mis-set
    `name:` in a straddle.yaml.
    """
    found: dict[str, Manifest] = {}
    if not WORKSPACE.is_dir():
        die(
            f"{WORKSPACE} not mounted — is the container running with "
            "-v <ws>:/home/spangap/<basename>?"
        )

    for child in sorted(WORKSPACE.iterdir()):
        if not child.is_dir():
            continue
        m_path = child / "straddle.yaml"
        if not m_path.is_file():
            continue
        m = load_manifest(m_path)
        if m.name in found:
            die(f"two straddles claim the same name '{m.name}':\n  {found[m.name].path}\n  {m.path}")
        found[m.name] = m
    return found


def resolve_requires(
    proj: Manifest,
    all_straddles: dict[str, Manifest],
    missing_ok: bool = False,
    excluded: set[str] | None = None,
    included: set[str] | None = None,
    dropped_out: set[str] | None = None,
) -> tuple[list[Manifest], list[str]]:
    """Walk requires: and additional_installs: transitively, plus the implicit
    spangap-core foundation and any user-named `included` straddles as extra
    roots, then apply --without with dependent-cascade.

    Two tiers in the manifest:
      requires:           hard — always pulled in, missing = error
      additional_installs:  soft, default-on — pruned silently if absent/excluded.
        The object form { install:, when: } additionally gates the edge on the
        when: straddle being in the closure (fixpoint pass below), so an extra
        can ride the *conjunction* of two straddles without dragging in the
        second one.

    spangap-core is always an implicit hard root (see CORE_NAME) and sorts to
    the head of the topo order. `included` (from --with <name>) seeds the
    walk with additional roots treated as soft. The caller ensures every
    `included` name is on disk (the host-side build dispatcher pre-clones
    slash-form --withs; bare-form is validated against the workspace).

    Exclude semantics (the cascade):
      Excluding X also drops every straddle that hard-`requires:` X — it can't
      build without X — and so on transitively (reverse-dependency closure).
      Optional dependents don't cascade: they just lose the integration.
      Forward-orphans (straddles left reachable only through a dropped one)
      are pruned too. The drop is rejected only when it would remove a
      *mandatory* straddle — spangap-core or anything in the buildable's hard
      requires: closure — which is a genuine conflict, not a droppable option.

    Missing behavior:
      Hard requires: missing → die (unless missing_ok, then collected).
      Soft optional missing from workspace: if missing_ok, COLLECTED for
        cloning; otherwise silently skipped.

    If `dropped_out` is provided, it's filled with every staged-by-default
    straddle the exclude pass removed (cascade + orphans + the named targets),
    so the caller can report what a --without actually took with it.
    """
    excluded = set(excluded or set())
    included = included or set()

    if CORE_NAME in excluded:
        die(
            f"{CORE_NAME} is the platform foundation (its empty-prefix symbols "
            "read as language primitives) — it's always staged and can't be "
            "dropped with --without."
        )

    out: list[Manifest] = []
    seen: set[str] = set()
    on_stack: set[str] = set()
    missing: dict[str, str] = {}
    # Gated soft edges ({install:, when:}) parked until their when: straddle
    # enters the closure: (spec, requested_by, gate-bare-name).
    pending_gated: list[tuple[str, str, str]] = []
    hard_deps: dict[str, set[str]] = {}  # name → bare names of its hard requires:

    def visit(spec: str, requested_by: str, hard: bool) -> None:
        bare = _bare(spec)
        if bare in seen or bare in missing:
            return
        if bare in on_stack:
            # A back-edge while this node is still on the DFS stack. If it came
            # in over an additional_installs edge it's benign — an aggregator
            # pulling in something that requires: it back (e.g. spangap-net
            # additional-installs acme, which hard-requires net) is the normal
            # case, not a cycle. The node is already being staged; just stop
            # recursing. Genuine requires:-only cycles (a real init-ordering
            # impossibility) are caught by the hard-cycle pass after the walk.
            return
        if bare not in all_straddles:
            if missing_ok:
                missing[bare] = spec
                return
            if hard:
                die(
                    f"missing workspace sibling: {bare} (required by {requested_by}).\n"
                    "       Run `spangap get-deps` from this straddle to clone it."
                )
            return  # build path: soft + absent → silently skip
        on_stack.add(bare)
        hd: set[str] = set()
        for dep in all_straddles[bare].requires:
            hd.add(_bare(dep))
            visit(dep, bare, hard=True)
        for dep, when in all_straddles[bare].additional_installs_gated:
            if when is None:
                visit(dep, bare, hard=False)
            else:
                pending_gated.append((dep, bare, _bare(when)))
        on_stack.discard(bare)
        seen.add(bare)
        hard_deps[bare] = hd
        out.append(all_straddles[bare])

    # Implicit core first, so the foundation heads the topo order; then the
    # buildable's own roots. The full closure is built ignoring excludes —
    # the exclude pass below prunes it, so cascade/orphan logic sees the whole
    # graph.
    if proj.name != CORE_NAME:
        visit(CORE_NAME, f"{proj.name} (implicit core)", hard=True)
    for r in proj.requires:
        visit(r, proj.name, hard=True)
    for r, when in proj.additional_installs_gated:
        if when is None:
            visit(r, proj.name, hard=False)
        else:
            pending_gated.append((r, proj.name, _bare(when)))
    for r in included:
        visit(r, f"{proj.name} (--with)", hard=False)

    # Fire gated soft edges to a fixpoint: an edge stages its install: only
    # once its when: straddle is in the closure (staged — or, in the get-deps
    # missing_ok walk, collected for cloning). Firing an edge can stage
    # straddles whose own gated edges then become eligible, so iterate.
    # Edges whose gate never enters the closure are dropped silently, like
    # any other absent soft dep.
    while pending_gated:
        ready = [e for e in pending_gated if e[2] in seen or e[2] in missing]
        if not ready:
            break
        pending_gated = [e for e in pending_gated if e not in ready]
        for dep, requested_by, _gate in ready:
            visit(dep, requested_by, hard=False)

    # Hard-cycle pass: additional_installs cycles are allowed (above), but a
    # cycle made purely of requires: edges is a genuine init-ordering
    # impossibility — A can't come up before B if B must come up before A.
    # Detect it over the staged closure, following requires: edges only.
    hc_color: dict[str, int] = {}  # 0/absent = unvisited, 1 = on-stack, 2 = done

    def check_hard_cycle(bare: str) -> None:
        hc_color[bare] = 1
        for dep in all_straddles[bare].requires:
            db = _bare(dep)
            if db not in seen:  # absent or pruned hard dep — not a staged edge
                continue
            if hc_color.get(db, 0) == 1:
                die(f"requires: cycle through {db} (from {bare})")
            if hc_color.get(db, 0) == 0:
                check_hard_cycle(db)
        hc_color[bare] = 2

    for n in list(seen):
        if hc_color.get(n, 0) == 0:
            check_hard_cycle(n)

    # Mandatory = spangap-core + the buildable's hard requires:, transitively.
    # Never droppable; excluding one (or anything it hard-requires) is a conflict.
    mandatory: set[str] = set()

    def mark_mandatory(bare: str) -> None:
        if bare in mandatory or bare not in hard_deps:
            return
        mandatory.add(bare)
        for d in hard_deps[bare]:
            mark_mandatory(d)

    if proj.name != CORE_NAME:
        mark_mandatory(CORE_NAME)
    for r in proj.requires:
        mark_mandatory(_bare(r))

    # Reverse-dependency cascade: a straddle that hard-requires an excluded one
    # can't build, so it drops too. Iterate to a fixpoint over the staged graph.
    excl = {e for e in excluded if e in seen}  # excluding an absent straddle is a no-op
    changed = True
    while changed:
        changed = False
        for name in seen:
            if name not in excl and hard_deps.get(name, set()) & excl:
                excl.add(name)
                changed = True

    conflict = excl & mandatory
    if conflict:
        lines = []
        for m in sorted(conflict):
            if m in excluded:
                why = "named in --without directly"
            else:
                culprit = ", ".join(sorted(hard_deps.get(m, set()) & excl))
                why = f"hard-requires excluded {culprit}"
            lines.append(f"  - {m}: {why}")
        die(
            "--without conflict: these straddles are hard-required by "
            f"{proj.name} and can't be dropped:\n" + "\n".join(lines) +
            "\n       Reclassify them as additional_installs: to make them droppable."
        )

    # Forward-prune: keep only what's still reachable from the surviving roots
    # over hard+optional edges, skipping the excluded set. Drops the named
    # targets, their cascaded dependents, and any now-orphaned forward deps.
    # A gated soft edge only carries reachability while its when: straddle
    # survives the exclude pass — dropping the gate re-orphans the install:
    # (unless something else still reaches it).
    def _live_soft(m: Manifest) -> list[str]:
        return [d for d, w in m.additional_installs_gated
                if w is None or (_bare(w) in seen and _bare(w) not in excl)]

    roots = ([CORE_NAME] if proj.name != CORE_NAME else [])
    roots += [_bare(r) for r in proj.requires]
    roots += [_bare(r) for r in _live_soft(proj)]
    roots += [_bare(r) for r in included]
    reachable: set[str] = set()
    stack = [r for r in roots if r in seen and r not in excl]
    while stack:
        n = stack.pop()
        if n in reachable:
            continue
        reachable.add(n)
        for dep in all_straddles[n].requires + _live_soft(all_straddles[n]):
            db = _bare(dep)
            if db in seen and db not in excl and db not in reachable:
                stack.append(db)

    if dropped_out is not None:
        dropped_out.clear()
        dropped_out.update(m.name for m in out if m.name not in reachable)

    final = [m for m in out if m.name in reachable]
    return final, list(missing.values())


def _bare(spec: str) -> str:
    """Strip @<ref> suffix from a requires entry."""
    return spec.split("@", 1)[0]


def _repo(bare_name: str) -> str:
    """Strip org/ prefix — what CMake REQUIRES uses."""
    return bare_name.split("/", 1)[1] if "/" in bare_name else bare_name


# Central straddles get a stable CONFIG_SPANGAP_<NAME> alias (alongside the
# generic CONFIG_STRADDLE_<REPO>) — the spelling source code gates on. Shared by
# write_presence_component (which emits them) and the integration-cue scan below
# (which reads them back out of source to learn what a component integrates with).
_SHORTCUT_ALIASES = {
    "spangap-lcd": "SPANGAP_LCD",
    "spangap-net": "SPANGAP_NET",
    "spangap-web": "SPANGAP_WEB",
    "ota":         "SPANGAP_OTA",
    "wg":          "SPANGAP_WG",
    "upnp":        "SPANGAP_UPNP",
    "duckdns":     "SPANGAP_DUCKDNS",
    "acme":        "SPANGAP_ACME",
}

_SOURCE_EXTS = {".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hh"}
_SCAN_SKIP_DIRS = {"build", "managed_components", "components", "staging", ".git"}


def _iter_component_sources(root: Path):
    """Yield a component's own source/header files — skipping vendored
    sub-components (components/), build output and staging."""
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in _SCAN_SKIP_DIRS]
        for fn in filenames:
            if Path(fn).suffix in _SOURCE_EXTS:
                yield Path(dirpath) / fn


def _integration_cues(firmware_dir: Path, staged_repos: set[str]) -> set[str]:
    """Staged straddles this component integrates with, inferred from the CODE
    (not the manifest), so the gate that already exists in source is the single
    source of truth — nothing to keep in sync:

      - a conditional/<repo>/ slice dir: compiled ONLY when <repo> is staged
        (SPANGAP_CONDITIONAL_SRCS), so when present it needs <repo>'s headers; and
      - a source reference to a staged peer's presence symbol — the same `#if`
        that already gates an optional cross-straddle call. Two spellings count:
        the generic CONFIG_STRADDLE_<NAME> (emitted for every staged straddle,
        e.g. lxmf's audio-notification path under CONFIG_STRADDLE_AUDIO) and the
        CONFIG_SPANGAP_<alias> shortcut for the central straddles (acme's HTTP-01
        path under CONFIG_SPANGAP_WEB, duckdns under CONFIG_SPANGAP_UPNP).

    Either cue adds <repo> to REQUIRES only when it is staged, and never installs
    it — a peer-less build just drops the dep and the #if / excluded slice
    compiles away. Returns the cued subset of staged_repos.
    """
    cues: set[str] = set()
    cond = firmware_dir / "conditional"
    if cond.is_dir():
        for sub in cond.iterdir():
            if sub.is_dir() and sub.name in staged_repos:
                cues.add(sub.name)
    # Presence-symbol → the staged repo it gates, for peers not already cued by a
    # slice. Both the generic CONFIG_STRADDLE_<NAME> and the CONFIG_SPANGAP_<alias>
    # shortcut map to the same repo; either spelling in source pulls it into
    # REQUIRES. Scan source once, dropping tokens as they're found.
    want: dict[str, str] = {}
    for r in staged_repos:
        if r in cues:
            continue
        want[f"CONFIG_STRADDLE_{_name_to_kconfig(r)}"] = r
        alias = _SHORTCUT_ALIASES.get(r)
        if alias:
            want[f"CONFIG_{alias}"] = r
    if want:
        for path in _iter_component_sources(firmware_dir):
            if not want:
                break
            try:
                text = path.read_text(errors="ignore")
            except OSError:
                continue
            for tok in [t for t in want if t in text]:
                cues.add(want.pop(tok))
    return cues


def effective_requires(m: Manifest, staged_repos: set[str]) -> list[str]:
    """Cross-straddle REQUIRES list for one component, in repo-only form.

    = implicit spangap-core + hard requires + (additional_installs ∩ staged)
      + integration cues (see _integration_cues), order-preserved, deduped.
    Everything past the hard requires is gated on staged_repos, so a dropped or
    absent dep simply falls out of REQUIRES and its #if / excluded slice compiles
    away. Integration deps are NOT declared in the manifest — they're read back
    from the code's own CONFIG_SPANGAP_<X> gates and conditional/<X>/ slices.

    Straddles added via --with don't appear here directly — they enter the staged
    set, and any straddle that cues on them (or the buildable's main, which
    REQUIRES the full staged set) picks them up. spangap-core leads the list for
    every component but core itself: its empty-prefix API (spangap.h) is linked
    everywhere, so it's always in REQUIRES even though nothing declares it.
    """
    out: list[str] = []
    seen: set[str] = set()
    if m.name != CORE_NAME:
        core_repo = _repo(CORE_NAME)
        seen.add(core_repo); out.append(core_repo)
    for spec in m.requires:
        r = _repo(_bare(spec))
        if r not in seen:
            seen.add(r); out.append(r)
    for spec in m.additional_installs:
        r = _repo(_bare(spec))
        if r in staged_repos and r not in seen:
            seen.add(r); out.append(r)
    for r in sorted(_integration_cues(m.firmware_dir, staged_repos)):
        if r not in seen:
            seen.add(r); out.append(r)
    return out


def _conditional_sources(base_dir: Path, staged_repos: set[str]) -> tuple[list[str], list[str]]:
    """Activator-driven source-list exclusion. A component may carry code under
    <base_dir>/conditional/<name>/{src,include} that should be compiled ONLY when
    straddle <name> is in the build. Returns (srcs, include_dirs) — paths
    relative to the component dir — for every <name> in the staged set;
    everything else is left uncompiled (its symlinked dir is simply not added to
    SRCS). Nobody is special: the on-device-UI case is just
    conditional/spangap-lcd/, but the same primitive gates code on any straddle.
    base_dir is the component dir: a staged dep's firmware_dir, or the
    buildable's main/ dir.
    """
    srcs: list[str] = []
    incs: list[str] = []
    cond = base_dir / "conditional"
    if not cond.is_dir():
        return srcs, incs
    for sub in sorted(p for p in cond.iterdir() if p.is_dir()):
        if sub.name not in staged_repos:
            continue  # gating straddle absent — leave this dir out of the build
        srcdir = sub / "src"
        if srcdir.is_dir():
            for f in sorted(srcdir.iterdir()):
                if f.suffix.lower() in (".c", ".cpp", ".cc", ".cxx", ".s"):
                    srcs.append(f"conditional/{sub.name}/src/{f.name}")
        if (sub / "include").is_dir():
            incs.append(f"conditional/{sub.name}/include")
    return srcs, incs


# ---------------------------------------------------------------------------
# `services:` codegen — Service subclasses registered at boot (schema
# `services:`, runtime service.h). The dispatcher (write_init_dispatch) can't
# `new <Class>()` itself: that needs the class definition, and straddle headers
# must stay off the dispatcher's include path. So per straddle we mint a
# trampoline TU that lives IN the straddle's own component (where its header
# resolves) and exposes a deterministic C++-linkage symbol the dispatcher
# forward-declares and calls. Both sides derive from the same `services:` list,
# so they can't drift.
# ---------------------------------------------------------------------------

_SERVICE_TU_NAME = "spangap_services.gen.cpp"


def _active_services(m: Manifest, staged_full: set[str]) -> list[dict]:
    """m's `services:` entries whose `when` gate passes — None, or a straddle
    that is in the staged set (by <org>/<repo> name). Same gating as init:."""
    out: list[dict] = []
    for svc in m.services:
        when = svc.get("when")
        if when is not None and when not in staged_full:
            continue
        out.append(svc)
    return out


def _service_trampoline_tu(entries: list[dict]) -> str:
    """The trampoline TU text for one component's active `services:` entries, or
    "" when there are none. Each entry #includes its class header (once) and
    defines spangapService_<Class>(band) { serviceRegister(new <Class>(), band); }
    — the `new` lives here because the class header is on THIS component's
    include path, not the dispatcher's. The band is passed in rather than
    derived here: only the dispatcher knows the staged set's init order."""
    if not entries:
        return ""
    includes: list[str] = []
    seen_hdr: set[str] = set()
    fns: list[str] = []
    for svc in entries:
        cls, hdr = svc["class"], svc["header"]
        if hdr not in seen_hdr:
            seen_hdr.add(hdr)
            includes.append(f'#include "{hdr}"')
        fns.append(
            f"void spangapService_{cls}(service_band_t band) "
            f"{{ serviceRegister(new {cls}(), band); }}")
    return (
        "/* AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
        " * `services:` trampolines for this component. Each constructs its Service\n"
        " * subclass and appends it to the boot registry (serviceRegister) in the\n"
        " * band the generated app_main passes in. The class header is on THIS\n"
        " * component's include path (not the dispatcher's), which is why\n"
        " * `new <Class>()` lives here and the generated app_main only\n"
        " * forward-declares + calls spangapService_<Class> in boot order. */\n"
        + "\n".join(includes) + "\n"
        + '#include "service.h"\n\n'
        + "\n".join(fns) + "\n"
    )


def _require_conditional_srcs_wiring(cmakelists: Path, straddle: str) -> None:
    """A straddle declaring `services:` must compile the trampoline, which rides
    SPANGAP_CONDITIONAL_SRCS. Fail loud (clear message, not a cryptic link error
    on spangapService_<Class>) if its CMakeLists doesn't reference that list."""
    try:
        text = cmakelists.read_text()
    except OSError as e:
        die(f"{straddle}: can't read {cmakelists} to wire services: ({e})")
    if "SPANGAP_CONDITIONAL_SRCS" not in text:
        die(f"{straddle}: declares services: but its {cmakelists.name} does not "
            f"compile ${{SPANGAP_CONDITIONAL_SRCS}}.\n"
            f"       Add ${{SPANGAP_CONDITIONAL_SRCS}} to its idf_component_register "
            f"SRCS (and ${{SPANGAP_CONDITIONAL_INCLUDE_DIRS}} to INCLUDE_DIRS) — the "
            f"generated services trampoline rides that list.")


# Top-level docstring (Markdown is fine; reads as `head -1` of the generated file).
_GEN_HEADER_CMAKE = (
    "# AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
    "# Effective cross-straddle REQUIRES for this component, derived from the\n"
    "# straddle's requires: / additional_installs: intersected with the staged set.\n"
)
_GEN_HEADER_KCONFIG = (
    "# AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
    "# Presence symbols for every staged straddle. The hidden STRADDLE_<NAME>\n"
    "# generic is always emitted; the SPANGAP_<NAME> shortcuts (LCD / WEB / NET /\n"
    "# OTA / WG / UPNP / DUCKDNS / ACME) are also emitted when those central\n"
    "# straddles are staged (source code gates on the shortcuts).\n"
)


def _name_to_kconfig(repo: str) -> str:
    """spangap-lcd → SPANGAP_LCD, hw-lilygo-tdeck → HW_LILYGO_TDECK."""
    return repo.upper().replace("-", "_").replace(".", "_")


def write_spangap_requires(out_dir: Path, requires_list: list[str],
                           cond_srcs: list[str] | None = None,
                           cond_incs: list[str] | None = None) -> None:
    body = " ".join(requires_list)
    text = (
        _GEN_HEADER_CMAKE
        + f"set(SPANGAP_REQUIRES {body})\n"
        # Activator-driven conditional sources/includes: esp-idf/conditional/<name>/
        # entries whose <name> is staged. A straddle's CMakeLists appends these to
        # its idf_component_register SRCS / INCLUDE_DIRS.
        + f"set(SPANGAP_CONDITIONAL_SRCS {' '.join(cond_srcs or [])})\n"
        + f"set(SPANGAP_CONDITIONAL_INCLUDE_DIRS {' '.join(cond_incs or [])})\n"
    )
    (out_dir / "spangap_requires.cmake").write_text(text)


def write_presence_component(staging: Path, staged: list[Manifest]) -> None:
    """Emit staging/components/_spangap_present/ — empty IDF component that
    contributes a Kconfig.projbuild defining presence symbols for the staged set.

    Short-form aliases (CONFIG_SPANGAP_<NAME>) are emitted for the well-known
    central straddles below. Source code gates on these; they're a stable
    spelling that survives as the straddle set evolves.
    """
    comp = staging / "_spangap_present"
    comp.mkdir(parents=True, exist_ok=True)
    (comp / "CMakeLists.txt").write_text(
        _GEN_HEADER_CMAKE
        + "# Empty register — this component exists only for its Kconfig.projbuild.\n"
        + "idf_component_register()\n"
    )
    lines: list[str] = [_GEN_HEADER_KCONFIG]
    # repo → short-form Kconfig alias (module constant — also read back by the
    # integration-cue scan in effective_requires()).
    shortcut_aliases = _SHORTCUT_ALIASES
    for m in staged:
        sym = _name_to_kconfig(m.repo)
        lines.append(f"config STRADDLE_{sym}\n    bool\n    default y\n")
        alias = shortcut_aliases.get(m.repo)
        if alias:
            lines.append(f"config {alias}\n    bool\n    default y\n")
    (comp / "Kconfig.projbuild").write_text("\n".join(lines))


_CMAKE_COMMENT_RE = None  # lazily compiled below


def _strip_cmake_comments(text: str) -> str:
    """Drop CMake # comments; bracket-comments are rare and we don't bother."""
    out: list[str] = []
    for line in text.splitlines():
        idx = line.find("#")
        out.append(line[:idx] if idx >= 0 else line)
    return "\n".join(out)


def _extract_requires_tokens(text: str) -> list[str]:
    """Find every idf_component_register(...) REQUIRES list and return the tokens.

    Robust enough for our codebase — CMake parsing is otherwise a rabbit hole.
    Anything that looks like a CMake variable expansion (${...}) is dropped;
    we want to lint hand-written names only.
    """
    stripped = _strip_cmake_comments(text)
    tokens: list[str] = []
    i = 0
    needle = "idf_component_register"
    while True:
        i = stripped.find(needle, i)
        if i < 0:
            break
        # Find the opening paren after the call name.
        op = stripped.find("(", i + len(needle))
        if op < 0:
            break
        # Find the matching closing paren (no nesting in idf_component_register).
        cl = stripped.find(")", op + 1)
        if cl < 0:
            break
        body = stripped[op + 1 : cl]
        i = cl + 1
        # Scan body for REQUIRES <tokens> until the next ALL_CAPS keyword.
        words = body.split()
        in_req = False
        for w in words:
            if w == "REQUIRES":
                in_req = True
                continue
            if w.isupper() and w.replace("_", "").isalpha():
                # New keyword (PRIV_REQUIRES, SRCS, INCLUDE_DIRS, ...). Ends REQUIRES section.
                in_req = (w == "REQUIRES")
                continue
            if in_req and not w.startswith("${"):
                tokens.append(w)
    return tokens


def lint_cmakelists(proj: Manifest, deps: list[Manifest], all_straddles: dict[str, Manifest]) -> None:
    """Fail loud if any staged CMakeLists hand-writes a known straddle name in REQUIRES.

    Forces consumers to flow cross-straddle deps through ${SPANGAP_REQUIRES}, so the
    --no-X / additional_installs machinery actually narrows the dep graph.
    """
    known_repos = {m.repo for m in all_straddles.values()}
    staging = proj.firmware_dir / "staging" / "components"
    targets: list[Path] = []
    for dep in deps:
        cml = staging / dep.repo / "CMakeLists.txt"
        if cml.is_symlink() or cml.is_file():
            targets.append(cml)
    main_cml = proj.firmware_dir / "main" / "CMakeLists.txt"
    if main_cml.is_file():
        targets.append(main_cml)

    offenses: list[tuple[Path, str]] = []
    for cml in targets:
        try:
            text = cml.read_text()
        except OSError:
            continue
        for tok in _extract_requires_tokens(text):
            if tok in known_repos:
                offenses.append((cml, tok))

    if offenses:
        for cml, tok in offenses:
            sys.stderr.write(
                f"spangap: {cml}: hand-written straddle '{tok}' in REQUIRES.\n"
                f"         Cross-straddle deps must flow through ${{SPANGAP_REQUIRES}} so the\n"
                f"         additional_installs / --no-X machinery can narrow them. List '{tok}'\n"
                f"         in the straddle.yaml's requires: or additional_installs: instead.\n"
            )
        die(f"REQUIRES lint failed ({len(offenses)} hand-written straddle name(s))")


def write_main_requires(proj: Manifest, staged_repos: set[str],
                        extra_cond_srcs: list[str] | None = None) -> None:
    """For a buildable straddle, write staging/main_requires.cmake — the
    cross-straddle REQUIRES list for the buildable's main component.

    main is special: it hosts the generated start/init dispatcher, which can
    call a hook from ANY staged straddle — including a board pulled in with
    --with that this buildable never names in requires:/additional_installs:
    (the `reticulous/reticulous --with spangap/hw-lilygo-tdeck` shape). So main
    REQUIRES the FULL staged set, not just this straddle's declared deps:
    staging a straddle has to be enough to link and activate it. (Per-component
    REQUIRES stay narrow — effective_requires() — so only main is the catch-all.)
    core leads; the rest are sorted for deterministic output.

    Generated for any straddle whose firmware half has a main/ — that main is
    what consumes main_requires.cmake. A library straddle without a main/ (you
    can still `spangap build` it; whether that yields a useful image is its own
    matter) is skipped here, nothing to wire.
    """
    if not (proj.firmware_dir / "main").is_dir():
        return
    core_repo = _repo(CORE_NAME)
    requires_list = [core_repo] + sorted(r for r in staged_repos if r != core_repo)
    # The buildable's main component compiles from <firmware>/main/, so its
    # conditional/ code lives at <firmware>/main/conditional/<name>/.
    cond_srcs, cond_incs = _conditional_sources(proj.firmware_dir / "main", staged_repos)
    # The buildable's own services: trampoline (if any), path relative to main/.
    cond_srcs = cond_srcs + list(extra_cond_srcs or [])
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    body = " ".join(requires_list)
    text = (
        _GEN_HEADER_CMAKE
        + f"set(SPANGAP_REQUIRES {body})\n"
        + f"set(SPANGAP_CONDITIONAL_SRCS {' '.join(cond_srcs)})\n"
        + f"set(SPANGAP_CONDITIONAL_INCLUDE_DIRS {' '.join(cond_incs)})\n"
    )
    (staging_dir / "main_requires.cmake").write_text(text)


def init_order(deps: list[Manifest]) -> list[Manifest]:
    """The canonical straddle initialization order for an already-resolved
    dependency list.

    Two bands, no per-straddle ordering knob:
      1. Platform band — spangap's own components (PLATFORM_ORDER: core, net,
         web, lcd), in exactly that order, each only if staged.
      2. Straddle band — every other staged straddle, in the dependency-topo
         order `deps` already arrives in (a straddle appears after the ones it
         requires:).

    This is the single source of truth for "what order do straddles come up
    in": the generated service registration (write_init_dispatch) appends every
    straddle's Service in this order, and `spangap show` reports this order, so
    boot order and the reported order can never drift apart.
    """
    by_name = {d.name: d for d in deps}
    ordered: list[Manifest] = []
    for pname in PLATFORM_ORDER:
        dep = by_name.get(pname)
        if dep is not None:
            ordered.append(dep)
    for dep in deps:
        if dep.name not in PLATFORM_ORDER:
            ordered.append(dep)
    return ordered


# ---------------------------------------------------------------------------
# Declarative settings codegen (straddle.yaml `settings:`).
#
# The `settings:` blocks across the staged set describe ONE tree. Every node in
# it holds rows and children (rows first, children as navigation entries), and
# no node is owned: a contribution names a path with `at:`, intermediate nodes
# are conjured, and blocks contributed at the same path concatenate. That tree
# is lowered into THREE surfaces from the same source: the on-device LCD node
# (lcdSettingsContribute + lcdSetting* calls, only when spangap-lcd is staged),
# the persisted storage defaults (storageDefault() for every binding row with a
# `default:` on an `s.` key), and the browser node fragments (JSON inlined into
# straddles.gen.ts, interpreted by the NodePane renderer). The firmware halves
# ride in the generated init dispatch (write_init_dispatch); the web half rides
# in the browser dispatch (write_browser_dispatch).
#
# ORDERING AND NAMING ARE RESOLVED HERE, not at runtime. The generator knows
# init order, so it sorts contributions by the one global rule — `order:` first
# ascending, everything else after it in (straddle init order, declaration
# order) — and emits them pre-sorted, and it resolves each node's label/short/
# order last-setter-wins. The runtimes then only need stable insertion plus that
# same comparator for the hand-written contributions that arrive after the
# generated ones.
# ---------------------------------------------------------------------------

# Row kinds that bind a config key (carry a `default:` worth seeding).
_SETTINGS_BINDING_KINDS = {"switch", "slider", "integer", "ipv4", "text", "dropdown"}

# Row-level modifiers: not part of a row's kind, so they are stripped before
# the kind is read. `when_kconfig` and `when_surface` resolve at build time,
# `when_key` passes straight through to both runtimes, `order` is consumed by
# the sort below.
_SETTINGS_ROW_MODIFIERS = {"when_kconfig", "when_key", "when_surface", "order"}

# The surfaces a row may be restricted to (schema `when_surface:`). Absent, a
# row goes to both.
_SETTINGS_SURFACES = ("web", "lcd")


def _cstr(s: str) -> str:
    """A C/JS string literal for `s` (quotes + backslash escaping)."""
    esc = str(s).replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
    return f'"{esc}"'


# The row-level Kconfig gate (schema `when_kconfig:`).
_SETTINGS_GATE_KEY = "when_kconfig"


def _row_kind(row: dict) -> tuple[str, Any]:
    """(kind, spec) of a settings row, ignoring the modifier keys."""
    for k, v in row.items():
        if k not in _SETTINGS_ROW_MODIFIERS:
            return k, v
    die(f"settings row has no kind: {row!r}")


def _row_enabled(row: dict, cfgvals: dict[str, str]) -> bool:
    """Whether a row survives its `when_kconfig:` gate — `CONFIG_X` to emit it
    only when that symbol is set, `!CONFIG_X` only when it isn't.

    Resolved against collect_kconfig_values, exactly like a settings scalar's
    `{ kconfig: … }` form: the staged set's presence symbols
    (`CONFIG_STRADDLE_<REPO>`, so a row can require a sibling straddle) and the
    symbols straddles set in their `kconfig:` blocks. Anything else is *absent*,
    which reads as unset — so a build that turns a symbol on through `spangap
    menuconfig` or a buildable's sdkconfig.defaults gates its CODE (the compiler
    sees the sdkconfig) without gating these rows. A gated feature that must
    ship as a build variant therefore declares its symbol in a `kconfig:` block,
    where both halves can see it."""
    gate = row.get(_SETTINGS_GATE_KEY)
    if gate is None:
        return True
    want = True
    name = str(gate).strip()
    if name.startswith("!"):
        want, name = False, name[1:].strip()
    raw = cfgvals.get(name)
    is_set = raw is not None and raw not in ("n", "0", "", '""')
    return is_set == want


def _surface_rows(rows: list[dict], surface: str) -> list[dict]:
    """A node's rows as one SURFACE sees them — `when_surface: web` keeps the row
    out of the display, `when_surface: lcd` out of the browser.

    Reach for it where a row's action only exists on one of them: the backup and
    restore flows hand a file to the browser that opened them, and there is
    nobody on the other end of that on a display. It is a pane-row modifier
    only — a form field, an info line or a collection's editor row is part of one
    control and goes wherever that control goes.

    Storage defaults are untouched: a row shown on one surface still binds the
    same key on the device, unlike `when_kconfig`, which takes the feature out of
    the build entirely."""
    out: list[dict] = []
    for row in rows:
        want = row.get("when_surface")
        if want is None:
            out.append(row)
            continue
        if str(want) not in _SETTINGS_SURFACES:
            die(f"settings: when_surface: {want!r} — expected one of "
                f"{', '.join(_SETTINGS_SURFACES)}")
        if str(want) == surface:
            out.append(row)
    return out


def collect_kconfig_values(proj: Manifest, deps: list[Manifest]) -> dict[str, str]:
    """CONFIG_KEY → value string as the generated surfaces see the build:

      - the staged set's PRESENCE symbols (CONFIG_STRADDLE_<REPO>, plus the
        CONFIG_SPANGAP_<ALIAS> short forms), exactly the set
        write_presence_component declares for the compiler — so a row can be
        gated on another straddle being staged (gps's motion assist needs imu),
        which is a fact of the build rather than something a board should have
        to restate;
      - every staged straddle's `kconfig:` block (incl. desugared identity
        values), same precedence as write_sdkconfig_fragments: init order, last
        wins, buildable last. This is what lets a *settings scalar* reference a
        board-published Kconfig value (see _settings_scalar) — e.g. a TX-power
        slider whose max is the board's RF capability.

    A fragment wins over a presence symbol of the same name (they are emitted
    first), which matters to nobody today and keeps "what a straddle wrote"
    authoritative. Beyond those two sources a symbol is absent: one left at its
    component-Kconfig default, or set only from a buildable's sdkconfig.defaults
    or `spangap menuconfig`, does not appear here (callers carry a fallback)."""
    sources = init_order(deps) + [proj]
    staged_names = {s.name for s in sources}
    out: dict[str, str] = {}
    # Presence symbols for the staged deps — the buildable itself gets none,
    # here or in write_presence_component, so both halves agree about it too.
    for m in deps:
        out[f"CONFIG_STRADDLE_{_name_to_kconfig(m.repo)}"] = "y"
        alias = _SHORTCUT_ALIASES.get(m.repo)
        if alias:
            out[f"CONFIG_{alias}"] = "y"
    for m in sources:
        for raw in _flatten_kconfig(m.kconfig, staged_names) + m.identity_kconfig:
            line = raw.strip()
            if not _KCONFIG_LINE_RE.match(line) or "=" not in line:
                continue   # fragment validity is enforced in write_sdkconfig_fragments
            key, _, val = line.partition("=")
            out[key] = val
    return out


def _settings_scalar(spec_val, cfgvals: dict[str, str], where: str) -> int:
    """A settings integer scalar: either a plain int, or
    `{ kconfig: CONFIG_NAME, default: int }` — resolved from the staged set's
    collected `kconfig:` fragments so a board can size a control to its
    hardware (the default covers builds where no board sets the symbol)."""
    if isinstance(spec_val, dict):
        if "key" in spec_val:
            die(f"{where}: a storage-key bound is only valid on a slider's or an "
                f"integer's min/max, where the control can read it at run time")
        name = spec_val["kconfig"]
        raw = cfgvals.get(name)
        if raw is None:
            return int(spec_val["default"])
        try:
            return int(raw, 0)
        except ValueError:
            die(f"{where}: kconfig-referenced scalar {name}={raw!r} is not an integer")
    return int(spec_val)


def _settings_bound(spec_val, cfgvals: dict[str, str], where: str) -> tuple[int, str | None]:
    """A numeric bound (a slider's or an integer's): a settings scalar (fixed at
    build time), or
    `{ key: <storage key>, default: int }` — a value the device publishes and the
    control reads at run time. Returns (fallback, key or None).

    The key form exists for a limit the firmware knows and the build does not: a
    capability sensed on the hardware rather than declared for it. Both surfaces
    honour it, so a control sized this way reads the same on the panel and on the
    display, and falls back to `default` until the key exists."""
    if isinstance(spec_val, dict) and "key" in spec_val:
        return int(spec_val["default"]), str(spec_val["key"])
    return _settings_scalar(spec_val, cfgvals, where), None


class SettingsContribution:
    """One `settings:` entry, with everything the lowering needs attached: the
    straddle it came from, its arrival index (init order, then declaration
    order within the straddle) and its `order:`, if any."""

    __slots__ = ("manifest", "arrival", "segments", "rows", "order")

    def __init__(self, manifest: "Manifest", arrival: int, block: dict):
        self.manifest = manifest
        self.arrival = arrival
        self.segments = list(block["at"])
        self.rows = list(block.get("rows") or [])
        self.order = block.get("order")

    @property
    def path(self) -> str:
        return "/".join(seg["id"] for seg in self.segments)


def _order_key(order, arrival: int) -> tuple[int, int, int]:
    """THE sort key, used for everything that has siblings — nodes, rows, row
    blocks, list add-actions. Items carrying `order:` come first, ascending;
    everything without one follows in arrival order (straddle init order, then
    declaration order within the straddle). There are no placement buckets and
    no alphabetic tier: an unstated position means "after the stated ones, where
    I was declared", which is the order a reader of the yaml already sees."""
    return (0, int(order), arrival) if order is not None else (1, 0, arrival)


def collect_settings(proj: Manifest, deps: list[Manifest]) -> list[SettingsContribution]:
    """Every settings contribution across the staged set, in arrival order
    (init order, buildable last; declaration order within a straddle). A
    contribution is gated purely by its straddle being staged — there is no
    per-block `when:`; the LCD lowering is gated globally on spangap-lcd."""
    out: list[SettingsContribution] = []
    for m in init_order(deps) + [proj]:
        for block in m.settings:
            out.append(SettingsContribution(m, len(out), block))
    return out


def _settings_node_meta(contribs: list[SettingsContribution]) -> dict[str, dict]:
    """path -> {id, label, short, order} for every node in the tree.

    LAST SETTER WINS, per field, walking in arrival order. No node is owned, so
    naming one is not a claim on it: a straddle contributing rows to a menu
    somebody else named may state a label or an order and it takes, and the
    buildable — which arrives last of all — always has the final say over the
    tree its image ships. By convention a menu's naming is stated once, by the
    straddle the menu is there for, and everyone else names only the `id:` they
    are contributing at. A node nobody labels falls back to its title-cased
    id."""
    meta: dict[str, dict] = {}
    for c in contribs:
        path_ids: list[str] = []
        for seg in c.segments:
            path_ids.append(seg["id"])
            path = "/".join(path_ids)
            cur = meta.get(path)
            if cur is None:
                cur = {"id": seg["id"], "label": None, "short": None, "order": None}
                meta[path] = cur
            for field in ("label", "short", "order"):
                if field in seg:
                    cur[field] = seg[field]
    for path, cur in meta.items():
        if cur["label"] is None:
            cur["label"] = cur["id"][:1].upper() + cur["id"][1:]
        if cur["short"] is None:
            cur["short"] = cur["label"]
    return meta


def _sorted_settings(contribs: list[SettingsContribution]) -> list[SettingsContribution]:
    """Contributions in the order the runtimes should see them. Sorting here
    rather than in each runtime is what lets the runtime stores be plain
    insert-in-arrival-order structures: a node's position among its siblings is
    established by the first block that mentions it, and blocks at one node
    stay in their sorted relative order."""
    return sorted(contribs, key=lambda c: _order_key(c.order, c.arrival))


def _sorted_rows(rows: list[dict], cfgvals: dict[str, str]) -> list[dict]:
    """A row block's surviving rows, in the global sort order. Declaration
    order is the default; `order:` on a row jumps it ahead of the unordered
    ones."""
    live = [r for r in rows if _row_enabled(r, cfgvals)]
    return [r for _k, r in sorted(
        ((_order_key(r.get("order"), i), r) for i, r in enumerate(live)),
        key=lambda pair: pair[0])]


def _heading_runs(rows: list[dict]) -> list[tuple[str | None, dict | None, list[dict]]]:
    """A row block split at its `heading:` rows (level 2 — the groups) into
    (title, heading row, rows) groups. Rows before the first heading form the
    group titled None. Groups are what scope section merging: two straddles may
    both write `section: "Access code"` under different headings without their
    rows joining."""
    groups: list[tuple[str | None, dict | None, list[dict]]] = []
    title: str | None = None
    head: dict | None = None
    cur: list[dict] = []
    for r in rows:
        kind, spec = _row_kind(r)
        if kind == "heading":
            if cur or title is not None:
                groups.append((title, head, cur))
            title, head, cur = str(spec), r, []
        else:
            cur.append(r)
    if cur or title is not None:
        groups.append((title, head, cur))
    return groups


def _section_runs(rows: list[dict]) -> list[tuple[str | None, dict | None, list[dict]]]:
    """A row block split at its `section:` rows into (title, heading row, rows)
    runs. The rows before the first section are the run titled None, whose
    heading row is None. The heading row travels with its run so a modifier on
    it — a `when_key` gate, a `when_surface` one — survives the merge below."""
    runs: list[tuple[str | None, dict | None, list[dict]]] = []
    title: str | None = None
    head: dict | None = None
    cur: list[dict] = []
    for r in rows:
        kind, spec = _row_kind(r)
        if kind == "section":
            if cur or title is not None:
                runs.append((title, head, cur))
            title, head, cur = str(spec), r, []
        else:
            cur.append(r)
    if cur or title is not None:
        runs.append((title, head, cur))
    return runs


def _merge_rows(blocks: list[list[dict]], path: str) -> list[dict]:
    """Every row block at one node, as one list of rows, merged at two levels.

    Level 2 (`heading:`) groups join on the SAME HEADING TITLE — a straddle
    contributing under `heading: "LoRa"` lands its rows inside the existing
    LoRa group. Rows before any heading — the pane's `title:` among them —
    form the headerless group at the top.
    Level 3: within one heading group, `section:` runs under the SAME SECTION
    TITLE join exactly as before — and only within that group, so two
    straddles may both write `section: "Access code"` under different
    headings without their rows joining. That is the whole point of a node
    nobody owns — two straddles describing the same subject arrive under one
    heading instead of beside each other.

    Merging has to happen HERE. Each runtime receives a node's contributions as
    opaque per-node builders, so neither could interleave two of them; the
    generator is the last place that still has the rows themselves."""
    gorder: list[str | None] = []
    gblocks: dict[str | None, list[list[dict]]] = {}
    gheads: dict[str | None, dict] = {}
    for rows in blocks:
        for gtitle, ghead, group_rows in _heading_runs(rows):
            if gtitle is not None and gtitle not in gheads:
                gheads[gtitle] = ghead
            if gtitle not in gblocks:
                gblocks[gtitle] = []
                gorder.insert(0, None) if gtitle is None else gorder.append(gtitle)
            gblocks[gtitle].append(group_rows)
    out: list[dict] = []
    for gtitle in gorder:
        if gtitle is not None:
            out.append(gheads[gtitle])
        out.extend(_merge_section_rows(gblocks[gtitle], path))
    return out


def _merge_section_rows(blocks: list[list[dict]], path: str) -> list[dict]:
    """Level-2 merge: every row block of ONE heading group, its section runs
    joined by title."""
    order: list[str | None] = []
    runs: dict[str | None, list[dict]] = {}
    heads: dict[str | None, dict] = {}
    for rows in blocks:
        for title, head, block_rows in _section_runs(rows):
            if title is not None and title not in heads:
                heads[title] = head       # the first writer's heading, gates and all
            if title not in runs:
                if title is not None:
                    near = next((t for t in runs
                                 if t is not None and t.lower() == title.lower()), None)
                    if near is not None:
                        warn(f"settings: node '{path}' has both {near!r} and {title!r} — "
                             f"section titles merge on an exact match, so these stay two "
                             f"headings")
                runs[title] = []
                # The headerless run is the top of the node by definition; a
                # section is appended in the order it first appears.
                order.insert(0, None) if title is None else order.append(title)
            runs[title].extend(block_rows)
    out: list[dict] = []
    for title in order:
        if title is not None:
            out.append(heads[title])
        out.extend(runs[title])
    return out


def _settings_nodes(contribs: list[SettingsContribution],
                    cfgvals: dict[str, str]) -> list[tuple[list[dict], list[dict]]]:
    """(segments, rows) per NODE — one entry per distinct path, in the order the
    sorted contributions first mention it, with every block at that path merged.

    One entry per node rather than per contribution is what lets sections merge
    at all, and it costs the runtimes nothing: a node's position among its
    siblings is still established by the first block that mentions it."""
    paths: list[str] = []
    segs: dict[str, list[dict]] = {}
    blocks: dict[str, list[list[dict]]] = {}
    for c in _sorted_settings(contribs):
        if c.path not in blocks:
            paths.append(c.path)
            blocks[c.path] = []
            segs[c.path] = c.segments      # ids are the path; naming comes from meta
        blocks[c.path].append(_sorted_rows(c.rows, cfgvals))
    return [(segs[p], _merge_rows(blocks[p], p)) for p in paths]


def _row_binding(spec) -> tuple[str, str]:
    """(key, field) of a binding row: rows in a pane bind a storage `key:`,
    rows in a form or an item editor bind a local `field:`. Exactly one."""
    if not isinstance(spec, dict):
        return "", ""
    return str(spec.get("key", "")), str(spec.get("field", ""))


# ---- web lowering -------------------------------------------------------

def _web_action(action: dict, cfgvals: dict[str, str]) -> dict:
    """An action as the browser's runAction() consumes it. Passed through as
    data — the same three shapes the yaml declares."""
    if "set" in action:
        spec = action["set"]
        out = {"set": {"key": spec["key"], "value": str(spec["value"])}}
        if spec.get("edge"):
            out["set"]["edge"] = True
        if spec.get("reboots"):
            out["set"]["reboots"] = True
        return out
    if "dialog" in action:
        spec = action["dialog"]
        buttons = []
        for b in spec["buttons"]:
            btn: dict = {"label": b["label"]}
            if b.get("color"):
                btn["color"] = b["color"]
            if "do" in b:
                btn["do"] = _web_action(b["do"], cfgvals)
            buttons.append(btn)
        return {"dialog": {"text": spec["text"], "buttons": buttons}}
    if "form" in action:
        return {"form": _web_form(action["form"], cfgvals)}
    die(f"settings action has no kind: {action!r}")


def _form_cmd(form: dict, default: str | None, where: str) -> str:
    """A form's sentinel. A collection's add form inherits `<cmd>.add` rather
    than restating it — the four sentinel keys stay derived from the one `cmd`
    name the collection declares."""
    cmd = form.get("cmd") or default
    if not cmd:
        die(f"{where}: a form: action needs a cmd: — the sentinel it submits to")
    return cmd


def _web_form(form: dict, cfgvals: dict[str, str], cmd: str | None = None) -> dict:
    out = {"fields": [_web_row(r, cfgvals) for r in _sorted_rows(form["fields"], cfgvals)],
           "cmd": _form_cmd(form, cmd, "settings form")}
    if "submit" in form:
        out["submit"] = form["submit"]
    if "title" in form:
        out["title"] = form["title"]
    return out


def _web_collection(spec: dict, cfgvals: dict[str, str]) -> dict:
    out: dict = {"kind": "list", "k": spec["key"], "id": spec["id"],
                 "item": spec["item"], "cmd": spec["cmd"]}
    for src, dst in (("label", "label"), ("caption", "caption"),
                     ("subtitle", "subtitle"),
                     ("status", "status"), ("empty", "empty")):
        if src in spec:
            out[dst] = spec[src]
    if spec.get("reorder"):
        out["reorder"] = True
    adds = spec.get("add") or []
    ordered_adds = [a for _k, a in sorted(
        ((_order_key(a.get("order"), i), a) for i, a in enumerate(adds)),
        key=lambda pair: pair[0])]
    if ordered_adds:
        out["add"] = [{"label": a["label"],
                       "form": _web_form(a["form"], cfgvals, spec["cmd"] + ".add")}
                      for a in ordered_adds]
    if "remove" in spec:
        rm = spec["remove"] or {}
        out["remove"] = {"confirm": rm["confirm"]} if "confirm" in rm else {}
    if spec.get("actions"):
        out["actions"] = [{"label": a["label"],
                           **({"color": a["color"]} if a.get("color") else {}),
                           **({"whenKey": a["when_key"]} if a.get("when_key") else {}),
                           "do": _web_action(a["do"], cfgvals)}
                          for a in spec["actions"]]
    if spec.get("edit"):
        out["edit"] = [_web_row(r, cfgvals) for r in _sorted_rows(spec["edit"], cfgvals)]
    if "candidates" in spec:
        cand = spec["candidates"]
        c: dict = {"k": cand["key"], "item": cand["item"]}
        if "subtitle" in cand:
            c["subtitle"] = cand["subtitle"]
        if "found" in cand:
            c["found"] = cand["found"]
        if "refresh" in cand:
            c["refresh"] = {"label": cand["refresh"]["label"],
                            "do": _web_action(cand["refresh"]["do"], cfgvals)}
        if "map" in cand:
            c["map"] = dict(cand["map"])
        out["candidates"] = c
    return out


def _info_rows(spec: dict, cfgvals: dict[str, str]) -> list[dict]:
    """An info group's lines. Read-only values only: the group's narrow shared
    label column is a promise a control cannot keep, so anything interactive
    belongs in an ordinary row above or below it."""
    rows = _sorted_rows(spec["rows"], cfgvals)
    for r in rows:
        kind, _spec = _row_kind(r)
        if kind != "value":
            die(f"settings: an info: group holds value rows, not {kind!r} — a control "
                f"needs room the group's shared label column does not give it")
    return rows


def _web_button(btn: dict, cfgvals: dict[str, str]) -> dict:
    """One button of a `buttons:` row. Its `when_key` gates that button alone."""
    out: dict = {"label": btn["label"], "do": _web_action(btn["do"], cfgvals)}
    if btn.get("color"):
        out["color"] = btn["color"]
    if "when_key" in btn:
        out["whenKey"] = btn["when_key"]
    return out


def _web_row(row: dict, cfgvals: dict[str, str]) -> dict:
    kind, spec = _row_kind(row)
    if kind in ("title", "heading", "section", "caption"):
        out: dict = {"kind": kind, "text": spec}
    elif kind == "advanced":
        out = {"kind": "advanced",
               "label": spec.get("label", "Advanced Settings") if isinstance(spec, dict)
                        else "Advanced Settings",
               "rows": [_web_row(r, cfgvals)
                        for r in _sorted_rows(spec["rows"], cfgvals)]}
    elif kind == "switch":
        out = {"kind": "switch", "label": spec["label"]}
    elif kind == "slider":
        where = f"slider {spec.get('key') or spec.get('field')}"
        lo, lo_key = _settings_bound(spec["min"], cfgvals, where)
        hi, hi_key = _settings_bound(spec["max"], cfgvals, where)
        out = {"kind": "slider", "label": spec["label"], "min": lo, "max": hi}
        if lo_key:
            out["minKey"] = lo_key
        if hi_key:
            out["maxKey"] = hi_key
    elif kind == "integer":
        # A bound the yaml leaves out is a bound the quantity does not have, so
        # it is absent here rather than defaulted to a number the control would
        # then enforce.
        where = f"integer {spec.get('key') or spec.get('field')}"
        out = {"kind": "integer", "label": spec["label"]}
        for src, num, keyname in (("min", "min", "minKey"), ("max", "max", "maxKey")):
            if src not in spec:
                continue
            val, val_key = _settings_bound(spec[src], cfgvals, where)
            out[num] = val
            if val_key:
                out[keyname] = val_key
        step = _settings_scalar(spec.get("step", 1), cfgvals, where)
        if step != 1:
            out["step"] = step
        if spec.get("buttons"):
            out["buttons"] = True
        if "unit" in spec:
            out["unit"] = spec["unit"]
    elif kind in ("text", "ipv4"):
        out = {"kind": kind, "label": spec["label"]}
        if spec.get("secret"):
            out["secret"] = True
        if spec.get("short"):
            out["short"] = True
        if "unit" in spec:
            out["unit"] = spec["unit"]
        if "placeholder" in spec:
            out["placeholder"] = spec["placeholder"]
        if "placeholder_key" in spec:
            out["placeholderKey"] = spec["placeholder_key"]
    elif kind == "dropdown":
        out = {"kind": "dropdown", "label": spec["label"],
               "options": [{"value": str(o["v"]), "label": o["l"]} for o in spec["options"]]}
        if spec.get("searchable"):
            out["searchable"] = True
    elif kind == "timezone":
        # Optionless by design: the browser builds its list from the client's
        # own Intl database. The LCD half reads the on-device zone DB instead.
        out = {"kind": "timezone", "label": spec["label"], "field": spec["field"]}
        if "placeholder_key" in spec:
            out["placeholderKey"] = spec["placeholder_key"]
    elif kind == "value":
        out = {"kind": "value", "label": spec["label"], "k": spec["key"]}
        if spec.get("copyable"):
            out["copyable"] = True
    elif kind == "button":
        out = {"kind": "button", "label": spec["label"], "do": _web_action(spec["do"], cfgvals)}
        if spec.get("color"):
            out["color"] = spec["color"]
    elif kind == "buttons":
        out = {"kind": "buttons", "items": [_web_button(b, cfgvals) for b in spec["items"]]}
        if spec.get("align"):
            out["align"] = spec["align"]
    elif kind == "info":
        out = {"kind": "info", "rows": [_web_row(r, cfgvals) for r in _info_rows(spec, cfgvals)]}
    elif kind == "list":
        out = _web_collection(spec, cfgvals)
    else:
        die(f"settings: unknown row kind {kind!r}")

    if kind in _SETTINGS_BINDING_KINDS:
        key, field = _row_binding(spec)
        if key:
            out["k"] = key
        if field:
            out["field"] = field
        if "default" in spec and field:
            # Form/item-editor prefill. Never seeded into storage; a template
            # over sibling fields is resolved live by the form until the
            # operator edits the field.
            dv = spec["default"]
            out["dflt"] = str(int(dv)) if isinstance(dv, bool) else str(dv)
    if "when_key" in row:
        out["whenKey"] = row["when_key"]
    return out


def _settings_web_nodes(contribs: list[SettingsContribution],
                        meta: dict[str, dict],
                        cfgvals: dict[str, str]) -> list[dict]:
    """The browser-side node fragments, serialized into straddles.gen.ts. One
    per node — a path (segments carrying their resolved naming) plus that node's
    merged rows; the settings-tree store merges them by segment id."""
    out: list[dict] = []
    for segments_in, rows in _settings_nodes(contribs, cfgvals):
        segments = []
        path_ids: list[str] = []
        for seg in segments_in:
            path_ids.append(seg["id"])
            m = meta["/".join(path_ids)]
            s: dict = {"id": m["id"], "label": m["label"]}
            if m["short"] != m["label"]:
                s["short"] = m["short"]
            if m["order"] is not None:
                s["order"] = int(m["order"])
            segments.append(s)
        out.append({"segments": segments,
                    "rows": [_web_row(r, cfgvals)
                             for r in _surface_rows(rows, "web")]})
    return out


# ---- LCD lowering -------------------------------------------------------

_LCD_ROW_KIND = {
    # Three heading levels, told apart on the display the way they are in the
    # browser — by size, and by the page's own name not taking the accent that
    # marks a divider within it.
    "title": "LCD_ROW_TITLE", "heading": "LCD_ROW_HEADING",
    "section": "LCD_ROW_SECTION", "caption": "LCD_ROW_CAPTION",
    "switch": "LCD_ROW_SWITCH", "slider": "LCD_ROW_SLIDER",
    "integer": "LCD_ROW_INTEGER", "ipv4": "LCD_ROW_IPV4",
    "text": "LCD_ROW_TEXT", "dropdown": "LCD_ROW_DROPDOWN",
    "timezone": "LCD_ROW_TIMEZONE",
    "value": "LCD_ROW_VALUE", "button": "LCD_ROW_BUTTON",
    "list": "LCD_ROW_LIST",
}

_LCD_ALIGN = {"left": "LCD_ALIGN_LEFT", "center": "LCD_ALIGN_CENTER",
              "right": "LCD_ALIGN_RIGHT"}

# Row kinds that describe a whole area of a pane rather than one labelled row.
# They exist only in a pane: a form or an item editor is a column of fields.
_SETTINGS_PANE_ONLY_KINDS = {"buttons", "info"}


def _ccolor(spec: dict) -> str:
    """A colour as a C literal — the palette name straight through, since both
    surfaces resolve it through the same table. Unstated is nullptr, which is
    the control's own colour."""
    return _cstr(spec["color"]) if spec.get("color") else "nullptr"


class _LcdSettingsEmitter:
    """Lowers the settings tree to the LCD half.

    Simple rows stay CALLS — one `lcdSetting*` per row inside a per-contribution
    builder function, which is what a hand-written pane writes by hand and what
    keeps the two indistinguishable. Collections, forms and dialogs instead
    become static DESCRIPTOR STRUCTS consumed by generic runtime functions:
    generating data rather than logic keeps the generated file small and puts
    the behaviour in one reviewable place, the same argument that chose a
    runtime-interpreted descriptor over generated Vue components on the web
    side. Every string is emitted as a literal, so the settings helpers'
    by-pointer key-lifetime rule holds for free."""

    def __init__(self, cfgvals: dict[str, str]):
        self.cfgvals = cfgvals
        self.defs: list[str] = []      # static descriptors, in dependency order
        self.n = 0                     # unique-symbol counter
        # Whether the row just emitted was a heading — see the caption case in
        # pane_call. Reset per node by node().
        self.after_heading = False

    def _sym(self, stem: str) -> str:
        self.n += 1
        return f"spangapGenSet{stem}_{self.n}"

    # -- descriptors --

    def action(self, action: dict) -> str:
        """Emit an lcd_action_t and return its address expression."""
        kind, key, value, edge, reboots = "LCD_ACT_SET", "nullptr", "nullptr", "false", "false"
        dialog, form = "nullptr", "nullptr"
        if "set" in action:
            spec = action["set"]
            key, value = _cstr(spec["key"]), _cstr(str(spec["value"]))
            edge = "true" if spec.get("edge") else "false"
            reboots = "true" if spec.get("reboots") else "false"
        elif "dialog" in action:
            kind, dialog = "LCD_ACT_DIALOG", self.dialog(action["dialog"])
        elif "form" in action:
            kind, form = "LCD_ACT_FORM", self.form(action["form"])
        else:
            die(f"settings action has no kind: {action!r}")
        sym = self._sym("Act")
        self.defs.append(
            f"static const lcd_action_t {sym} = {{ .kind = {kind}, .key = {key},\n"
            f"    .value = {value}, .edge = {edge}, .reboots = {reboots},\n"
            f"    .dialog = {dialog}, .form = {form} }};")
        return f"&{sym}"

    def num_spec(self, spec: dict) -> str:
        """Emit an `integer:` row's lcd_num_t and return its address expression.

        A bound the yaml leaves out stays absent (`has_min` / `has_max` false)
        rather than becoming a number the control would enforce — an unbounded
        quantity has no bound, which is not the same as one bounded at zero.
        Field order here follows the struct's, so the designated initializers
        stay legal C++."""
        where = f"integer {spec.get('key') or spec.get('field')}"
        lo, lo_key = _settings_bound(spec["min"], self.cfgvals, where) \
            if "min" in spec else (0, None)
        hi, hi_key = _settings_bound(spec["max"], self.cfgvals, where) \
            if "max" in spec else (0, None)
        f: dict[str, str] = {}
        if "min" in spec:
            f["min"] = str(lo)
        if "max" in spec:
            f["max"] = str(hi)
        if "min" in spec:
            f["has_min"] = "true"
        if "max" in spec:
            f["has_max"] = "true"
        if lo_key:
            f["min_key"] = _cstr(lo_key)
        if hi_key:
            f["max_key"] = _cstr(hi_key)
        step = _settings_scalar(spec.get("step", 1), self.cfgvals, where)
        if step != 1:
            f["step"] = str(step)
        if spec.get("buttons"):
            f["buttons"] = "true"
        sym = self._sym("Num")
        body = ", ".join(f".{k} = {v}" for k, v in f.items())
        self.defs.append(f"static const lcd_num_t {sym} = {{ {body} }};")
        return f"&{sym}"

    def dialog(self, spec: dict) -> str:
        btns = [(b, self.action(b["do"]) if "do" in b else "nullptr") for b in spec["buttons"]]
        bsym = self._sym("DlgBtns")
        lines = [f"static const lcd_dlg_btn_t {bsym}[] = {{"]
        for b, act in btns:
            lines.append(f"    {{ .label = {_cstr(b['label'])}, "
                         f".color = {_ccolor(b)}, .act = {act} }},")
        lines.append("};")
        self.defs.append("\n".join(lines))
        sym = self._sym("Dlg")
        self.defs.append(
            f"static const lcd_dialog_t {sym} = {{ .text = {_cstr(spec['text'])},\n"
            f"    .buttons = {bsym}, .nbuttons = {len(btns)} }};")
        return f"&{sym}"

    def _flatten_rows(self, rows: list[dict]) -> list[dict]:
        """Form/item-editor rows with the LCD's degradations applied: a
        `heading:` becomes a section, an `advanced:` group becomes its label as
        a section followed by its rows inline — the display has no disclosure
        control, and a longer scrolling pane beats an absent one."""
        out: list[dict] = []
        for r in _sorted_rows(rows, self.cfgvals):
            kind, spec = _row_kind(r)
            if kind in ("title", "heading"):
                out.append({"section": spec})
            elif kind == "advanced":
                label = spec.get("label", "Advanced Settings") if isinstance(spec, dict) \
                    else "Advanced Settings"
                out.append({"section": label})
                out.extend(self._flatten_rows(spec["rows"]))
            else:
                out.append(r)
        return out

    def rows_array(self, rows: list[dict]) -> tuple[str, int]:
        """Emit an lcd_row_t[] (form fields / item-editor rows) and return
        (symbol, count). Unlike a pane's rows these are DATA — the runtime
        builds them against a local field buffer, not against storage."""
        live = self._flatten_rows(rows)
        inner = [self.row_struct(r) for r in live]   # emit nested descriptors first
        sym = self._sym("Rows")
        lines = [f"static const lcd_row_t {sym}[] = {{"]
        lines.extend(inner)
        lines.append("};")
        self.defs.append("\n".join(lines))
        return sym, len(live)

    def btn_array(self, items: list[dict]) -> tuple[str, int]:
        """Emit an lcd_btn_t[] for a `buttons:` row; returns (symbol, count)."""
        btns = [(b, self.action(b["do"])) for b in items]   # actions first
        sym = self._sym("Btns")
        lines = [f"static const lcd_btn_t {sym}[] = {{"]
        for b, act in btns:
            when = _cstr(b["when_key"]) if "when_key" in b else "nullptr"
            lines.append(f"    {{ .label = {_cstr(b['label'])}, .color = {_ccolor(b)}, "
                         f".when_key = {when}, .act = {act} }},")
        lines.append("};")
        self.defs.append("\n".join(lines))
        return sym, len(btns)

    def row_struct(self, row: dict) -> str:
        """One lcd_row_t initializer line (fields in declaration order, so the
        designated initializers stay legal C++)."""
        kind, spec = _row_kind(row)
        if kind in _SETTINGS_PANE_ONLY_KINDS:
            die(f"settings: a {kind}: row describes an area of a pane — a form or an "
                f"item editor is a column of fields, so it cannot hold one")
        f: dict[str, str] = {"kind": _LCD_ROW_KIND[kind]}
        if kind in ("section", "caption"):
            f["label"] = _cstr(spec)
        else:
            f["label"] = _cstr(spec["label"])
        if isinstance(spec, dict):
            key, field = _row_binding(spec)
            if key:
                f["key"] = _cstr(key)
            if field:
                f["field"] = _cstr(field)
        if "when_key" in row:
            f["when_key"] = _cstr(row["when_key"])
        if kind == "slider":
            where = f"slider {spec.get('key') or spec.get('field')}"
            lo, lo_key = _settings_bound(spec["min"], self.cfgvals, where)
            hi, hi_key = _settings_bound(spec["max"], self.cfgvals, where)
            f["min"], f["max"] = str(lo), str(hi)
            if lo_key:
                f["min_key"] = _cstr(lo_key)
            if hi_key:
                f["max_key"] = _cstr(hi_key)
        if kind in ("text", "ipv4"):
            if spec.get("secret"):
                f["secret"] = "true"
            if "placeholder" in spec:
                f["placeholder"] = _cstr(spec["placeholder"])
            if "placeholder_key" in spec:
                f["placeholder_key"] = _cstr(spec["placeholder_key"])
        if kind == "value" and spec.get("copyable"):
            f["copyable"] = "true"
        if kind == "timezone" and "placeholder_key" in spec:
            f["placeholder_key"] = _cstr(spec["placeholder_key"])
        if kind == "dropdown":
            f["options"] = _cstr("\n".join(str(o["v"]) for o in spec["options"]))
            f["opt_labels"] = _cstr("\n".join(str(o["l"]) for o in spec["options"]))
        if isinstance(spec, dict) and "unit" in spec:
            f["unit"] = _cstr(spec["unit"])
        if isinstance(spec, dict) and spec.get("short"):
            f["short_"] = "true"
        if isinstance(spec, dict) and "default" in spec and spec.get("field"):
            dv = spec["default"]
            f["dflt"] = _cstr("1" if dv is True else "0" if dv is False else str(dv))
        if kind == "button":
            f["act"] = self.action(spec["do"])
        if kind == "list":
            f["coll"] = self.collection(spec)
        if kind == "integer":
            f["num"] = self.num_spec(spec)
        body = ", ".join(f".{k} = {v}" for k, v in f.items())
        return f"    {{ {body} }},"

    def form(self, spec: dict, cmd: str | None = None) -> str:
        rows_sym, n = self.rows_array(spec["fields"])
        sym = self._sym("Form")
        self.defs.append(
            f"static const lcd_form_t {sym} = {{ .fields = {rows_sym}, .nfields = {n},\n"
            f"    .cmd = {_cstr(_form_cmd(spec, cmd, 'settings form'))}, "
            f".submit = {_cstr(spec.get('submit', 'Save'))}, "
            f".title = {_cstr(spec.get('title', ''))} }};")
        return f"&{sym}"

    def collection(self, spec: dict) -> str:
        adds = spec.get("add") or []
        ordered_adds = [a for _k, a in sorted(
            ((_order_key(a.get("order"), i), a) for i, a in enumerate(adds)),
            key=lambda pair: pair[0])]
        adds_sym = "nullptr"
        if ordered_adds:
            forms = [(a, self.form(a["form"], spec["cmd"] + ".add")) for a in ordered_adds]
            adds_sym = self._sym("Adds")
            lines = [f"static const lcd_add_t {adds_sym}[] = {{"]
            for a, fsym in forms:
                lines.append(f"    {{ .label = {_cstr(a['label'])}, .form = {fsym} }},")
            lines.append("};")
            self.defs.append("\n".join(lines))

        acts_sym = "nullptr"
        if spec.get("actions"):
            acts = [(a, self.action(a["do"])) for a in spec["actions"]]
            acts_sym = self._sym("ItemActs")
            lines = [f"static const lcd_item_action_t {acts_sym}[] = {{"]
            for a, asym in acts:
                when = _cstr(a["when_key"]) if "when_key" in a else "nullptr"
                lines.append(f"    {{ .label = {_cstr(a['label'])}, "
                             f".color = {_ccolor(a)}, .when_key = {when}, "
                             f".act = {asym} }},")
            lines.append("};")
            self.defs.append("\n".join(lines))

        edit_sym, nedit = ("nullptr", 0)
        if spec.get("edit"):
            edit_sym, nedit = self.rows_array(spec["edit"])

        cand_sym = "nullptr"
        if "candidates" in spec:
            cand = spec["candidates"]
            refresh = self.action(cand["refresh"]["do"]) if "refresh" in cand else "nullptr"
            # candidate-field -> add-form-field renames, as "from:to,from:to".
            mapping = ",".join(f"{k}:{v}" for k, v in (cand.get("map") or {}).items())
            cand_sym = self._sym("Cand")
            self.defs.append(
                f"static const lcd_candidates_t {cand_sym} = {{ .key = {_cstr(cand['key'])},\n"
                f"    .item = {_cstr(cand['item'])}, "
                f".subtitle = {_cstr(cand.get('subtitle', ''))},\n"
                f"    .refresh_label = "
                f"{_cstr(cand['refresh']['label']) if 'refresh' in cand else 'nullptr'},\n"
                f"    .found = {_cstr(cand.get('found', ''))},\n"
                f"    .refresh = {refresh}, .map = {_cstr(mapping)} }};")
            cand_sym = f"&{cand_sym}"

        rm = spec.get("remove")
        sym = self._sym("Coll")
        self.defs.append(
            f"static const lcd_collection_t {sym} = {{\n"
            f"    .label = {_cstr(spec.get('label', ''))}, "
            f".caption = {_cstr(spec.get('caption', ''))},\n"
            f"    .key = {_cstr(spec['key'])},\n"
            f"    .id = {_cstr(spec['id'])}, .item = {_cstr(spec['item'])},\n"
            f"    .subtitle = {_cstr(spec.get('subtitle', ''))}, "
            f".status = {_cstr(spec.get('status', ''))},\n"
            f"    .empty = {_cstr(spec.get('empty', ''))}, "
            f".reorder = {'true' if spec.get('reorder') else 'false'},\n"
            f"    .cmd = {_cstr(spec['cmd'])},\n"
            f"    .adds = {adds_sym}, .nadds = {len(ordered_adds)},\n"
            f"    .has_remove = {'true' if rm is not None else 'false'},\n"
            f"    .remove_confirm = {_cstr((rm or {}).get('confirm', ''))},\n"
            f"    .actions = {acts_sym}, .nactions = {len(spec.get('actions') or [])},\n"
            f"    .edit = {edit_sym}, .nedit = {nedit},\n"
            f"    .candidates = {cand_sym} }};")
        return f"&{sym}"

    # -- pane builders --

    def pane_call(self, row: dict) -> str:
        """The lcdSetting* call for one pane row, wrapped in the `when_key`
        visibility helper when the row carries one (every helper returns its
        row object, so the wrap composes)."""
        kind, spec = _row_kind(row)
        if kind in ("title", "heading", "section"):
            # Each level has its own look; the display takes no indentation
            # from any of them, since it has no width to spend on one.
            fn = {"title": "lcdSettingTitle", "heading": "lcdSettingHeading",
                  "section": "lcdSettingSection"}[kind]
            call = f"{fn}(p, {_cstr(spec)})"
        elif kind == "advanced":
            # No disclosure control on the display: the group is its label as a
            # section, rows inline. Any `when_key` on the group is not carried.
            label = spec.get("label", "Advanced Settings") if isinstance(spec, dict) \
                else "Advanced Settings"
            lines = [f"    lcdSettingSection(p, {_cstr(label)});"]
            for r in _sorted_rows(spec["rows"], self.cfgvals):
                lines.append(self.pane_call(r))
            return "\n".join(lines)
        elif kind == "caption":
            # A caption directly under a heading is about the GROUP and spans
            # both columns; one under a field is about that field and starts on
            # the control column. Only the row order knows which, and this is
            # the last place that has it.
            wide = "true" if self.after_heading else "false"
            call = f"lcdSettingCaption(p, {_cstr(spec)}, {wide})"
        elif kind == "switch":
            call = f"lcdSettingSwitch(p, {_cstr(spec['label'])}, {_cstr(spec['key'])})"
        elif kind == "slider":
            where = f"slider {spec['key']}"
            lo, lo_key = _settings_bound(spec["min"], self.cfgvals, where)
            hi, hi_key = _settings_bound(spec["max"], self.cfgvals, where)
            args = f"{lo}, {hi}"
            if lo_key or hi_key:
                args += f", {_cstr(lo_key) if lo_key else 'nullptr'}"
                args += f", {_cstr(hi_key) if hi_key else 'nullptr'}"
            call = f"lcdSettingSlider(p, {_cstr(spec['label'])}, {_cstr(spec['key'])}, {args})"
        elif kind == "integer":
            call = (f"lcdSettingInteger(p, {_cstr(spec['label'])}, "
                    f"{_cstr(spec['key'])}, {self.num_spec(spec)}, "
                    f"{_cstr(spec['unit']) if 'unit' in spec else 'nullptr'})")
        elif kind == "ipv4":
            call = (f"lcdSettingIpv4(p, {_cstr(spec['label'])}, {_cstr(spec['key'])}, "
                    f"{_cstr(spec['unit']) if 'unit' in spec else 'nullptr'})")
        elif kind == "text":
            args = "true" if spec.get("secret") else "false"
            args += f", {_cstr(spec['unit']) if 'unit' in spec else 'nullptr'}"
            args += ", true" if spec.get("short") else ", false"
            call = (f"lcdSettingText(p, {_cstr(spec['label'])}, "
                    f"{_cstr(spec['key'])}, {args})")
        elif kind == "dropdown":
            csv = ",".join(str(o["v"]) for o in spec["options"])
            call = (f"lcdSettingDropdown(p, {_cstr(spec['label'])}, "
                    f"{_cstr(spec['key'])}, {_cstr(csv)})")
        elif kind == "timezone":
            die("settings: timezone: is a form field — the picked name must go "
                "through a validating sentinel, so it cannot bind a pane row")
        elif kind == "value":
            call = f"lcdSettingValue(p, {_cstr(spec['label'])}, {_cstr(spec['key'])})"
        elif kind == "button":
            call = (f"lcdSettingAction(p, {_cstr(spec['label'])}, "
                    f"{self.action(spec['do'])}, {_ccolor(spec)})")
        elif kind == "buttons":
            sym, n = self.btn_array(spec["items"])
            align = _LCD_ALIGN[spec.get("align", "left")]
            call = f"lcdSettingActionRow(p, {align}, {sym}, {n})"
        elif kind == "info":
            return self.info_block(row, spec)
        elif kind == "list":
            call = f"lcdSettingCollection(p, {self.collection(spec)})"
        else:
            die(f"settings: unknown row kind {kind!r}")
        if kind in ("title", "heading", "section"):
            self.after_heading = True
        elif kind != "caption":
            self.after_heading = False
        if "when_key" in row:
            call = f"lcdSettingWhenKey({call}, {_cstr(row['when_key'])})"
        return f"    {call};"

    def info_block(self, row: dict, spec: dict) -> str:
        """An info group, as its own braced scope. The group is three calls —
        open, a line per value, then fit — because the shared label column is
        only knowable once every label exists; the braces let `g` keep the same
        name in every group of a pane. A gate on the group rides the group
        object, exactly as a gate on a row rides the row."""
        lines = ["    {", "        lv_obj_t* g = lcdSettingInfo(p);"]
        for r in _info_rows(spec, self.cfgvals):
            _k, s = _row_kind(r)
            call = f"lcdSettingInfoValue(g, {_cstr(s['label'])}, {_cstr(s['key'])})"
            if "when_key" in r:
                call = f"lcdSettingWhenKey({call}, {_cstr(r['when_key'])})"
            lines.append(f"        {call};")
        lines.append("        lcdSettingInfoFit(g);")
        if "when_key" in row:
            lines.append(f"        lcdSettingWhenKey(g, {_cstr(row['when_key'])});")
        lines.append("    }")
        return "\n".join(lines)

    def node(self, idx: int, segments: list[dict], rows: list[dict],
             meta: dict[str, dict]) -> tuple[str, str]:
        """(segment-array symbol, builder symbol or 'nullptr') for one NODE —
        every block at that path already merged; its descriptors and builder
        land in self.defs."""
        seg_sym = f"spangapGenSetSegs_{idx}"
        lines = [f"static const lcd_seg_t {seg_sym}[] = {{"]
        path_ids: list[str] = []
        for seg in segments:
            path_ids.append(seg["id"])
            m = meta["/".join(path_ids)]
            order = "0, .has_order = false" if m["order"] is None \
                else f"{int(m['order'])}, .has_order = true"
            lines.append(f"    {{ .id = {_cstr(m['id'])}, .label = {_cstr(m['label'])}, "
                         f".shortName = {_cstr(m['short'])}, .order = {order} }},")
        lines.append("};")
        self.defs.append("\n".join(lines))

        if not rows:
            return seg_sym, "nullptr"
        self.after_heading = False
        calls = [self.pane_call(r) for r in rows]   # emits nested descriptors first
        fn = f"spangapGenSetPane_{idx}"
        self.defs.append(
            f"static void {fn}(void* arg) {{\n"
            f"    lv_obj_t* p = static_cast<lv_obj_t*>(arg);\n"
            + "\n".join(calls) + "\n}")
        return seg_sym, fn


def _settings_lcd_cpp(contribs: list[SettingsContribution],
                      meta: dict[str, dict],
                      cfgvals: dict[str, str]) -> tuple[str, str]:
    """(static descriptors + builder defs, body of spangapSettingsGenRegister)
    for the LCD half. One contribution per node, not per block — the blocks are
    merged before they get here, which is what lets two straddles' rows share a
    section heading."""
    em = _LcdSettingsEmitter(cfgvals)
    reg: list[str] = []
    for idx, (segments, rows) in enumerate(_settings_nodes(contribs, cfgvals)):
        seg_sym, fn = em.node(idx, segments, _surface_rows(rows, "lcd"), meta)
        reg.append(f"    lcdSettingsContribute({seg_sym}, {len(segments)}, {fn});")
    return "\n\n".join(em.defs), "\n".join(reg)


# ---- storage defaults ---------------------------------------------------

def _settings_defaults_cpp(contribs: list[SettingsContribution],
                           cfgvals: dict[str, str]) -> str:
    """Body of spangapSettingsGenDefaults — one storageDefault() per binding row
    that carries a `default:` and whose key is persisted config (`s.` prefix).

    Ephemeral keys, secrets and FORM FIELDS are never seeded: a form field's
    `default:` is prefill for the dialog, not a value the device should hold
    before anyone submits one."""
    lines: list[str] = []
    seen: set[str] = set()

    def walk(rows: list[dict]) -> None:
        for row in rows:
            if not _row_enabled(row, cfgvals):
                continue
            kind, spec = _row_kind(row)
            if kind == "advanced":
                walk(spec["rows"])   # pane rows behind the disclosure still bind keys
                continue
            if kind not in _SETTINGS_BINDING_KINDS or not isinstance(spec, dict):
                continue          # a list's own rows are all `field:` rows
            if "default" not in spec:
                continue
            key = spec.get("key")
            if not key or not key.startswith("s."):
                continue
            if key in seen:
                continue
            seen.add(key)
            dv = spec["default"]
            if isinstance(dv, bool):
                lit = "1" if dv else "0"
            elif isinstance(dv, dict):   # { kconfig:, default: } — board-sized value
                lit = str(_settings_scalar(dv, cfgvals, f"default of {key}"))
            elif isinstance(dv, int):
                lit = str(dv)
            else:
                lit = _cstr(str(dv))
            lines.append(f"    storageDefault({_cstr(key)}, {lit});")

    for c in contribs:
        walk(c.rows)
    return "\n".join(lines)


def write_init_dispatch(proj: Manifest, deps: list[Manifest]) -> None:
    """For a buildable, generate staging/spangap_init_dispatch.gen.cpp — the
    buildable's ENTIRE entry point: a generated app_main() plus the service
    registration it drives. The buildable ships no main.cpp. Every straddle's
    boot participation is a Service (spangap-core service.h): app_main constructs
    them all via spangapRegisterServices() — appending each to one ordered
    registry (serviceRegister) — then walks that registry twice:

      spangapRegisterServices()  — construct + register all, at the top of app_main.
      serviceRunStart()          — onStart walk (bare hardware), BEFORE spangapInit().
      serviceRunInit()           — onInit walk (ecosystem up), after spangapInit().

    Registration order is the one init_order() source of truth (platform band —
    core/net/web/lcd — then the dependency-topo straddle band), so boot order and
    `spangap show` can never drift. A service takes part in a phase purely by
    overriding that phase's virtual; the two walks filter the one registry by
    which virtual each object overrides.

    Each registration also names a service_band_t (SAFE_BAND above): core/net/web
    register SERVICE_BAND_SAFE, everything else SERVICE_BAND_FULL. A safe-mode
    boot runs the SAFE band only — see spangap-core service.h.

    TWO WAYS A STRADDLE CONTRIBUTES:
      services:  a Service subclass. The generator emits a per-straddle trampoline
        TU (spangap_services.gen.cpp, in the straddle's OWN component so its class
        header is on-path) that news the class and calls serviceRegister; here we
        forward-declare and call that trampoline symbol (spangapService_<Class>).
      start: / init:  legacy free-function hooks, wrapped here in generated adapter
        Services. The start/init subsequences still exactly match the old per-phase
        order (filtering onStart overriders reproduces the old spangapStartStraddles
        order; onInit overriders, the old spangapInitStraddles order). Within one
        straddle: start hooks, then init hooks, then services: entries.

    PHASES (straddle.yaml `start:` / `init:`):
      start: runs on BARE HARDWARE — before fs/storage/log/cli exist. It is for
        board bring-up the platform itself depends on: power a peripheral rail
        before spangap-core's fs_mount_sd() touches the SD bus, register the
        display/touch HAL before spangap-lcd's lcdInit(). A start hook must not
        use info()/storage/fs_*/ITS (nothing is up yet) — raw peripherals only.
        The platform band is empty here in practice (core/net/web have no
        hardware to power), so it's effectively the board, then its dependents.
      init:  runs after spangapInit(); the straddle band can assume the whole
        ecosystem (storage/cron, net, web, lcd) is already up.

    `when:` GATING. A hook with `when: <org>/<repo>` is emitted only if that
    straddle is in the staged set — resolved here, at generation time, so the
    output stays preprocessor-free (no #if). When the gating straddle is pruned
    the call is simply never written, the hook symbol is never referenced, and
    -ffunction-sections/--gc-sections drops it together with its references into
    the absent dep. This is the finer-grained twin of how a whole straddle's
    hooks already appear only when it is staged.

    We forward-declare each symbol and call it directly — referencing it is what
    keeps it off the linker's static-lib GC list. No per-straddle header
    #include in THIS TU: a straddle pulled in with `--with` isn't in the buildable's
    requires graph, so its include/ dir isn't on the main component's path — but its
    component lib IS on the link line, so a bare forward decl + call resolves
    regardless. (A services: class header IS needed to `new` the class — that is why
    its trampoline lives in the straddle's own component, not here.) Legacy hook
    decls carry default (C++) linkage to match the convention (global
    `void xStart()` / `void xInit()`, no extern "C"); spangapRegisterServices and
    app_main are extern "C" to match their spangap.h prototypes (an extern "C"
    function may freely call C++-linkage functions).

    Written for any straddle whose firmware half has a main/ to compile the
    generated app_main — empty registration body if nothing declares hooks or
    services, so app_main is always defined. Same main/-gated contract as
    write_main_requires.
    """
    if not (proj.firmware_dir / "main").is_dir():
        return

    # The buildable inits LAST — it depends on everything, so its own start:/
    # init: hooks (the board HAL etc.) fire after every dep. `deps` does NOT
    # include the buildable itself, so append it — same convention as the
    # sdkconfig-fragment precedence (init_order(deps) + [proj]).
    ordered = init_order(deps) + [proj]
    staged_names = {m.name for m in ordered}

    # ONE ordered registration plan, not two per-phase call lists. Legacy
    # start:/init: hooks are lowered into generated adapter Services (a struct
    # overriding onStart or onInit to call the bare hook symbol). We walk the
    # staged set in init_order and, WITHIN each straddle, emit its start hooks
    # then its init hooks. That single order is behavior-identical to the old
    # two dispatchers by construction: filtering the registry to the onStart
    # overriders reproduces the old spangapStartStraddles() order (start hooks
    # in init_order), and filtering to the onInit overriders reproduces the old
    # spangapInitStraddles() order (init hooks in init_order) — serviceRunStart
    # / serviceRunInit walk the whole registry and each adapter simply sits out
    # the phase it doesn't override. Dedup is per-phase, as before.
    #
    # Entries are ("hook", phase, call) for legacy start:/init: hooks and
    # ("service", class) for `services:` trampolines. WITHIN each straddle:
    # start hooks, then init hooks, then services — so a service's onInit fires
    # after that straddle's legacy init hooks (documented ordering), and the
    # start/init hook subsequences still exactly match the old per-phase order.
    #
    # Each entry also carries its straddle's bring-up band (service_band_t),
    # which serviceRunInit() filters on in a safe-mode boot. A symbol shared by
    # several straddles is deduped on first sight and keeps that straddle's
    # band — the same straddle whose position set its boot order.
    regs: list[tuple] = []
    seen = {"start": set(), "init": set()}  # type: dict[str, set[str]]
    seen_service: set[str] = set()
    for dep in ordered:
        band = service_band(dep.name)
        for phase_attr in ("start", "init"):
            for hook in getattr(dep, phase_attr):
                when = hook.get("when")
                if when is not None and when not in staged_names:
                    continue  # gating straddle pruned — drop the registration
                call = hook["call"]
                if call in seen[phase_attr]:
                    continue
                seen[phase_attr].add(call)
                regs.append(("hook", phase_attr, call, band))
        for svc in _active_services(dep, staged_names):
            cls = svc["class"]
            if cls in seen_service:
                continue
            seen_service.add(cls)
            regs.append(("service", cls, band))

    # Forward decls: one per distinct legacy hook symbol (void(void)), plus one
    # per distinct service trampoline symbol (spangapService_<Class>, defined in
    # the straddle's own component TU, taking the band to register in).
    decls: list[tuple[str, bool]] = []
    decl_seen: set[str] = set()
    for entry in regs:
        is_service = entry[0] == "service"
        sym = f"spangapService_{entry[1]}" if is_service else entry[2]
        if sym not in decl_seen:
            decl_seen.add(sym)
            decls.append((sym, is_service))
    externs = "".join(
        f"void {sym}({'service_band_t' if is_svc else 'void'});\n"
        for sym, is_svc in decls)

    # Adapter Services (anonymous namespace, for legacy hooks) + the registration
    # body. A hook adapter struct name carries the phase so a symbol reused
    # across phases can't collide; a service registers via its trampoline call.
    _PHASE_VIRTUAL = {"start": "onStart", "init": "onInit"}
    adapter_defs: list[str] = []
    reg_lines: list[str] = []
    for entry in regs:
        if entry[0] == "hook":
            _kind, phase, call, band = entry
            struct = f"Svc_{phase}_{call}"
            virt = _PHASE_VIRTUAL[phase]
            adapter_defs.append(
                f"struct {struct} final : Service {{ "
                f"void {virt}() override {{ {call}(); }} }};")
            reg_lines.append(f"    serviceRegister(new {struct}(), {band});")
        else:  # ("service", class, band)
            reg_lines.append(f"    spangapService_{entry[1]}({entry[2]});")
    adapters_block = (
        "namespace {  // adapters wrapping legacy start:/init: hooks as Services\n"
        + "\n".join(adapter_defs) + "\n"
        + "}  // namespace\n"
    ) if adapter_defs else ""
    register_fn = (
        'extern "C" void spangapRegisterServices(void) {\n'
        + "\n".join(reg_lines) + ("\n" if reg_lines else "")
        + "}\n"
    )

    # Declarative settings (straddle.yaml `settings:`). Two firmware halves:
    #   spangapSettingsGenDefaults() — storageDefault() seeding, ALWAYS emitted
    #     (web-only/headless builds seed defaults too); called after spangapInit()
    #     so the values exist before any straddle init reads them.
    #   spangapSettingsGenRegister() — the LCD tree (lcdSettingsContribute + the
    #     lcdSetting* calls and the collection/form/dialog descriptors), emitted
    #     with a body ONLY when spangap-lcd is staged (else an empty stub);
    #     called after the serviceRunInit() walk so the lcd task is up.
    contribs = collect_settings(proj, deps)
    cfgvals = collect_kconfig_values(proj, deps)
    node_meta = _settings_node_meta(contribs)
    lcd_staged = "spangap/spangap-lcd" in staged_names
    defaults_body = _settings_defaults_cpp(contribs, cfgvals)
    if lcd_staged:
        pane_defs, register_body = _settings_lcd_cpp(contribs, node_meta, cfgvals)
        lcd_include = '#include \"lcd.h\"\n'
    else:
        pane_defs, register_body = "", ""
        lcd_include = ""
    settings_block = (
        (pane_defs + "\n\n" if pane_defs else "")
        + 'extern \"C\" void spangapSettingsGenDefaults(void) {\n'
        + (defaults_body + "\n" if defaults_body else "")
        + "}\n\n"
        + 'extern \"C\" void spangapSettingsGenRegister(void) {\n'
        + (register_body + "\n" if register_body else "")
        + "}\n"
    )

    body = (
        "/* AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
        " * The buildable's ENTIRE entry point: a generated app_main() plus the\n"
        " * service registration it drives. The buildable ships NO main.cpp — this\n"
        " * IS its main.\n"
        " *\n"
        " * Every straddle's boot participation is a registered Service (service.h).\n"
        " * spangapRegisterServices() constructs and registers all of them — in\n"
        " * init_order (platform band core/net/web/lcd, then dependency-topo) — at\n"
        " * the very top of app_main, before ANY bring-up. Legacy start:/init:\n"
        " * hooks are wrapped here in generated adapter Services; `services:`\n"
        " * classes are constructed by per-straddle trampolines. Registration\n"
        " * order IS boot order; a service participates in a phase purely by\n"
        " * overriding its virtual. app_main then walks the registry:\n"
        " *   spangapRegisterServices()    — construct + register everything, in order.\n"
        " *   serviceRunStart()            — onStart walk (bare hardware), before spangapInit().\n"
        " *   spangapInit()                — platform core foundations.\n"
        " *   spangapSettingsGenDefaults() — declarative `settings:` storage defaults.\n"
        " *   serviceRunInit()             — onInit walk (ecosystem up); in a\n"
        " *     safe-mode boot only the SERVICE_BAND_SAFE registrations run.\n"
        " *   spangapSettingsGenRegister() — declarative `settings:` LCD panes (only\n"
        " *     when spangap-lcd is staged).\n"
        " *   spangapPostAppInit()         — finalise.\n"
        " * Adding a straddle that declares start:/init:/services: is enough to have\n"
        " * it run — no edit here. `when:`-gated entries appear only when their\n"
        " * straddle is staged. Hook forward decls use default (C++) linkage (no\n"
        " * extern \"C\"); spangap.h is included for Service + the platform prototypes. */\n"
        '#include \"spangap.h\"\n'
        f"{lcd_include}"
        "\n"
        f"{externs}"
        "\n"
        f"{adapters_block}"
        "\n"
        f"{settings_block}"
        "\n"
        f"{register_fn}"
        "\n"
        'extern \"C\" void app_main(void) {\n'
        "    spangapRegisterServices();\n"
        "    serviceRunStart();\n"
        "    spangapInit();\n"
        "    /* Safe mode runs the SAFE band only, so the declarative settings\n"
        "     * defaults and the LCD panes both describe straddles that never\n"
        "     * come up — and seeding defaults would write to a store that is\n"
        "     * about to be replaced or erased. */\n"
        "    const bool safeBoot = spangapSafeMode() != SAFE_MODE_NONE;\n"
        "    if (!safeBoot) spangapSettingsGenDefaults();\n"
        "    serviceRunInit();\n"
        "    if (!safeBoot) spangapSettingsGenRegister();\n"
        "    spangapPostAppInit();\n"
        "}\n"
    )
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    (staging_dir / "spangap_init_dispatch.gen.cpp").write_text(body)


def _browser_pkg_name(m: Manifest) -> str:
    """The npm package name of a straddle's browser half (its package.json
    "name") — the import specifier root and the file:-dep key. NOT necessarily
    the repo name (spangap-web's half is named "spangap-browser"), so read it."""
    try:
        name = json.loads((m.browser_dir / "package.json").read_text()).get("name")
    except (OSError, ValueError) as e:
        die(f"{m.name}: can't read browser/package.json ({e})")
    if not name:
        die(f"{m.name}: browser/package.json has no \"name\" — can't wire browser_register")
    return name


def stage_web_icons(proj: Manifest, deps: list[Manifest]) -> None:
    """Surface every staged straddle's launcher SVGs to the web build, parallel
    to how spangap_lcd_icons() collects them for the firmware. Each straddle's
    assets/lcd-icons/*.svg (at the straddle root or under its firmware half) is
    copied into the buildable's web src/app-icons/, where straddles.gen.ts
    import.meta.glob's them as raw strings INTO app.js — the device webroot ships
    only app.js/style.css/index.html (see web-interface/deploy.sh), so a separate
    public/ asset would never reach the device. The Dock renders them inline. One
    icon source of truth for both the LCD launcher tiles and the web dock.

    Buildable last so its icons win on a basename collision (same precedence as
    the init order / sdkconfig fragments). The dir is rebuilt each run, so a
    dropped straddle's icon disappears."""
    if not proj.has_browser:
        return
    out = proj.browser_dir / "src" / "app-icons"
    if out.exists():
        shutil.rmtree(out)
    out.mkdir(parents=True, exist_ok=True)
    # Drop a legacy public/app-icons from the earlier public-asset approach.
    legacy = proj.browser_dir / "public" / "app-icons"
    if legacy.exists():
        shutil.rmtree(legacy)
    for m in init_order(deps) + [proj]:
        for base in (m.dir, m.firmware_dir):
            d = base / "assets" / "lcd-icons"
            if not d.is_dir():
                continue
            for svg in sorted(d.glob("*.svg")):
                shutil.copyfile(svg, out / svg.name)


def write_browser_dispatch(proj: Manifest, deps: list[Manifest]) -> None:
    """The browser-half parallel to write_init_dispatch. For a buildable with a
    browser half, collect every staged straddle's browser_register: hooks (same
    init_order as the firmware dispatcher) and:

      1. generate <browser>/src/boot/straddles.gen.ts — a default-export
         registerStraddles() that imports each hook's symbol from its straddle's
         browser package and calls them in order; and
      2. ensure the buildable's <browser>/package.json declares a
         `file:../../<repo>/browser` dependency for each staged browser_register
         straddle (and drop any stale ones), so those imports resolve under
         node_modules.

    The buildable loads registerStraddles() ONCE from its hand-written
    boot/modules.ts — the browser analog of the firmware's generated boot
    registration. After that, staging a straddle that declares browser_register:
    is enough to surface its UI; no consumer edit. `when:` gating matches init:.

    Nothing is written for a buildable with no browser half (has_browser False).
    The empty-hook case still writes a no-op registerStraddles() so the
    buildable's boot import always resolves (same always-defined contract as the
    firmware dispatcher).
    """
    if not proj.has_browser:
        return

    ordered = init_order(deps) + [proj]
    staged_names = {m.name for m in ordered}

    # (pkg_name, module_subpath, call), in init order, deduped by call symbol.
    regs: list[tuple[str, str, str]] = []
    seen: set[str] = set()
    file_deps: dict[str, str] = {}  # pkg_name -> file:../../<repo>/browser
    for dep in ordered:
        hooks = dep.browser_register
        if not hooks:
            continue
        if not dep.has_browser:
            die(f"{dep.name}: declares browser_register: but has no browser/ half")
        pkg = _browser_pkg_name(dep)
        for hook in hooks:
            when = hook.get("when")
            if when is not None and when not in staged_names:
                continue  # gating straddle pruned — drop the registration
            call = hook["call"]
            if call in seen:
                continue
            seen.add(call)
            module = hook.get("module") or f"modules/{dep.repo}"
            regs.append((pkg, module, call))
            file_deps[pkg] = f"file:../../{dep.repo}/browser"

    imports = "".join(f"import {{ {call} }} from '{pkg}/{module}'\n"
                      for pkg, module, call in regs)
    body_calls = "".join(f"  {call}()\n" for _, _, call in regs)

    # Declarative settings (straddle.yaml `settings:`) web half: the node-tree
    # fragments, serialized as a JS array literal and merged at runtime into the
    # settings-tree store, which one renderer interprets. No separate asset, no
    # YAML parser in the SPA — it tree-shakes with the module. Registered LAST
    # so nodes other straddles' register* hooks named already exist.
    _contribs = collect_settings(proj, deps)
    nodes = _settings_web_nodes(_contribs, _settings_node_meta(_contribs),
                                collect_kconfig_values(proj, deps))
    gen_import = ""
    gen_decl = ""
    gen_call = ""
    if nodes:
        gen_import = "import { registerSettingsNodes } from 'spangap-browser/lib/settingsNodes'\n"
        gen_decl = ("\nconst SETTINGS_NODES = "
                    + json.dumps(nodes, indent=2) + "\n")
        gen_call = "  registerSettingsNodes(SETTINGS_NODES)\n"

    # Dock app icons: glob the staged src/app-icons/*.svg as raw strings so they
    # bundle INTO app.js (the only thing the device webroot ships) and register
    # them for the Dock to render inline. eager so they're plain strings, not
    # import promises.
    icon_import = "import { registerAppIcons } from 'spangap-browser/lib/apps'\n"
    icon_decl = ("\nconst APP_ICONS = import.meta.glob('../app-icons/*.svg', "
                 "{ query: '?raw', import: 'default', eager: true }) as Record<string, string>\n")

    body = (
        "/* AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
        " * Transitive browser registration — the browser-half parallel to the\n"
        " * firmware's generated boot registration. Every staged straddle that\n"
        " * declares browser_register: has its UI registered here, in init order. The\n"
        " * buildable loads this ONCE from boot/modules.ts:\n"
        " *   import registerStraddles from './straddles.gen'\n"
        " *   ... registerStraddles()\n"
        " * Staging a browser_register straddle is enough to surface its pane — no\n"
        " * edit here, no modules.ts edit. `when:`-gated hooks appear only when\n"
        " * their gating straddle is staged. SETTINGS_NODES holds the declarative\n"
        " * `settings:` tree fragments, merged into the settings-tree store and\n"
        " * rendered at runtime by NodePane.vue;\n"
        " * APP_ICONS are the launcher SVGs bundled for the bottom Dock. */\n"
        f"{imports}"
        f"{gen_import}"
        f"{icon_import}"
        f"{gen_decl}"
        f"{icon_decl}"
        "\n"
        "export default function registerStraddles(): void {\n"
        f"  registerAppIcons(APP_ICONS)\n"
        f"{body_calls}"
        f"{gen_call}"
        "}\n"
    )
    boot_dir = proj.browser_dir / "src" / "boot"
    boot_dir.mkdir(parents=True, exist_ok=True)
    (boot_dir / "straddles.gen.ts").write_text(body)

    stage_web_icons(proj, deps)

    # Inject/refresh the file: deps so the imports resolve. A spangap-managed
    # straddle dep is recognised by its self-referential value
    # (file:../../<key>/browser) — which never matches a hand-declared dep like
    # spangap-browser (key spangap-browser, value .../spangap-web/browser), so
    # those are left untouched. Idempotent: steady-state builds rewrite nothing.
    pkg_path = proj.browser_dir / "package.json"
    try:
        manifest = json.loads(pkg_path.read_text())
    except (OSError, ValueError) as e:
        die(f"{proj.name}: can't read {pkg_path} ({e})")
    deps_obj = manifest.setdefault("dependencies", {})
    managed = {k for k, v in deps_obj.items() if v == f"file:../../{k}/browser"}
    for k in managed - file_deps.keys():
        del deps_obj[k]          # straddle dropped from the build — drop its dep
    for k, v in file_deps.items():
        deps_obj[k] = v
    # Keep dependencies key-sorted for stable diffs (json.load preserves the
    # rest of the file's key order; only this block is normalised).
    manifest["dependencies"] = dict(sorted(deps_obj.items()))
    new_text = json.dumps(manifest, indent=2) + "\n"
    if new_text != pkg_path.read_text():
        pkg_path.write_text(new_text)


_KCONFIG_LINE_RE = re.compile(r"^(CONFIG_[A-Z0-9_]+=.+|# CONFIG_[A-Z0-9_]+ is not set)$")


def _kconfig_key(line: str) -> str:
    """The CONFIG_ symbol a validated kconfig: line sets (or un-sets)."""
    if line.startswith("# "):
        return line.split()[1]            # "# CONFIG_X is not set"
    return line.split("=", 1)[0]          # "CONFIG_X=..."


def _flatten_kconfig(items: list, staged: set[str] | None = None) -> list[str]:
    """Flatten a straddle's raw `kconfig:` list to plain sdkconfig lines.

    Each item is either a plain `CONFIG_x=y` string or a `when:`-gated group
    `{when: <org>/<repo>, set: [lines]}`. A group's lines are kept only when
    `staged` is None (the caller wants every candidate line — the flash-size
    scan) or its `when` straddle is in `staged`. This mirrors the `when:` gating
    hooks use, so a board can declare a peripheral's pins (LoRa/audio) whose
    CONFIG_* symbols only exist when the consuming straddle is staged, without
    them warning as unknown symbols in a build that omits it. Plain strings are
    unconditional.
    """
    out: list[str] = []
    for it in items:
        if isinstance(it, str):
            out.append(it)
        elif isinstance(it, dict):
            when = it.get("when")
            if staged is None or when is None or when in staged:
                out.extend(it.get("set", []))
    return out


def write_sdkconfig_fragments(proj: Manifest, deps: list[Manifest]) -> None:
    """Collect every staged straddle's `kconfig:` lines into one generated
    staging/sdkconfig.spangap-fragments — a plain sdkconfig.defaults fragment
    that bootstrap.cmake layers into SDKCONFIG_DEFAULTS (between the platform
    defaults and the buildable's own sdkconfig.defaults).

    This is the road by which a NON-buildable straddle hands Kconfig values to
    other straddles: a board straddle (hw-lilygo-tdeck) declares its pins in
    straddle.yaml `kconfig:`, and they reach iface-lora / the SD driver / the LCD
    here, via the shared global sdkconfig. The peripheral straddle still OWNS
    the option schema (its component Kconfig); the board only supplies values.

    Precedence — last wins, the same contract as the init order:
      1. straddles in init_order(deps): platform band (core/net/web/lcd) first,
         then the straddle band in dependency-topo order (a straddle's values
         override the values of the straddles it requires:);
      2. the buildable itself LAST, so the building straddle always wins among
         fragments — `reticulous` overriding a value `hw-lilygo-tdeck` set is the
         intended "if you're the building straddle you win".
    The buildable's own sdkconfig.defaults file (layered after this whole file
    by bootstrap.cmake) and the CLI overrides win over everything here, in that
    order.

    Each entry is emitted verbatim — what you write in `kconfig:` is exactly the
    sdkconfig line that lands — so the RHS (`=y`, ints, hex, quoted strings)
    survives untouched. Written deterministically (stable order, no timestamps)
    so its hash only moves when a fragment actually changes — bootstrap.cmake's
    SDKCONFIG_DEFAULTS staleness check then regenerates sdkconfig on a pin edit
    with no extra wiring. Always written (empty body if nobody declares
    kconfig:) so bootstrap can rely on its presence.

    Cross-straddle collisions (two different non-buildable straddles setting the
    same symbol — e.g. two boards both claiming a pin) are a silent-last-wins
    footgun, so they're warned about here. The buildable overriding a dep is
    intended and stays quiet.
    """
    sources = init_order(deps) + [proj]   # project last → wins among fragments
    staged_names = {s.name for s in sources}
    blocks: list[str] = []
    owner: dict[str, str] = {}            # CONFIG_ key -> straddle that last set it

    for m in sources:
        # Hand-written kconfig: lines plus the desugared identity values
        # (stub/display_name/banner/default_hostname → CONFIG_SPANGAP_FW_*).
        # Both ride the same dependency-order precedence, so the built straddle
        # wins its own identity and spangap-core, deepest, loses.
        lines = _flatten_kconfig(m.kconfig, staged_names) + m.identity_kconfig
        if not lines:
            continue
        clean: list[str] = []
        for raw in lines:
            line = raw.strip()
            if not _KCONFIG_LINE_RE.match(line):
                die(
                    f"{m.path}: kconfig: entry is not a valid sdkconfig line:\n"
                    f"         {raw!r}\n"
                    '       expected `CONFIG_NAME=value` or `# CONFIG_NAME is not set`.'
                )
            key = _kconfig_key(line)
            prev = owner.get(key)
            if prev is not None and prev != m.name and m.name != proj.name:
                warn(f"{key}: set by both {prev} and {m.name} — {m.name} wins "
                     "(later in init order)")
            owner[key] = m.name
            clean.append(line)
        blocks.append(f"# ── from {m.name} ──\n" + "\n".join(clean))

    text = (
        "# AUTO-GENERATED by spangap-inside — collected straddle `kconfig:` blocks.\n"
        "# Layered into SDKCONFIG_DEFAULTS by bootstrap.cmake; last block wins.\n"
        + ("\n".join(blocks) + "\n" if blocks else "")
    )
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    (staging_dir / "sdkconfig.spangap-fragments").write_text(text)


def signal_preamble(proj: Manifest, deps: list[Manifest], missing: list[str] = ()) -> None:
    n = len(deps)
    dep_summary = f"{n} dep" + ("s" if n != 1 else "")
    print(f"workspace: {WORKSPACE}", file=sys.stderr)
    print(f"project:   {proj.name} ({proj.version})", file=sys.stderr)
    if deps:
        print(f"requires:  {dep_summary} — {', '.join(d.name for d in deps)}", file=sys.stderr)
    if missing:
        print(f"missing:   {len(missing)} not yet cloned — {', '.join(missing)}", file=sys.stderr)
        print("           run `spangap get-deps` from this straddle to fetch them.", file=sys.stderr)


def stage_components(proj: Manifest, deps: list[Manifest], log_staged: bool = True) -> Path:
    """Stage each transitive dep into <fw>/staging/components/<repo>/, as a
    real dir of per-entry symlinks to the dep's firmware_dir contents plus
    generated build-system files. The per-entry layout (vs. one symlink to
    the whole dep) lets us drop generated files into the staged dir without
    polluting the source tree.

    Also writes the synthetic _spangap_present component and the buildable's
    main_requires.cmake. log_staged=False suppresses the per-dep `staged:`
    lines (quiet builds).
    """
    staging = proj.firmware_dir / "staging" / "components"
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(parents=True, exist_ok=True)

    staged_repos: set[str] = {d.repo for d in deps}
    # `services:` gating (and init:/start: when:) keys on <org>/<repo> names,
    # including the buildable itself — mirror write_init_dispatch's staged_names.
    staged_full: set[str] = {d.name for d in deps} | {proj.name}

    for dep in deps:
        src = dep.firmware_dir
        if not src.is_dir() or not (src / "CMakeLists.txt").exists():
            die(f"{dep.name}: firmware dir {src} has no CMakeLists.txt — can't stage")
        dst = staging / dep.repo
        dst.mkdir()
        for entry in sorted(src.iterdir()):
            (dst / entry.name).symlink_to(entry)
        cond_srcs, cond_incs = _conditional_sources(dep.firmware_dir, staged_repos)
        # `services:` trampoline for this dep, riding SPANGAP_CONDITIONAL_SRCS.
        svc_tu = _service_trampoline_tu(_active_services(dep, staged_full))
        if svc_tu:
            _require_conditional_srcs_wiring(dep.firmware_dir / "CMakeLists.txt", dep.name)
            (dst / _SERVICE_TU_NAME).write_text(svc_tu)
            cond_srcs = cond_srcs + [_SERVICE_TU_NAME]
        write_spangap_requires(dst, effective_requires(dep, staged_repos),
                               cond_srcs, cond_incs)
        if log_staged:
            print(f"  staged: {dep.repo} -> {src}", file=sys.stderr)

    # The buildable's OWN services: entries (rare — buildables are usually pure
    # aggregators) ride the main component. Written into staging/ and handed to
    # write_main_requires as an extra conditional src (main/ compiles it, and the
    # class header resolves on main's include path).
    proj_svc_extra: list[str] = []
    proj_svc_tu = _service_trampoline_tu(_active_services(proj, staged_full))
    if proj_svc_tu and (proj.firmware_dir / "main").is_dir():
        _require_conditional_srcs_wiring(
            proj.firmware_dir / "main" / "CMakeLists.txt", proj.name)
        (proj.firmware_dir / "staging").mkdir(parents=True, exist_ok=True)
        (proj.firmware_dir / "staging" / _SERVICE_TU_NAME).write_text(proj_svc_tu)
        proj_svc_extra = [f"../staging/{_SERVICE_TU_NAME}"]

    write_presence_component(staging, deps)
    write_main_requires(proj, staged_repos, proj_svc_extra)
    write_init_dispatch(proj, deps)
    write_browser_dispatch(proj, deps)
    write_sdkconfig_fragments(proj, deps)
    return staging


def run_idf(args: list[str], cwd: Path, env: dict[str, str] | None = None) -> int:
    cmd = ["idf.py", *args]
    print(f"+ {' '.join(cmd)}  (in {cwd})", file=sys.stderr)
    return subprocess.run(cmd, cwd=cwd, env={**os.environ, **(env or {})}).returncode


# ---------------------------------------------------------------------------
# `spangap build` output filtering. Quiet by default — IDF/Vite build output
# is mostly per-file compiler noise — with -v|--verbose restoring the full
# stream. This used to live host-side in a separate spangap-build-filter that
# spangap-outside piped the container's stdout through; it now lives here so
# the in-container build behaves identically however it's reached (`spangap
# build` from the host, `spangap docker spangap build`, or a shell inside the
# container) and there's a single copy of the filter rules. spangap-outside
# just forwards argv now.
# ---------------------------------------------------------------------------

# idf.py's "all done" banner. Both modes suppress it: idf.py's own multi-line
# flash hints are wrong here (the right command differs inside vs. outside the
# container), so we replace the banner with a bare completion line and drop
# whatever idf.py prints after it.
_FLASH_MARKER = "Project build complete. To flash, run:"
_TAIL = 3  # follow-up lines kept after each diagnostic in quiet mode

# Ninja progress lines like `[44/2091] Building C object ...`. Never kept in
# quiet mode, even when the path contains the literal "error"/"warning".
_PROGRESS_RE = re.compile(r"^\[\d+/\d+\]\s")

# What counts as a real diagnostic worth keeping in quiet mode. Each
# alternative anchors the keyword in a context filenames can't fake (a
# trailing colon, a line-leading meta-tool prefix, a marker glyph) so
# `error.c.obj` / `chunkSizeWarningLimit` don't sneak through. `^spangap:`
# keeps our own die()/status messages — without it a fast in-container die in
# quiet mode would surface as a silent rc=1.
_KEEP_RE = re.compile(
    r"""
    (?: \b (?: warning | error | fatal\s+error ) \b \s* :
      | ^ CMake \s+ (?: Warning | Error ) \b
      | ^ FAILED:
      | \b note:
      | \(!\) \s
      | ^ spangap:
      | \b Rollup \s+ failed \b
      | \b App \s+ build \s+ (?: failed | successful ) \b
      | \b Build \s+ failed \s+ in \b
      | ^ ninja: \s* build \s+ stopped \b
      | ^ ninja \s+ failed \b
    )
    """,
    re.IGNORECASE | re.VERBOSE,
)

# Noise we drop even though it reads like a diagnostic. The "smallest app
# partition is nearly full" warning is meaningless under shrink-wrap: the app
# partition is sized to the measured .bin plus a fixed margin, so it is ALWAYS
# ~a few percent free by construction — the warning would fire on every build.
_DROP_RE = re.compile(r"smallest app partition is nearly full", re.IGNORECASE)


def _git_identity(d: Path) -> dict[str, Any]:
    """Best-effort git identity for a straddle checkout. Never raises — a
    non-repo / git-less dir yields empty fields, reported as 'unknown'."""
    def g(*a: str) -> str:
        try:
            r = subprocess.run(
                ["git", "-C", str(d), *a],
                capture_output=True, text=True, check=False,
            )
            return r.stdout.strip() if r.returncode == 0 else ""
        except Exception:
            return ""
    return {
        "short":  g("rev-parse", "--short", "HEAD"),
        "date":   g("log", "-1", "--format=%cs"),        # committer date, YYYY-MM-DD
        "branch": g("rev-parse", "--abbrev-ref", "HEAD"),
        "dirty":  bool(g("status", "--porcelain")),
    }


def write_build_manifest(proj: Manifest, deps: list[Manifest], invocation: str) -> None:
    """Emit build/spangap-build-manifest.md — the per-build provenance record.

    There are no releases yet (every straddle is version 0.0.0), so the real
    identity of what shipped is the git commit of each staged straddle. This
    records that: buildable + every staged dep, alphabetical, with short hash,
    commit date, and a `(dirty)` marker when the worktree had uncommitted changes
    (so the hash never claims a reproducibility it doesn't have). Branch is
    shown only when it isn't `main` — pre-release everything tracks main, so it's
    noise except exactly when it isn't.

    Rendered as a flat bulleted list, NOT a markdown table: the on-device viewer
    has no table support, and four columns don't fit the 320px LCD anyway. Plain
    text + bold + inline code wrap gracefully at that width.

    spangap_create_factory_image() copies this into the device webroot as
    /BUILD.md, so the on-device viewer can show it. Best-effort + never fatal:
    a failure here must not fail the build."""
    try:
        staged: list[Manifest] = [proj, *deps]
        uniq: dict[str, Manifest] = {}
        for m in staged:
            uniq.setdefault(m.name, m)
        rows = sorted(uniq.values(), key=lambda m: m.name)

        out = ["# Build manifest", ""]
        out.append(f"- **Image:** {proj.name}")
        out.append(f"- **Built:** {time.strftime('%Y-%m-%d %H:%M:%S %Z')}")
        bs = _git_identity(Path(__file__).resolve().parent)
        out.append(
            "- **Build system:** "
            + (f"{bs['short']}{' (dirty)' if bs['dirty'] else ''}"
               if bs["short"] else "baked image")
        )
        # Invocation as plain text (no inline code): it can be long and inline
        # code doesn't wrap — it'd overflow the 320px LCD.
        out += ["", f"Built by: {invocation}",
                "", "## Straddles", ""]
        for m in rows:
            gi = _git_identity(m.dir)
            parts = [f"- **{m.name}**", f"`{gi['short'] or 'unknown'}`"]
            if gi["dirty"]:
                parts.append("*(dirty)*")
            if gi["branch"] and gi["branch"] != "main":
                parts.append(f"on {gi['branch']}")
            parts.append(f"— {gi['date'] or '—'}")
            out.append(" ".join(parts))
        out.append("")

        dst = proj.firmware_dir / "build" / "spangap-build-manifest.md"
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text("\n".join(out))
    except Exception as e:  # provenance is a nicety — never break a build over it
        print(f"spangap: could not write build manifest ({e})", file=sys.stderr)


def run_build_idf(args: list[str], cwd: Path, quiet: bool, env: dict[str, str] | None = None) -> int:
    """Run `idf.py <args>` for a build, streaming output through the filter.

    quiet=True keeps only real diagnostics (+ a few lines of trailing context,
    with `[...]` between non-adjacent blocks); quiet=False is pass-through.
    Both modes drop idf.py's flash banner entirely — the right invocation
    differs inside vs. outside the container (`idf.py flash` vs `spangap flash`),
    so rather than print a half-right one we print a bare completion line and let
    the user flash however they flash.
    """
    cmd = ["idf.py", *args]
    if not quiet:
        print(f"+ {' '.join(cmd)}  (in {cwd})", file=sys.stderr)
    proc = subprocess.Popen(
        cmd, cwd=cwd, env={**os.environ, **(env or {})},
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        text=True, bufsize=1,
    )
    assert proc.stdout is not None
    out = sys.stdout
    remaining = 0
    try:
        for raw in proc.stdout:
            line = raw.rstrip("\n")
            if _FLASH_MARKER in line:
                out.write("build: done.\n")
                out.flush()
                for _ in proc.stdout:  # drop idf.py's own flash instructions
                    pass
                break
            if not quiet:
                out.write(line + "\n"); out.flush(); continue
            if _PROGRESS_RE.match(line):
                continue
            if _DROP_RE.search(line):
                continue
            if _KEEP_RE.search(line):
                out.write(line + "\n"); out.flush(); remaining = _TAIL
            elif remaining > 0:
                out.write(line + "\n"); out.flush(); remaining -= 1
                if remaining == 0:
                    out.write("[...]\n"); out.flush()
    except BrokenPipeError:
        pass
    return proc.wait()


_NO_SHORTHANDS = {  # --no-<x> maps to --without <bare>
    "lcd": "spangap/spangap-lcd",
    "web": "spangap/spangap-web",
    "net": "spangap/spangap-net",
}

# Flash sizes the ESP-IDF `CONFIG_ESPTOOLPY_FLASHSIZE_*MB` choice supports.
_VALID_FLASH_MB = (4, 8, 16, 32, 64, 128)


def _resolve_org_repo(raw: str, all_straddles: dict[str, Manifest], flag: str) -> str:
    """--without/--with accept bare repo names or org/repo. Disambiguate."""
    if "/" in raw:
        return raw
    matches = [n for n in all_straddles if all_straddles[n].repo == raw]
    if not matches:
        die(f"{flag} {raw}: no workspace straddle with that repo name")
    if len(matches) > 1:
        die(f"{flag} {raw}: ambiguous ({', '.join(matches)}); use org/repo form")
    return matches[0]


_FLASH_LINE_RE = re.compile(
    r"^(# )?CONFIG_ESPTOOLPY_FLASHSIZE_\d+MB( is not set|=y)$|"
    r"^CONFIG_ESPTOOLPY_FLASHSIZE=\".+\"$"
)

# A line that actively *selects* a flash size (the `=y` choice form). Narrower
# than _FLASH_LINE_RE, which also matches the `is not set` / synthesized-string
# forms — here we only care whether something picks a size at all.
_FLASHSIZE_SET_RE = re.compile(r"^CONFIG_ESPTOOLPY_FLASHSIZE_\d+MB=y$")


def flash_size_configured(
    proj: Manifest, deps: list[Manifest], flash_mb: int | None
) -> bool:
    """True if any spangap-controlled source fixes the flash size.

    Without one, ESP-IDF silently falls back to its 2MB Kconfig default while
    spangap's partition generator falls back to 8MB (bootstrap.cmake) — the two
    disagree and the resulting image doesn't fit. We mirror the spangap layers
    bootstrap.cmake feeds into SDKCONFIG_DEFAULTS: the --flash-size override,
    each straddle's `kconfig:` lines, and the checked-in
    sdkconfig.defaults{,.spangap} files. (IDF's own 2MB default is deliberately
    NOT a source here — that's exactly the silent fallback we want to reject.)
    """
    if flash_mb is not None:
        return True
    staged = {m.name for m in deps} | {proj.name}
    for m in deps + [proj]:
        if any(_FLASHSIZE_SET_RE.match(ln.strip())
               for ln in _flatten_kconfig(m.kconfig, staged)):
            return True
    for m in deps + [proj]:
        for fname in ("sdkconfig.defaults", "sdkconfig.defaults.spangap"):
            f = m.firmware_dir / fname
            if f.exists() and any(
                _FLASHSIZE_SET_RE.match(ln.strip())
                for ln in f.read_text().splitlines()
            ):
                return True
    return False


def write_sdkconfig_overrides(
    proj: Manifest, flash_mb: int | None, extra_lines: list[str] | None = None
) -> None:
    """Drop staging/sdkconfig.spangap-overrides — picked up by bootstrap.cmake
    as the highest-priority SDKCONFIG_DEFAULTS entry (first build / regen path).
    Always written (even if empty body) so bootstrap can rely on its presence.

    `extra_lines` are the `--kconfig` lines, appended verbatim. Being
    SDKCONFIG_DEFAULTS they seed a fresh build / regen, but bootstrap.cmake
    hashes this file along with the other defaults and reseeds sdkconfig when
    the hash moves — so a changed `--kconfig` set takes effect on the next build
    with no clean, which is what lets one catalogue run build several flavours
    from the same tree. Per-straddle board values flow through the separate
    sdkconfig.spangap-fragments file (see write_sdkconfig_fragments), not here.

    Also edits an existing sdkconfig in-place when --flash-size is given. IDF's
    SDKCONFIG_DEFAULTS only seeds on first build; once sdkconfig exists,
    defaults can't override it. So for the steady-state case we rewrite the
    FLASHSIZE lines directly. The next idf.py reconfigure picks the new value
    up, the partition generator reads the same value from sdkconfig, and the
    layout snaps to match.
    """
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    body: list[str] = []
    if flash_mb is not None:
        body.append(f"CONFIG_ESPTOOLPY_FLASHSIZE_{flash_mb}MB=y")
    body.extend(extra_lines or [])
    text = (
        "# AUTO-GENERATED by spangap-inside. Reflects this build's CLI overrides.\n"
        "# Highest-priority SDKCONFIG_DEFAULTS entry — bootstrap.cmake picks it up\n"
        "# on first build / regen.\n"
        + ("\n".join(body) + "\n" if body else "")
    )
    (staging_dir / "sdkconfig.spangap-overrides").write_text(text)

    if flash_mb is None:
        return
    sdkconfig = proj.firmware_dir / "sdkconfig"
    if not sdkconfig.exists():
        return  # first build — SDKCONFIG_DEFAULTS path handles it
    target = f"CONFIG_ESPTOOLPY_FLASHSIZE_{flash_mb}MB=y"
    existing = sdkconfig.read_text()
    if target in existing.splitlines():
        return  # already correct
    # Strip all FLASHSIZE_* lines (set, not-set, and the synthesized
    # FLASHSIZE="<N>MB" string) and append the new value. IDF will canonicalize
    # the rest of the surrounding lines on its next reconfigure.
    kept = [ln for ln in existing.splitlines() if not _FLASH_LINE_RE.match(ln)]
    kept.append(target)
    sdkconfig.write_text("\n".join(kept) + "\n")


def cmd_menuconfig(args: argparse.Namespace) -> int:
    """Stage the buildable's components, then run idf.py menuconfig on it
    interactively. With --save, persist the result into the straddle's
    sdkconfig.defaults via idf.py save-defconfig (the 'save as hw-whatever'
    step).

    Drops the .spangap-manual-kconfig marker so later builds won't reseed
    sdkconfig from changed sdkconfig.defaults and clobber what you just tuned by
    hand (see bootstrap.cmake). `spangap autoconfig` clears it."""
    proj = find_project()
    if not proj.has_firmware:
        die(f"{proj.name}: firmware dir {proj.firmware_dir} has no CMakeLists.txt")

    all_straddles = scan_workspace_straddles()
    dropped: set[str] = set()
    deps, _ = resolve_requires(
        proj, all_straddles, excluded=set(), included=set(), dropped_out=dropped,
    )
    stage_components(proj, deps, log_staged=False)
    write_sdkconfig_overrides(proj, None)

    rc = run_idf(["menuconfig"], cwd=proj.firmware_dir)
    if rc != 0:
        return rc
    # menuconfig exited cleanly — from here on sdkconfig is hand-managed.
    MANUAL_KCONFIG_FILE.touch()
    print(f"spangap: manual kconfig mode ON (created {MANUAL_KCONFIG_FILE.name}) — "
          "sdkconfig.defaults changes won't reseed sdkconfig until `spangap autoconfig`.",
          file=sys.stderr)
    if not args.save:
        return rc
    print("spangap: writing minimal sdkconfig.defaults (idf.py save-defconfig)",
          file=sys.stderr)
    return run_idf(["save-defconfig"], cwd=proj.firmware_dir)


def cmd_autoconfig(args: argparse.Namespace) -> int:
    """Leave manual-kconfig mode: remove the .spangap-manual-kconfig marker and
    delete the project's sdkconfig so the next build reseeds it from the current
    (layered) sdkconfig.defaults. The inverse of `spangap menuconfig`."""
    had_marker = MANUAL_KCONFIG_FILE.exists()
    MANUAL_KCONFIG_FILE.unlink(missing_ok=True)

    proj = find_project()
    if not proj.has_firmware:
        die(f"{proj.name}: firmware dir {proj.firmware_dir} has no CMakeLists.txt")
    sdkconfig = proj.firmware_dir / "sdkconfig"
    removed_sdkconfig = sdkconfig.exists()
    if removed_sdkconfig:
        sdkconfig.unlink()

    if not had_marker:
        print("spangap: manual kconfig mode was already off.", file=sys.stderr)
    else:
        print(f"spangap: manual kconfig mode OFF (removed {MANUAL_KCONFIG_FILE.name}).",
              file=sys.stderr)
    if removed_sdkconfig:
        print(f"spangap: removed {proj.name} sdkconfig — next build reseeds it "
              "from sdkconfig.defaults.", file=sys.stderr)
    return 0


def align_up(x: int, a: int) -> int:
    return ((x + a - 1) // a) * a


def _fixed_size_in(partitions_csv: Path) -> int:
    """The `fixed` partition size (bytes) in a partitions.csv, or -1 if absent.

    Used to decide whether the just-built littlefs already sits at its shrink-wrapped
    size — comparing against this build's own table, so no cross-run state is kept.
    """
    try:
        for line in partitions_csv.read_text().splitlines():
            c = [x.strip() for x in line.split(",")]
            if len(c) >= 5 and c[0] == "fixed":
                return int(c[4], 0)
    except (OSError, ValueError):
        pass
    return -1


def finalize_shrink_wrap(proj: "Manifest", build_dir: Path,
                         app_b: int, fixed_b: int) -> int:
    """Shrink-wrap `fixed` to its measured size WITHOUT a second full build.

    `app` is the remainder below `fixed`, so its size falls out of `fixed`'s — the
    only thing a resize moves is `fixed` (up, as it shrinks) and `app` (bigger). We
    regenerate exactly the artifacts a `fixed` resize touches, in place, instead of
    editing partitions.csv the slow way (a ~30 s CMake reconfigure + rebuild):

        1. partitions.csv           — gen-partitions.py at the measured `fixed` size
                                      (`app_b` is passed only to ASSERT the firmware
                                      ceiling — app.bin must fit the remainder — it
                                      never sizes a partition)
        2. partition-table.bin      — IDF's gen_esp32part.py
        3. flasher_args.json        — the `fixed` flash offset (app/bootloader
                                      keep their offsets, so nothing else moves)

    `fixed.bin` is NOT re-packed: a spanfs image is byte-exact and placement-
    independent, so the image built during the (generously-sized) main build IS
    the final image — it is reused verbatim, exactly like app.bin/bootloader.bin.
    (This is the LittleFS re-pack step the old flow needed and spanfs removes.)

    Returns 0 on success; nonzero lets the caller fall back to a full rebuild.
    """
    fw = proj.firmware_dir
    partitions = fw / "partitions.csv"
    sdk = fw / "sdkconfig"
    sdk_text = sdk.read_text() if sdk.exists() else ""

    def cfg(key: str, default: str = "") -> str:
        m = re.search(rf"^{re.escape(key)}=(.*)$", sdk_text, re.M)
        return m.group(1).strip().strip('"') if m else default

    # Mirror bootstrap.cmake's gen-partitions inputs.
    fs = cfg("CONFIG_ESPTOOLPY_FLASHSIZE", "4MB")            # e.g. "8MB"
    container_mb = int(re.sub(r"[^0-9]", "", fs) or "4")
    max_fw_kb = int(cfg("CONFIG_SPANGAP_MAX_FIRMWARE_KB", "0") or "0")
    state_floor = max_fw_kb * 1024 if max_fw_kb > 0 else container_mb * 1024 * 1024
    updater = "y" if (fw / "staging/components/updater").exists() else "n"

    gen_parts = fw / "staging/components/spangap-core/scripts/gen-partitions.py"
    if not gen_parts.exists():
        return 1

    # The packed spanfs image must fit the shrink-wrapped partition. It always
    # does (gen-partitions rounds fixed_b up to the 4 K alignment), but guard
    # against a stale/missing fixed.bin so we never patch an offset for an image
    # that isn't there.
    fixed_bin = build_dir / "fixed.bin"
    if not fixed_bin.exists():
        return 1

    def run(argv: list[str]) -> int:
        return subprocess.run(argv, cwd=build_dir).returncode

    # 1. partitions.csv at the measured sizes.
    if run([sys.executable, str(gen_parts),
            "--flash-mb", str(container_mb), "--updater", updater,
            "--app-bytes", str(app_b), "--fixed-bytes", str(fixed_b),
            "--state-floor", str(state_floor), "--out", str(partitions)]):
        return 1

    # The `fixed` partition's freshly-computed offset + size.
    fixed_off = fixed_size = None
    for line in partitions.read_text().splitlines():
        c = [x.strip() for x in line.split(",")]
        if len(c) >= 5 and c[0] == "fixed":
            fixed_off, fixed_size = int(c[3], 0), int(c[4], 0)
    if fixed_off is None or fixed_size is None:
        return 1
    if fixed_bin.stat().st_size > fixed_size:
        return 1                                    # image outgrew its partition

    # 2. partition-table.bin — IDF's own generator, same flags as the build.
    idf = Path(os.environ["IDF_PATH"])
    idf_py = Path(os.environ.get("IDF_PYTHON_ENV_PATH", "")) / "bin" / "python"
    ptbin = build_dir / "partition_table" / "partition-table.bin"
    if run([str(idf_py), str(idf / "components/partition_table/gen_esp32part.py"),
            "-q", "--offset", "0x8000", "--primary-bootloader-offset", "0x0",
            "--flash-size", fs, "--", str(partitions), str(ptbin)]):
        return 1

    # 3. Patch the `fixed` offset in flasher_args.json (unique, so a quoted
    #    string replace preserves IDF's formatting and touches nothing else).
    fa = build_dir / "flasher_args.json"
    try:
        d = json.loads(fa.read_text())
        old_off = d["fixed"]["offset"]
        new_off = "0x%x" % fixed_off
        if old_off != new_off:
            fa.write_text(fa.read_text().replace(f'"{old_off}"', f'"{new_off}"'))
    except (OSError, ValueError, KeyError):
        return 1
    return 0


def measure_build_sizes(build_dir: Path) -> tuple[int, int]:
    """(app_bytes, fixed_bytes) from a completed build.

    `fixed_bytes` sizes the `fixed` partition; `app_bytes` is only asserted
    against the app remainder (app never gets a measured size).

    `fixed` is a spanfs image now: byte-exact and placement-independent, so its
    size is simply the packed `fixed.bin` on disk — no LittleFS block rounding,
    no per-directory metadata pairs, no cushion. gen-partitions rounds it up to
    the 4 K data alignment for the partition. `app_bytes` keeps a +128 K
    headroom so the ceiling assertion leaves the app slot with slack.
    0 = couldn't measure (skip shrink).
    """
    app_bytes = 0
    pd = build_dir / "project_description.json"
    if pd.exists():
        try:
            app_bin = json.loads(pd.read_text()).get("app_bin", "")
            p = build_dir / app_bin if app_bin else None
            if p and p.exists():
                app_bytes = p.stat().st_size + 0x20000      # +128 K headroom
        except (ValueError, OSError):
            pass
    fixed_bytes = 0
    fixed_bin = build_dir / "fixed.bin"
    if fixed_bin.exists():
        try:
            fixed_bytes = fixed_bin.stat().st_size          # byte-exact spanfs image
        except OSError:
            pass
    return app_bytes, fixed_bytes


def print_partition_layout(csv_path: Path) -> None:
    """Human-readable flash breakdown from the generated partitions.csv.

    `state` (the read-write user store) is not in the table — it is created at
    runtime and fills the flash ABOVE the floor, so its size is the real chip
    size minus the floor. The chip size is discovered at boot (SFDP), so we can
    name a concrete /state size only when the builder has pinned the flash size
    (CONFIG_ESPTOOLPY_FLASHSIZE) larger than the floor needs — otherwise it is
    'all further space in flash'.
    """
    if not csv_path.exists():
        return
    sizes: dict[str, int] = {}
    floor = 0
    for raw in csv_path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        cols = [c.strip() for c in line.split(",")]
        if len(cols) < 5:
            continue
        try:
            off, sz = int(cols[3], 0), int(cols[4], 0)
        except ValueError:
            continue
        sizes[cols[0]] = sizes.get(cols[0], 0) + sz
        floor = max(floor, off + sz)          # table top = the state floor
    if not sizes:
        return

    def human(n: int) -> str:
        return f"{n/1024:.0f}K" if n < 1024 * 1024 else f"{n/1024/1024:.2f}M"

    # Concrete /state only if the container is pinned larger than a bare floor
    # image needs — i.e. the builder declared the real chip size.
    m = re.search(r'^CONFIG_ESPTOOLPY_FLASHSIZE="(\d+)MB"',
                  (csv_path.parent / "sdkconfig").read_text(), re.M) \
        if (csv_path.parent / "sdkconfig").exists() else None
    container = int(m.group(1)) * 1024 * 1024 if m else 0
    minimal = next((mb * 1024 * 1024 for mb in _VALID_FLASH_MB
                    if mb * 1024 * 1024 >= floor), 0)
    pinned = container > minimal > 0

    # `app` is the remainder below `fixed`, so its partition is deliberately large
    # and mostly free — report the real firmware size + its headroom, not the slot.
    app_used = 0
    pd = csv_path.parent / "build" / "project_description.json"
    if pd.exists():
        try:
            ab = json.loads(pd.read_text()).get("app_bin", "")
            p = csv_path.parent / "build" / ab if ab else None
            if p and p.exists():
                app_used = p.stat().st_size
        except (ValueError, OSError):
            pass
    app_slot = sizes.get("app", 0)
    if app_used:
        head = app_slot - app_used
        print(f"  {'compiled code':<22}{human(app_used):>8}  "
              f"(+{human(max(head, 0))} free in app slot)")
    else:
        print(f"  {'compiled code':<22}{human(app_slot):>8}")
    print(f"  {'compressed files':<22}{human(sizes.get('fixed', 0)):>8}")
    if sizes.get("reserved", 0):
        print(f"  {'reserved for growth':<22}{human(sizes['reserved']):>8}")
    state = f"{human(container - floor):>8}" if pinned else \
        "  <all further space in flash>"
    print(f"  {'user state':<22}{state}")


# The SPI-flash flags, in the one spelling every esptool takes. esptool 4 knows
# only `--flash_mode`; esptool 5 renamed it to `--flash-mode` and takes the
# underscore form solely as a deprecated alias, warning on every use and dropping
# it at the next major. The two-letter forms have meant the same thing since
# esptool 2 and are deprecated nowhere, so the argfile is written in those and
# needs no guess about which esptool reads it.
ESPTOOL_SHORT_FLAGS = {"flash_mode": "-fm", "flash_freq": "-ff", "flash_size": "-fs"}


def portable_flash_flags(write_flash_args: list[str]) -> list[str]:
    """IDF's write_flash_args, rewritten to the flag spelling every esptool
    version accepts. Anything not in ESPTOOL_SHORT_FLAGS passes through
    untouched: this knows about the three flags whose names moved, not about
    every flag IDF might emit."""
    out: list[str] = []
    i = 0
    while i < len(write_flash_args):
        tok = write_flash_args[i]
        short = ESPTOOL_SHORT_FLAGS.get(tok.lstrip("-").replace("-", "_")) \
            if tok.startswith("-") else None
        if short:
            # A project that pins none of the three leaves IDF emitting the flag
            # with an empty value; written out that way the flag would eat the
            # next token. Dropped instead — esptool then defaults to `keep` and
            # takes all three from the bootloader header, which is what the
            # empty value meant.
            value = write_flash_args[i + 1] if i + 1 < len(write_flash_args) else ""
            if value:
                out += [short, value]
            i += 2
        else:
            out.append(tok)
            i += 1
    return out


def esptool_argfile(write_flash_args: list[str], flash_files: dict[str, str]) -> str:
    """An esptool argfile for `write_flash`: the flags on the first line, then one
    `<offset> <file>` pair per image, lowest offset first.

    ESP-IDF writes one of these itself as build/flash_project_args, but the
    in-place finalize (see finalize_shrink_wrap) patches the `fixed` offset into
    flasher_args.json alone, so IDF's copy can name an offset the images no
    longer live at. Generated from flasher_args.json instead — one source, and
    always the offsets the zip actually ships.

    Carries no comments: esptool expands an argfile with shlex.split() per line
    and does not treat `#` as one, so a comment would reach it as arguments.
    """
    flags = portable_flash_flags(write_flash_args)
    lines = [" ".join(flags)] if flags else []
    lines += [f"{off} {fname}" for off, fname
              in sorted(flash_files.items(), key=lambda kv: int(kv[0], 16))]
    return "\n".join(lines) + "\n"


def project_name(build_dir: Path, args: dict) -> str:
    """The IDF project name, which names the argfile inside flasher.zip. The app
    image is <project_name>.bin, so its stem answers this too when the build
    description can't be read."""
    try:
        return json.loads((build_dir / "project_description.json").read_text())["project_name"]
    except (OSError, json.JSONDecodeError, KeyError):
        return Path((args.get("app") or {}).get("file", "firmware")).stem


def write_flasher_zip(build_dir: Path) -> None:
    """Bundle everything needed to flash a board into build/flasher.zip.

    Contents: <project_name>.esptool (the offset→image map and the write_flash
    flags, as an esptool argfile) and every image it names, each stored at its
    build-relative path (e.g. bootloader/bootloader.bin,
    partition_table/partition-table.bin, the app .bin, ota_data_initial.bin).
    Any flasher — host esptool or the web flasher — has all it needs from
    these: read the argfile for the layout, flash the bins at their offsets.
    Best-effort: a build with no flashable images (flash_files empty) writes no
    zip.
    """
    args_json = build_dir / "flasher_args.json"
    try:
        d = json.loads(args_json.read_text())
    except (OSError, json.JSONDecodeError):
        return
    flash_files = d.get("flash_files") or {}
    if not flash_files:
        return
    zip_path = build_dir / "flasher.zip"
    missing = []
    present = {}
    for offset, fname in flash_files.items():
        if (build_dir / fname).exists():
            present[offset] = fname
        else:
            missing.append(fname)
    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
        # Only the images that made it into the zip go in the argfile: a flasher
        # working from it must never be sent looking for a file that isn't there.
        z.writestr(f"{project_name(build_dir, d)}.esptool",
                   esptool_argfile(d.get("write_flash_args") or [], present))
        for offset, fname in present.items():
            z.write(build_dir / fname, fname)
    if missing:
        print(f"spangap: flasher.zip: skipped missing image(s): {', '.join(missing)}",
              file=sys.stderr)
    print(f"spangap: wrote {zip_path.name} ({len(present)} images)",
          file=sys.stderr)


def _git(repo: Path, *args: str, timeout: int | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo), *args],
        capture_output=True, text=True, timeout=timeout,
        env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
    )


def _objstore_broken(repo: Path) -> bool:
    """True if a repo has a committed HEAD whose objects can't be read — the
    virtiofs keep_cache truncated-pack signature (see INTERNALS.md → macOS Docker
    Desktop gotchas). Healthy repos resolve HEAD's tree in one call (the common
    path); a repo with no commits has no HEAD and is not our case."""
    if _git(repo, "rev-parse", "-q", "--verify", "HEAD^{tree}").returncode == 0:
        return False
    # HEAD tree didn't resolve: a truncated pack, OR a repo with no committed HEAD.
    return _git(repo, "rev-parse", "-q", "--verify", "HEAD").returncode == 0


def _heal_repo(repo: Path) -> bool:
    """Re-materialise a repo's object store from origin so it reads in-container.

    The truncated pack is complete on the host but the container's keep_cache view
    is frozen short; a pack the CONTAINER fetches is cached coherently. Move the
    bad pack(s) aside, fetch a fresh one, and — if that didn't fix it — restore
    the original bytes exactly (never leaves a repo worse than we found it). The
    working tree is never touched; only .git/objects/pack/."""
    if _git(repo, "remote", "get-url", "origin").returncode != 0:
        return False  # nothing to refetch from
    packdir = repo / ".git" / "objects" / "pack"
    stash = repo / ".git" / "spangap-broken-packs"
    shutil.rmtree(stash, ignore_errors=True)
    stash.mkdir(parents=True, exist_ok=True)
    for f in [p for p in packdir.iterdir() if p.is_file()]:
        f.rename(stash / f.name)     # pack/ now empty → fetch does a full download
    try:
        _git(repo, "fetch", "origin", timeout=300)
    except subprocess.TimeoutExpired:
        pass
    if not _objstore_broken(repo):
        shutil.rmtree(stash, ignore_errors=True)
        return True
    # Fetch didn't help — undo: drop anything it wrote, restore the originals.
    for f in [p for p in packdir.iterdir() if p.is_file()]:
        f.unlink()
    for f in list(stash.iterdir()):
        f.rename(packdir / f.name)
    shutil.rmtree(stash, ignore_errors=True)
    return False


def heal_truncated_packs(verbose: bool = False) -> None:
    """Detect and repair workspace repos whose git object store is unreadable in
    the container because virtiofs keep_cache froze a mid-clone truncated packfile
    (see INTERNALS.md → macOS Docker Desktop gotchas). Cheap when nothing is
    broken — one `git rev-parse` per repo, no network — so it runs at every build;
    only a genuinely-broken repo triggers a refetch from origin."""
    if not WORKSPACE.is_dir():
        return
    healed, failed = [], []
    for child in sorted(WORKSPACE.iterdir()):
        if not (child / ".git").exists() or not _objstore_broken(child):
            continue
        print(f"spangap: {child.name}: git objects unreadable (virtiofs truncated "
              "pack) — refetching from origin…", file=sys.stderr)
        (healed if _heal_repo(child) else failed).append(child.name)
    if healed:
        print(f"spangap: healed {len(healed)} repo(s): {', '.join(healed)}", file=sys.stderr)
    if failed:
        print(f"spangap: could NOT heal {', '.join(failed)} (no origin or offline) — "
              "commit these from the host", file=sys.stderr)
    if verbose and not healed and not failed:
        print("spangap: all workspace git repos readable — nothing to heal", file=sys.stderr)


def cmd_heal(args: argparse.Namespace) -> int:
    heal_truncated_packs(verbose=True)
    return 0


def cmd_build(args: argparse.Namespace) -> int:
    heal_truncated_packs()   # repair any virtiofs-truncated packs before we build
    all_straddles = scan_workspace_straddles()

    # Optional leading positional target: `spangap build <straddle> [idf args…]`.
    # If the first non-flag token names a known straddle (by <org>/<repo> or repo
    # dir), build THAT straddle regardless of cwd —
    # otherwise leave every token for idf.py (passthrough for `menuconfig`,
    # build targets, -D…). The target frees you from cd-ing into the straddle.
    idf_args = list(args.idf_args or [])
    target: Manifest | None = None
    if idf_args and not idf_args[0].startswith("-"):
        target = resolve_target_straddle(idf_args[0], all_straddles)
        if target is not None:
            idf_args.pop(0)

    # Where the build target comes from decides whether we *remember* it:
    #   explicit   — a leading positional target token
    #   cwd        — a straddle.yaml at/above cwd
    #   remembered — the .spangap-build default (only at the workspace root)
    if target is not None:
        proj = target
        source = "explicit"
    else:
        proj = find_project()
        source = "cwd" if straddle_at_or_above(Path.cwd()) else "remembered"
    if not proj.has_firmware:
        die(f"{proj.name}: firmware dir {proj.firmware_dir} has no CMakeLists.txt")

    # --without (with --no-X shorthands) → drop from staged set.
    excluded: set[str] = set()
    for raw in (args.exclude or []):
        excluded.add(_resolve_org_repo(raw, all_straddles, "--without"))
    for short, full in _NO_SHORTHANDS.items():
        if getattr(args, f"no_{short}", False):
            excluded.add(full)

    # --with → pull additional straddles into the build. Slash-form is
    # trusted (the host dispatcher pre-clones missing ones); bare-form must
    # resolve to a workspace straddle.
    included: set[str] = set()
    for raw in (args.include or []):
        included.add(_resolve_org_repo(raw, all_straddles, "--with"))

    flash_mb = args.flash_size

    # --kconfig lines ride into staging/sdkconfig.spangap-overrides, the
    # highest-priority SDKCONFIG_DEFAULTS entry. They express what a build
    # *flavour* selects (SUPE in or out, a console transport) without a straddle
    # per combination; a board's own hardware values stay in its `kconfig:`.
    kconfig: list[str] = list(args.kconfig or [])
    for line in kconfig:
        if not _KCONFIG_LINE_RE.match(line):
            die(f"--kconfig {line!r}: expected `CONFIG_NAME=value` or "
                f"`# CONFIG_NAME is not set`")

    # Remember target + selection in .spangap-build, EXCEPT on a pure replay —
    # a bare `build` (or passthrough like `build menuconfig`) at the workspace
    # root, where the target itself came from .spangap-build and the invocation
    # added no selection of its own. There we instead *reload* the remembered
    # selection so the repeat matches the last explicit build, and leave the
    # file untouched (so transient/passthrough runs never clobber it). Any
    # explicit selection on this run replaces the remembered one wholesale.
    has_selection = bool(
        args.include or args.exclude or flash_mb is not None or kconfig
        or any(getattr(args, f"no_{s}", False) for s in _NO_SHORTHANDS)
    )
    persist = not (source == "remembered" and not has_selection)
    if not persist:
        rb = remembered_build()
        if rb is not None:
            r_inc, r_exc, r_flash, r_kconfig = parse_selection(rb[1])
            included |= r_inc
            excluded |= r_exc
            if flash_mb is None:
                flash_mb = r_flash
            kconfig = r_kconfig

    # --flash-size validation.
    if flash_mb is not None and flash_mb not in _VALID_FLASH_MB:
        die(f"--flash-size {flash_mb}: choose one of {_VALID_FLASH_MB}")

    dropped: set[str] = set()
    deps, _ = resolve_requires(
        proj, all_straddles, excluded=excluded, included=included,
        dropped_out=dropped,
    )

    # Flash size must be set explicitly — IDF's silent 2MB default would mismatch
    # the spangap-generated partition table (8MB fallback). Force the user to pick.
    if not flash_size_configured(proj, deps, flash_mb):
        die(
            "flash size not configured. ESP-IDF would silently fall back to "
            "2MB, which won't match the generated partition table.\n"
            f"       Pass `--flash-size <MB>` (one of "
            f"{', '.join(str(n) for n in _VALID_FLASH_MB)}), or set "
            "CONFIG_ESPTOOLPY_FLASHSIZE_<MB>MB=y\n"
            "       in a board straddle's `kconfig:` (the right home for a "
            "hardware property)."
        )

    quiet = not args.verbose
    if not quiet:
        signal_preamble(proj, deps)
        if excluded:
            print(f"excluded:  {', '.join(sorted(excluded))}", file=sys.stderr)
            cascaded = dropped - excluded
            if cascaded:
                print(f"cascade-dropped: {', '.join(sorted(cascaded))}", file=sys.stderr)
        if included:
            print(f"included:  {', '.join(sorted(included))}", file=sys.stderr)
        if flash_mb is not None:
            print(f"flash:     {flash_mb} MB (--flash-size override)", file=sys.stderr)
    stage_components(proj, deps, log_staged=not quiet)
    write_sdkconfig_overrides(proj, flash_mb, kconfig)
    lint_cmakelists(proj, deps, all_straddles)
    if persist:
        write_remembered_build(proj, included, excluded, flash_mb, kconfig)
    # Bake the build invocation identity into the image: spangap-core's
    # write-build-info.py (run by CMake during this build) reads these and
    # emits app_build_{straddle,version,args}, which spangapInit() logs on boot.
    build_env = {
        "SPANGAP_BUILD_STRADDLE": proj.name,
        "SPANGAP_BUILD_VERSION": proj.version,
        "SPANGAP_BUILD_ARGS": getattr(args, "spangap_invocation", "") or "spangap build",
        # A catalogue build stamp, when a caller (`spangap make-builds`) set it
        # in the environment; empty otherwise. Passed through so the image logs the
        # exact stamp it's published under.
        "SPANGAP_BUILD_DATETIME": os.environ.get("SPANGAP_BUILD_DATETIME", ""),
        # The catalogue entry's name, from the same caller. It is what identifies
        # *which* distribution an image is once a board has several; the datetime
        # only answers whether something newer exists.
        "SPANGAP_BUILD_DIST": os.environ.get("SPANGAP_BUILD_DIST", ""),
        # Which catalogue published it (`stable`, `dev`, …) — the channel, one
        # level above the entry. Stamps from two catalogues are unrelated series,
        # so a flasher has to know this before comparing them at all.
        "SPANGAP_BUILD_CATALOGUE": os.environ.get("SPANGAP_BUILD_CATALOGUE", ""),
    }
    # Provenance manifest → device webroot as /BUILD.md. Written before the IDF
    # run so it's on disk when project_include.cmake's configure step picks it up
    # (spangap_create_factory_image guards on its existence).
    write_build_manifest(proj, deps, build_env["SPANGAP_BUILD_ARGS"])
    rc = run_build_idf(
        idf_args or ["build"], cwd=proj.firmware_dir, quiet=quiet, env=build_env
    )
    # On a successful plain build, shrink-wrap `fixed` to the measured data size.
    # Configure sized `fixed` generously (a safe upper bound, so the littlefs pack
    # never NOSPCs) and `app` as the remainder, so nothing was carried in from a
    # previous run. Now that `data_merged` is built we know `fixed`'s real size, so
    # we shrink it — computed fresh, persisting nothing. `app_b` is measured only to
    # assert the firmware ceiling. We finalize only when the real size differs from
    # what the (generous) configure produced, comparing against the size already in
    # partitions.csv — in-build state, not a cross-run cache. Finalize regenerates
    # the table + fixed image + flash offset in place (no rebuild); on failure it
    # falls back to a rebuild so a broken fixup can't ship a bad image.
    if rc == 0 and (not idf_args or idf_args == ["build"]):
        build_dir = proj.firmware_dir / "build"
        app_b, fixed_b = measure_build_sizes(build_dir)
        if fixed_b and align_up(fixed_b, 0x1000) != _fixed_size_in(proj.firmware_dir / "partitions.csv"):
            frc = finalize_shrink_wrap(proj, build_dir, app_b, fixed_b)
            if frc != 0:
                print("spangap: in-place finalize failed (%d) — rebuilding "
                      "once" % frc, file=sys.stderr)
                (proj.firmware_dir / "partitions.csv").touch()
                rc = run_build_idf(idf_args or ["build"], cwd=proj.firmware_dir,
                                   quiet=quiet, env=build_env)
        if rc == 0:
            print_partition_layout(proj.firmware_dir / "partitions.csv")
            write_flasher_zip(build_dir)
    return rc


def cmd_flash(args: argparse.Namespace) -> int:
    """In-container flash: touch .spangap-flashme, wait for a monitor to consume it.

    The container can't see a serial port — only the host running
    `spangap monitor` can actually flash. We signal via the workspace-root
    .spangap-flashme (visible to the host at $workspace/.spangap-flashme) and
    watch for it to disappear (the monitor loop deletes it on a short delay
    just after it starts flashing).
    """
    proj = find_project()
    flashme = WORKSPACE / ".spangap-flashme"
    flashme.touch()
    print(f"spangap: signaled {flashme} — waiting for a monitor to pick it up...", file=sys.stderr)
    for _ in range(5):
        time.sleep(1)
        if not flashme.exists():
            print("spangap: flashing.", file=sys.stderr)
            return 0
    print(
        "spangap: flashme still present after 5s — nobody seems to be running\n"
        "         `spangap monitor <dev>`. Start it on a host with the serial port.",
        file=sys.stderr,
    )
    return 1


def cmd_reset(args: argparse.Namespace) -> int:
    """In-container reset: touch .spangap-resetme, wait for a monitor to consume it.

    Like cmd_flash, the container can't touch the device — only the host
    `spangap monitor` can reset it. We drop the workspace-root .spangap-resetme
    marker (visible to the host at $workspace/.spangap-resetme); the monitor
    loop watches for it alongside .spangap-flashme, then restarts with a device
    reset (clean reboot + boot-log capture) — no reflash. Unlike flash this
    needs no build artifacts, so there's no buildable check. (Tearing the
    workspace's container/image down is the host-only `spangap reset-workspace`.)
    """
    resetme = WORKSPACE / ".spangap-resetme"
    resetme.touch()
    print(f"spangap: signaled {resetme} — waiting for a monitor to pick it up...", file=sys.stderr)
    for _ in range(5):
        time.sleep(1)
        if not resetme.exists():
            print("spangap: resetting the device.", file=sys.stderr)
            return 0
    print(
        "spangap: resetme still present after 5s — nobody seems to be running\n"
        "         `spangap monitor <dev>`. Start it on a host with the serial port.",
        file=sys.stderr,
    )
    return 1


def _read_direct(path: Path) -> bytes:
    """Read `path` bypassing the stale bind-mount cache via O_DIRECT.

    The host `spangap monitor` appends to .spangap-log while holding it open;
    the container's bind mount serves a stale cached snapshot to cat/tail/stat
    (even the reported size freezes), so they miss the newest lines. O_DIRECT
    bypasses that cache and yields the true current contents. Falls back to a
    plain read where O_DIRECT is unsupported.
    """
    BS = 1 << 20  # page-aligned read size keeps O_DIRECT offsets aligned
    try:
        fd = os.open(str(path), os.O_RDONLY | os.O_DIRECT)
    except OSError:
        try:
            return path.read_bytes()
        except OSError:
            return b""
    try:
        buf = mmap.mmap(-1, BS)  # anonymous => page-aligned buffer
        out = bytearray()
        off = 0
        while True:
            n = os.preadv(fd, [buf], off)  # offsets stay multiples of BS (aligned)
            if n <= 0:
                break
            out += bytes(buf[:n])
            if n < BS:  # short read => EOF
                break
            off += BS
        return bytes(out)
    finally:
        os.close(fd)


def _log_from_relay(follow: bool) -> bool:
    """Stream the serial log from the host monitor's relay at
    host.docker.internal:LOG_PORT (see serve_log in spangap-outside's bridge).

    Returns True once it has connected and streamed (the normal path on Docker
    Desktop). Returns False without emitting if the relay can't be reached —
    host.docker.internal doesn't resolve (native-Linux host, where the bind
    mount is coherent and a direct read works), or it resolves but nothing is
    listening (no `spangap monitor` running) — so the caller can fall back.
    """
    try:
        socket.getaddrinfo("host.docker.internal", LOG_PORT)
    except OSError:
        return False  # not Docker Desktop — no relay; caller reads the file
    try:
        s = socket.create_connection(("host.docker.internal", LOG_PORT),
                                      timeout=5)
    except OSError:
        return False  # relay down (no monitor) — caller reads the file
    try:
        s.settimeout(None)
        s.sendall(b"FOLLOW\n" if follow else b"ONCE\n")
        out = sys.stdout.buffer
        while True:
            data = s.recv(65536)
            if not data:
                break
            out.write(data)
            out.flush()
    except KeyboardInterrupt:
        pass
    finally:
        s.close()
    return True


def cmd_log(args: argparse.Namespace) -> int:
    """Print the device serial log captured by the host `spangap monitor`.

    The monitor appends the live log to $workspace/.spangap-log on the host. On
    Docker Desktop that file is UNREADABLE from inside the container: the bind
    mount is virtiofs with keep_cache, so while the host holds the file open and
    appends, the container's cached inode freezes at the size it had when
    monitor truncated it (0). No in-container read — cat/tail/stat, O_DIRECT,
    statx(FORCE_SYNC), fadvise, readdir, remount — gets past that stale size.

    So we don't read the file here; we connect to the host monitor's serial-log
    relay (host.docker.internal:LOG_PORT, served by the same bridge that
    forwards the device ports) and stream the real bytes. Only if the relay is
    unreachable do we fall back to a direct read — correct on a native-Linux
    host (coherent bind mount), and on Docker Desktop a clear signal that the
    monitor isn't running.
    """
    if _log_from_relay(args.follow):
        return 0

    path = WORKSPACE / ".spangap-log"
    # Relay unreachable. On Docker Desktop (host.docker.internal resolves) that
    # means no monitor is running and the direct read below will be stale/empty,
    # so say so; on native Linux the relay simply doesn't exist and the read is
    # authoritative, so stay quiet.
    try:
        socket.getaddrinfo("host.docker.internal", LOG_PORT)
        print(f"spangap: serial-log relay (host.docker.internal:{LOG_PORT}) "
              "unreachable — is `spangap monitor` running on the host? "
              "Showing the (stale) bind-mounted file.", file=sys.stderr)
    except OSError:
        pass

    if not args.follow:
        sys.stdout.buffer.write(_read_direct(path))
        sys.stdout.flush()
        return 0
    emitted = 0
    try:
        while True:
            data = _read_direct(path)
            if len(data) < emitted:  # host truncated/recreated on flash/reset
                emitted = 0
                print("spangap: --- log reset (device reflashed/reset) ---",
                      file=sys.stderr)
            if len(data) > emitted:
                sys.stdout.buffer.write(data[emitted:])
                sys.stdout.flush()
                emitted = len(data)
            time.sleep(0.5)
    except KeyboardInterrupt:
        return 0


