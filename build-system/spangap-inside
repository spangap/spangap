    itself. Optional requires that aren't present are silently dropped
    (same semantics as `build` without --no-X). A read-only diagnostic for
    seeing exactly what a build of this straddle would pull in.
    """
    proj = find_project()
    deps, _ = resolve_requires(proj, scan_workspace_straddles())
    for d in deps:
        print(d.name)
    return 0


def _monitor_ready(timeout: float = 4.0) -> bool:
    """Probe for a host-side `spangap monitor` via the .spangap-ping handshake.

    Drop the marker and wait up to `timeout`s for the monitor to delete it (it
    watches the workspace root and removes any ping on sight). Vanished ⟹ a
    monitor is up and can flash. On timeout, remove our own stale probe so it
    doesn't confuse a monitor that starts later, and report not-ready.
    """
    try:
        PING_FILE.touch()
    except OSError:
        return False
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not PING_FILE.exists():
            return True
        time.sleep(0.1)
    PING_FILE.unlink(missing_ok=True)
    return False


