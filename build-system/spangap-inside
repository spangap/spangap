def cmd_list_deps(args: argparse.Namespace) -> int:
    """Print transitive requires: not yet present as workspace siblings.

    One spec per line; nothing else on stdout — parsed by host-side
    `spangap get-deps` orchestrator in spangap-outside.

    --with/--without mirror the build's selection so the walk resolves the same
    closure the build will. The --with seeds matter most: a --with straddle's
    additional_installs are only reachable when that straddle is a walk root,
    so without them the loop never clones e.g. hw-tdeck's spangap-lcd and the
    build silently drops it (soft + absent). Slash-form --with names may not be
    in the workspace yet on the first pass — the host pre-clones them before
    list-deps runs, but a bare-form name that's still absent resolves to itself.
    """
    proj = find_project()
    all_straddles = scan_workspace_straddles()
    included = {_resolve_org_repo(r, all_straddles, "--with") for r in (args.include or [])}
    excluded = {_resolve_org_repo(r, all_straddles, "--without") for r in (args.exclude or [])}
    _, missing = resolve_requires(
        proj, all_straddles, missing_ok=True, included=included, excluded=excluded
    )
    for spec in missing:
        print(spec)
    return 0


