SCHEMA_PATH = Path("/usr/local/share/spangap/straddle.schema.json")
WORKSPACE = Path("/work")
HOST_FILE = WORKSPACE / ".spangap-host"


class Manifest:
    """Validated straddle.yaml plus its on-disk location."""

    def __init__(self, manifest_path: Path, data: dict[str, Any]) -> None:
        self.path = manifest_path
        self.dir = manifest_path.parent
        self.data = data

    @property
    def name(self) -> str: return self.data["name"]
    @property
    def org(self) -> str: return self.name.split("/", 1)[0]
    @property
    def repo(self) -> str: return self.name.split("/", 1)[1]
    @property
    def prefix(self) -> str: return self.data["prefix"]
    @property
    def version(self) -> str: return self.data["version"]
    @property
    def firmware_dir(self) -> Path:
        return (self.dir / self.data.get("firmware", "idf")).resolve()
    @property
    def browser_dir(self) -> Path:
        return (self.dir / self.data.get("browser", "browser")).resolve()
    @property
    def has_firmware(self) -> bool:
        return self.firmware_dir.exists() and (self.firmware_dir / "CMakeLists.txt").exists()
    @property
    def has_browser(self) -> bool:
        return self.browser_dir.exists() and (self.browser_dir / "package.json").exists()
    @property
    def requires(self) -> list[str]:
        return list(self.data.get("requires", []))
    @property
    def optional_requires(self) -> list[str]:
        return list(self.data.get("optional_requires", []))
    @property
    def is_buildable(self) -> bool:
        return "buildable" in self.data


def die(msg: str, exit_code: int = 1):
    sys.stderr.write(f"spangap: {msg}\n")
    sys.exit(exit_code)


def find_project(start: Path | None = None) -> Manifest:
    """Walk up from cwd until straddle.yaml. That's the project."""
    cur = (start or Path.cwd()).resolve()
    while True:
        cand = cur / "straddle.yaml"
        if cand.is_file():
            return load_manifest(cand)
        if cur == cur.parent:
            die(
                f"no straddle.yaml found at or above {Path.cwd()}.\n"
                "       Run from inside a straddle (a dir with straddle.yaml at its root)."
            )
        cur = cur.parent


def load_manifest(path: Path) -> Manifest:
    try:
        raw = yaml.safe_load(path.read_text())
    except yaml.YAMLError as e:
        die(f"{path}: invalid YAML — {e}")
    if not isinstance(raw, dict):
        die(f"{path}: top-level must be a mapping")
    schema = json.loads(SCHEMA_PATH.read_text())
    errs = sorted(Draft202012Validator(schema).iter_errors(raw), key=lambda e: e.path)
    if errs:
        for e in errs:
            loc = "/".join(str(p) for p in e.path) or "<root>"
            sys.stderr.write(f"spangap: {path}: {loc}: {e.message}\n")
        die(f"{path}: schema validation failed ({len(errs)} error(s))")
    return Manifest(path, raw)


def scan_workspace_straddles() -> dict[str, Manifest]:
    """Every straddle.yaml under immediate children of /work, indexed by name."""
    found: dict[str, Manifest] = {}
    if not WORKSPACE.is_dir():
        die(f"workspace {WORKSPACE} not mounted — is the container running with -v <ws>:/work?")
    for child in sorted(WORKSPACE.iterdir()):
        if not child.is_dir():
            continue
        m_path = child / "straddle.yaml"
        if not m_path.is_file():
            continue
        m = load_manifest(m_path)
        if m.name in found:
            die(f"two straddles claim the same name '{m.name}':\n  {found[m.name].path}\n  {m.path}")
        found[m.name] = m
    return found


def resolve_requires(
    proj: Manifest,
    all_straddles: dict[str, Manifest],
    missing_ok: bool = False,
    excluded: set[str] | None = None,
) -> tuple[list[Manifest], list[str]]:
    """Walk requires: and optional_requires: transitively, topo-sorted.

    Hard requires: missing → die (unless missing_ok, then collected and returned).
    Optional requires: missing from workspace → if missing_ok, COLLECTED (so
    `spangap get-deps` clones them too — optional means "use if present", not
    "deliberately absent"; --exclude is the explicit "don't use this" path).
    Optional requires: missing AND no missing_ok → silently skipped (build path).
    Optional requires: in `excluded` → silently dropped, no recursion.

    `excluded` is the set of bare names (org/repo) the user dropped via
    --exclude/--no-X. A hard requires: targeting an excluded straddle is an
    error — the user asked for something contradictory.
    """
    excluded = excluded or set()
    out: list[Manifest] = []
    seen: set[str] = set()
    on_stack: set[str] = set()
    missing: dict[str, str] = {}

    def visit(spec: str, requested_by: str, hard: bool) -> None:
        bare = spec.split("@", 1)[0]
        if bare in seen:
            return
        if bare in excluded:
            if hard:
                die(
                    f"--exclude/{'--no-X'}: {bare} was dropped, but {requested_by} "
                    f"lists it under `requires:` (hard). Either don't exclude it, or "
                    f"move it to `optional_requires:` in {requested_by}'s straddle.yaml."
                )
            return  # soft drop
        if bare in missing:
            return
        if bare in on_stack:
            die(f"requires: cycle through {bare} (from {requested_by})")
        if bare not in all_straddles:
            if missing_ok:
                # get-deps path: report so the host-side orchestrator clones it.
                # Applies equally to hard and soft — soft means "use if present",
                # so being absent on first checkout is exactly the case where we
                # want it cloned. Explicit --exclude is the way to opt out.
                missing[bare] = spec
                return
            if hard:
                die(
                    f"missing workspace sibling: {bare} (required by {requested_by}).\n"
                    "       Run `spangap get-deps` from this straddle to clone it."
                )
            return  # build path: soft + absent → silently skip
        on_stack.add(bare)
        for dep in all_straddles[bare].requires:
            visit(dep, bare, hard=True)
        for dep in all_straddles[bare].optional_requires:
            visit(dep, bare, hard=False)
        on_stack.discard(bare)
        seen.add(bare)
        out.append(all_straddles[bare])

    for r in proj.requires:
        visit(r, proj.name, hard=True)
    for r in proj.optional_requires:
        visit(r, proj.name, hard=False)
    return out, list(missing.values())


def _bare(spec: str) -> str:
    """Strip @<ref> suffix from a requires entry."""
    return spec.split("@", 1)[0]


def _repo(bare_name: str) -> str:
    """Strip org/ prefix — what CMake REQUIRES uses."""
    return bare_name.split("/", 1)[1] if "/" in bare_name else bare_name


def effective_requires(m: Manifest, staged_repos: set[str]) -> list[str]:
    """Cross-straddle REQUIRES list for one component, in repo-only form.

    = hard requires + (optional_requires ∩ staged), order-preserved, deduped.
    """
    out: list[str] = []
    seen: set[str] = set()
    for spec in m.requires:
        r = _repo(_bare(spec))
        if r not in seen:
            seen.add(r); out.append(r)
    for spec in m.optional_requires:
        r = _repo(_bare(spec))
        if r in staged_repos and r not in seen:
            seen.add(r); out.append(r)
    return out


# Top-level docstring (Markdown is fine; reads as `head -1` of the generated file).
_GEN_HEADER_CMAKE = (
    "# AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
    "# Effective cross-straddle REQUIRES for this component, derived from the\n"
    "# straddle's requires: / optional_requires: intersected with the staged set.\n"
)
_GEN_HEADER_KCONFIG = (
    "# AUTO-GENERATED by spangap-inside. Do not edit; regenerated each build.\n"
    "# Presence symbols for every staged straddle. The hidden STRADDLE_<NAME>\n"
    "# generic is always emitted; SPANGAP_LCD / SPANGAP_WEB shortcuts are also\n"
    "# emitted when those two central straddles are staged (source code gates\n"
    "# on the shortcuts).\n"
)


def _name_to_kconfig(repo: str) -> str:
    """spangap-lcd → SPANGAP_LCD, reticulous-tdeck → RETICULOUS_TDECK."""
    return repo.upper().replace("-", "_").replace(".", "_")


def write_spangap_requires(out_dir: Path, requires_list: list[str]) -> None:
    body = " ".join(requires_list)
    text = _GEN_HEADER_CMAKE + f"set(SPANGAP_REQUIRES {body})\n"
    (out_dir / "spangap_requires.cmake").write_text(text)


def write_presence_component(staging: Path, staged: list[Manifest]) -> None:
    """Emit staging/components/_spangap_present/ — empty IDF component that
    contributes a Kconfig.projbuild defining presence symbols for the staged set.
    """
    comp = staging / "_spangap_present"
    comp.mkdir(parents=True, exist_ok=True)
    (comp / "CMakeLists.txt").write_text(
        _GEN_HEADER_CMAKE
        + "# Empty register — this component exists only for its Kconfig.projbuild.\n"
        + "idf_component_register()\n"
    )
    lines: list[str] = [_GEN_HEADER_KCONFIG]
    shortcut_repos = {"spangap-lcd", "spangap-web"}
    for m in staged:
        sym = _name_to_kconfig(m.repo)
        lines.append(f"config STRADDLE_{sym}\n    bool\n    default y\n")
        if m.repo in shortcut_repos:
            # Shortcut alias: code gates on these.
            lines.append(f"config {sym}\n    bool\n    default y\n")
    (comp / "Kconfig.projbuild").write_text("\n".join(lines))


_CMAKE_COMMENT_RE = None  # lazily compiled below


def _strip_cmake_comments(text: str) -> str:
    """Drop CMake # comments; bracket-comments are rare and we don't bother."""
    out: list[str] = []
    for line in text.splitlines():
        idx = line.find("#")
        out.append(line[:idx] if idx >= 0 else line)
    return "\n".join(out)


def _extract_requires_tokens(text: str) -> list[str]:
    """Find every idf_component_register(...) REQUIRES list and return the tokens.

    Robust enough for our codebase — CMake parsing is otherwise a rabbit hole.
    Anything that looks like a CMake variable expansion (${...}) is dropped;
    we want to lint hand-written names only.
    """
    stripped = _strip_cmake_comments(text)
    tokens: list[str] = []
    i = 0
    needle = "idf_component_register"
    while True:
        i = stripped.find(needle, i)
        if i < 0:
            break
        # Find the opening paren after the call name.
        op = stripped.find("(", i + len(needle))
        if op < 0:
            break
        # Find the matching closing paren (no nesting in idf_component_register).
        cl = stripped.find(")", op + 1)
        if cl < 0:
            break
        body = stripped[op + 1 : cl]
        i = cl + 1
        # Scan body for REQUIRES <tokens> until the next ALL_CAPS keyword.
        words = body.split()
        in_req = False
        for w in words:
            if w == "REQUIRES":
                in_req = True
                continue
            if w.isupper() and w.replace("_", "").isalpha():
                # New keyword (PRIV_REQUIRES, SRCS, INCLUDE_DIRS, ...). Ends REQUIRES section.
                in_req = (w == "REQUIRES")
                continue
            if in_req and not w.startswith("${"):
                tokens.append(w)
    return tokens


def lint_cmakelists(proj: Manifest, deps: list[Manifest], all_straddles: dict[str, Manifest]) -> None:
    """Fail loud if any staged CMakeLists hand-writes a known straddle name in REQUIRES.

    Forces consumers to flow cross-straddle deps through ${SPANGAP_REQUIRES}, so the
    --no-X / optional_requires machinery actually narrows the dep graph.
    """
    known_repos = {m.repo for m in all_straddles.values()}
    staging = proj.firmware_dir / "staging" / "components"
    targets: list[Path] = []
    for dep in deps:
        cml = staging / dep.repo / "CMakeLists.txt"
        if cml.is_symlink() or cml.is_file():
            targets.append(cml)
    if proj.is_buildable:
        main_cml = proj.firmware_dir / "main" / "CMakeLists.txt"
        if main_cml.is_file():
            targets.append(main_cml)

    offenses: list[tuple[Path, str]] = []
    for cml in targets:
        try:
            text = cml.read_text()
        except OSError:
            continue
        for tok in _extract_requires_tokens(text):
            if tok in known_repos:
                offenses.append((cml, tok))

    if offenses:
        for cml, tok in offenses:
            sys.stderr.write(
                f"spangap: {cml}: hand-written straddle '{tok}' in REQUIRES.\n"
                f"         Cross-straddle deps must flow through ${{SPANGAP_REQUIRES}} so the\n"
                f"         optional_requires / --no-X machinery can narrow them. List '{tok}'\n"
                f"         in the straddle.yaml's requires: or optional_requires: instead.\n"
            )
        die(f"REQUIRES lint failed ({len(offenses)} hand-written straddle name(s))")


def write_main_requires(proj: Manifest, staged_repos: set[str]) -> None:
    """For a buildable straddle, write staging/main_requires.cmake — the
    effective cross-straddle REQUIRES list for the buildable's main component.
    """
    if not proj.is_buildable:
        return
    requires_list = effective_requires(proj, staged_repos)
    staging_dir = proj.firmware_dir / "staging"
    staging_dir.mkdir(parents=True, exist_ok=True)
    body = " ".join(requires_list)
    text = _GEN_HEADER_CMAKE + f"set(SPANGAP_REQUIRES {body})\n"
    (staging_dir / "main_requires.cmake").write_text(text)


def signal_preamble(proj: Manifest, deps: list[Manifest], missing: list[str] = ()) -> None:
    n = len(deps)
    dep_summary = f"{n} dep" + ("s" if n != 1 else "")
    print(f"workspace: {WORKSPACE}", file=sys.stderr)
    print(f"project:   {proj.name} ({proj.version})", file=sys.stderr)
    if deps:
        print(f"requires:  {dep_summary} — {', '.join(d.name for d in deps)}", file=sys.stderr)
    if missing:
        print(f"missing:   {len(missing)} not yet cloned — {', '.join(missing)}", file=sys.stderr)
        print("           run `spangap get-deps` from this straddle to fetch them.", file=sys.stderr)


def stage_components(proj: Manifest, deps: list[Manifest]) -> Path:
    """Stage each transitive dep into <fw>/staging/components/<repo>/, as a
    real dir of per-entry symlinks to the dep's firmware_dir contents plus
    generated build-system files. The per-entry layout (vs. one symlink to
    the whole dep) lets us drop generated files into the staged dir without
    polluting the source tree.

    Also writes the synthetic _spangap_present component and the buildable's
    main_requires.cmake.
    """
    staging = proj.firmware_dir / "staging" / "components"
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(parents=True, exist_ok=True)

    staged_repos: set[str] = {d.repo for d in deps}

    for dep in deps:
        src = dep.firmware_dir
        if not src.is_dir() or not (src / "CMakeLists.txt").exists():
            die(f"{dep.name}: firmware dir {src} has no CMakeLists.txt — can't stage")
        dst = staging / dep.repo
        dst.mkdir()
        for entry in sorted(src.iterdir()):
            (dst / entry.name).symlink_to(entry)
        write_spangap_requires(dst, effective_requires(dep, staged_repos))
        print(f"  staged: {dep.repo} -> {src}", file=sys.stderr)

    write_presence_component(staging, deps)
    write_main_requires(proj, staged_repos)
    return staging


def run_idf(args: list[str], cwd: Path, env: dict[str, str] | None = None) -> int:
    cmd = ["idf.py", *args]
    print(f"+ {' '.join(cmd)}  (in {cwd})", file=sys.stderr)
    return subprocess.run(cmd, cwd=cwd, env={**os.environ, **(env or {})}).returncode


_NO_SHORTHANDS = {  # --no-<x> maps to --exclude <bare>
    "lcd": "spangap/spangap-lcd",
    "web": "spangap/spangap-web",
}


def cmd_build(args: argparse.Namespace) -> int:
    proj = find_project()
    if not proj.is_buildable:
        die(
            f"{proj.name} is not a buildable straddle (no `buildable:` block in straddle.yaml).\n"
            "       `spangap build` only builds buildable straddles. Build a consumer of this one."
        )
    if not proj.has_firmware:
        die(f"{proj.name}: firmware dir {proj.firmware_dir} has no CMakeLists.txt")

    all_straddles = scan_workspace_straddles()

    # Build the excluded set: --exclude entries (bare or org/repo) + --no-<short>.
    excluded: set[str] = set()
    for raw in (args.exclude or []):
        bare = raw if "/" in raw else None
        if bare is None:
            # Bare repo name → find its org/repo in workspace.
            matches = [n for n in all_straddles if all_straddles[n].repo == raw]
            if not matches:
                die(f"--exclude {raw}: no workspace straddle with that repo name")
            if len(matches) > 1:
                die(f"--exclude {raw}: ambiguous ({', '.join(matches)}); use org/repo form")
            bare = matches[0]
        excluded.add(bare)
    for short, full in _NO_SHORTHANDS.items():
        if getattr(args, f"no_{short}", False):
            excluded.add(full)

    deps, _ = resolve_requires(proj, all_straddles, excluded=excluded)
    signal_preamble(proj, deps)
    if excluded:
        print(f"excluded:  {', '.join(sorted(excluded))}", file=sys.stderr)
    stage_components(proj, deps)
    lint_cmakelists(proj, deps, all_straddles)
    return run_idf(args.idf_args or ["build"], cwd=proj.firmware_dir)


def cmd_flash(args: argparse.Namespace) -> int:
    """In-container flash: touch <project>/build/flashme, wait for a monitor to consume it.

    The container can't see a serial port — only the host running
    `spangap monitor` can actually flash. We signal via flashme and watch
    for it to disappear (the monitor loop deletes it just before flashing).
    """
    proj = find_project()
    if not proj.is_buildable:
        die(f"{proj.name} is not a buildable straddle (no `buildable:` block) — nothing to flash.")
    flashme = proj.firmware_dir / "build" / "flashme"
    flashme.parent.mkdir(parents=True, exist_ok=True)
    flashme.touch()
    print(f"spangap: signaled {flashme} — waiting for a monitor to pick it up...", file=sys.stderr)
    for _ in range(5):
        time.sleep(1)
        if not flashme.exists():
            print("spangap: flashing.", file=sys.stderr)
            return 0
    print(
        "spangap: flashme still present after 5s — nobody seems to be running\n"
        "         `spangap monitor <dev>`. Start it on a host with the serial port.",
        file=sys.stderr,
    )
    return 1


def cmd_clean(args: argparse.Namespace) -> int:
    proj = find_project()
    return run_idf(["fullclean"], cwd=proj.firmware_dir)


def cmd_doctor(args: argparse.Namespace) -> int:
    print("spangap doctor (in-container)")
    print(f"  python:      {sys.version.split()[0]}")
    print(f"  workspace:   {WORKSPACE} ({'mounted' if WORKSPACE.is_dir() else 'MISSING'})")
    try:
        proj = find_project()
        print(f"  project:     {proj.name} ({proj.version}) at {proj.dir}")
    except SystemExit:
        print("  project:     <none — cwd not under a straddle>")
    print(f"  IDF_PATH:    {os.environ.get('IDF_PATH', '<unset>')}")
    print(f"  IDF_TOOLS:   {os.environ.get('IDF_TOOLS_PATH', '<unset>')}")
    print(f"  node:        {_capture(['node', '--version'])}")
    print(f"  npm:         {_capture(['npm', '--version'])}")
    print(f"  idf.py:      {_capture(['idf.py', '--version'])}")
    return 0


def _capture(cmd: list[str]) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, check=False)
        return (r.stdout or r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr) else "<no output>"
    except FileNotFoundError:
        return "<not installed>"


def cmd_validate(args: argparse.Namespace) -> int:
    proj = find_project()
    deps, _ = resolve_requires(proj, scan_workspace_straddles())
    print(f"{proj.name} v{proj.version} — OK")
    if deps:
        print("requires (topo):")
        for d in deps:
            print(f"  - {d.name} v{d.version}")
    return 0


def cmd_list_deps(args: argparse.Namespace) -> int:
    """Print transitive requires: not yet present as workspace siblings.

    One spec per line; nothing else on stdout — parsed by host-side
    `spangap get-deps` orchestrator in spangap-outside.
    """
    proj = find_project()
    _, missing = resolve_requires(proj, scan_workspace_straddles(), missing_ok=True)
    for spec in missing:
        print(spec)
    return 0


def cmd_reallyclean(args: argparse.Namespace) -> int:
    """Source-only state: drop idf build/, staging/, browser node_modules/, dist/, .quasar."""
    proj = find_project()
    targets = [
        proj.firmware_dir / "build",
        proj.firmware_dir / "staging",
        proj.firmware_dir / "managed_components",
        proj.browser_dir / "node_modules",
        proj.browser_dir / "dist",
        proj.browser_dir / ".quasar",
    ]
    for t in targets:
        if t.is_symlink() or t.is_file():
            t.unlink()
            print(f"  rm {t}", file=sys.stderr)
        elif t.is_dir():
            shutil.rmtree(t)
            print(f"  rm -r {t}", file=sys.stderr)
    pkg_lock = proj.browser_dir / "package-lock.json"
    if pkg_lock.is_file():
        pkg_lock.unlink()
        print(f"  rm {pkg_lock}", file=sys.stderr)
    print("spangap: reallyclean done.")
    return 0


def cmd_claude(claude_args: list[str]) -> int:
    """Lazy-install @anthropic-ai/claude-code (if absent) and exec `claude`."""
    if not shutil.which("claude"):
        print("spangap: claude not installed in container — running `npm install -g @anthropic-ai/claude-code`...", file=sys.stderr)
        r = subprocess.run(["npm", "install", "-g", "@anthropic-ai/claude-code"], check=False)
        if r.returncode != 0:
            die("npm install -g @anthropic-ai/claude-code failed; see output above")
    claude_path = shutil.which("claude")
    if not claude_path:
        die("claude still not on PATH after npm install — check /home/ubuntu/.npm-global/bin")
    os.execvp(claude_path, [claude_path, *claude_args])
    return 1


# ---------------------------------------------------------------------------
# `spangap cli` — TCP CLI client. Same UX as the host-side `spangap cli`:
# -h persists hostname to /work/.spangap-host (= $SPANGAP_WORKSPACE/.spangap-host
# on the host through the bind mount), subsequent calls can omit it.
# ---------------------------------------------------------------------------
PROMPT = b"$ "


def cmd_cli(argv: list[str]) -> int:
    host: str | None = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-h":
            if i + 1 >= len(argv):
                die("spangap cli: -h needs a hostname")
            host = argv[i + 1]
            HOST_FILE.write_text(host + "\n")
            i += 2
        elif a == "--":
            i += 1
            break
        else:
            break
    if host is None:
        host = os.environ.get("SPANGAP_HOST") or (HOST_FILE.read_text().strip() if HOST_FILE.is_file() else "")
        if not host:
            die("spangap cli: no host — pass -h <host> first to persist it")
    port = int(os.environ.get("SPANGAP_CLI_PORT", "2323"))

    try:
        s = socket.create_connection((host, port), timeout=10)
    except OSError as e:
        die(f"cli: connect {host}:{port}: {e}")
    s.settimeout(None)

    def drain():
        buf = b""
        while not buf.endswith(PROMPT):
            d = s.recv(4096)
            if not d:
                break
            buf += d
        return buf

    rest = argv[i:]
    if rest:
        drain()
        s.sendall((" ".join(rest) + "\n").encode())
        out = drain()
        if out.endswith(PROMPT):
            out = out[: -len(PROMPT)]
        sys.stdout.buffer.write(out)
        sys.stdout.flush()
        return 0

    sel = selectors.DefaultSelector()
    sel.register(sys.stdin, selectors.EVENT_READ)
    sel.register(s, selectors.EVENT_READ)
    try:
        while True:
            for key, _ in sel.select():
                if key.fileobj is sys.stdin:
                    data = sys.stdin.buffer.read1(4096)
                    if not data:
                        return 0
                    s.sendall(data)
                else:
                    data = s.recv(4096)
                    if not data:
                        return 0
                    sys.stdout.buffer.write(data)
                    sys.stdout.flush()
    except KeyboardInterrupt:
        return 0


def main(argv: list[str] | None = None) -> int:
    raw = sys.argv[1:] if argv is None else argv
    # Pass-through subcommands whose own flag parsing would clash with argparse.
    if raw and raw[0] == "claude":
        return cmd_claude(raw[1:])
    if raw and raw[0] == "cli":
        return cmd_cli(raw[1:])

    p = argparse.ArgumentParser(prog="spangap", description="spangap straddles CLI (in-container)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("doctor", help="report environment info").set_defaults(func=cmd_doctor)
    sub.add_parser("validate", help="parse + validate manifest and dep graph").set_defaults(func=cmd_validate)
    sub.add_parser("clean", help="run idf.py fullclean").set_defaults(func=cmd_clean)
    sub.add_parser("reallyclean", help="strip back to source-only state").set_defaults(func=cmd_reallyclean)

    p_build = sub.add_parser("build", help="build the project (default: idf.py build)")
    p_build.add_argument(
        "-e", "--exclude", action="append", default=[], metavar="STRADDLE",
        help="drop this straddle from the staged set for this build (repeatable; "
             "name as <org>/<repo> or just <repo>). Targeted at optional_requires: "
             "entries — excluding a hard requires: target is an error.",
    )
    for short, full in _NO_SHORTHANDS.items():
        p_build.add_argument(
            f"--no-{short}", dest=f"no_{short}", action="store_true",
            help=f"shorthand for --exclude {full}",
        )
    p_build.add_argument("idf_args", nargs="*", help="forwarded to idf.py")
    p_build.set_defaults(func=cmd_build)

    sub.add_parser(
        "flash",
        help="signal a host running `spangap monitor` to reflash (touches build/flashme)",
    ).set_defaults(func=cmd_flash)

    sub.add_parser(
        "list-deps",
        help="print transitive requires: not yet present as workspace siblings (used by host-side `spangap get-deps`)",
    ).set_defaults(func=cmd_list_deps)

    args = p.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
