# Baked into the image at /usr/local/share/spangap/. Overridable via
# SPANGAP_SCHEMA_PATH so the source copy can be exercised in-container against an
# edited schema before the host rebuilds the image (production leaves it unset).
SCHEMA_PATH = Path(os.environ.get(
    "SPANGAP_SCHEMA_PATH", "/usr/local/share/spangap/straddle.schema.json"))
# Straddles live under one flat, container-native root — no symlinks, no host
# paths inside: <workspace>/<repo>, git clones laid out flat as direct children
# of the workspace. Because the layout is flat, the browser `file:../../<sibling>`
# deps resolve straight through. The workspace dir itself also holds the marker,
# the dotfiles, and the per-host venv; non-straddle entries have no straddle.yaml
# and are skipped. Builds bake the container path (e.g.
# /home/spangap/<ws>/<repo>) into CMakeCache; it's stable across a given
# workspace and host-independent in layout.
#
# The workspace is bind-mounted at /home/spangap/<basename-of-host-workspace>
# (nested under the persistent ~ = /home/spangap mount), not a fixed path — so
# spangap-outside passes its container path in via SPANGAP_WORKSPACE on every
# `docker exec`. Fall back to walking up from cwd for the marker (covers a
# hand-run spangap-inside with no env set).
def _discover_workspace() -> Path:
    env = os.environ.get("SPANGAP_WORKSPACE")
    if env:
        return Path(env)
    cur = Path.cwd()
    for d in (cur, *cur.parents):
        if (d / "spangap.workspace.yaml").is_file():
            return d
    return cur


WORKSPACE = _discover_workspace()
