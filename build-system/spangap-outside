        # touches .spangap-flashack the moment it commits to the flash. Wait on
        # THAT, not on flashme removal: removal is deferred 3s (grace for other
        # hosts to latch the signal), which used to race this window and report a
        # false "not responding" while the flash was already running. Clear any
        # stale ack up front so we only ever see a fresh one.
        rm -f "$flashack"
        touch "$flashme"
        log "$port busy — signaled monitor"
        for _ in 1 2 3 4 5 6 7 8; do
            sleep 1
            [ -f "$flashack" ] && { rm -f "$flashack"; log "monitor is flashing."; exit 0; }
        done
        die "$port was busy but monitor not responding. Start \`spangap monitor\` on host."
