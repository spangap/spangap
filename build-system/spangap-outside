    # not the address, so set_device_host stores only the bare host.
    while [ $# -gt 0 ]; do
        case $1 in
            -h) [ $# -ge 2 ] || die "-h needs a hostname"
                set_device_host "$2"; shift 2 ;;
            --) shift; break ;;
            *)  break ;;
