        # auth first (a no-op remote `true`) so a failure can fall through rather
        # than replacing this process.
        if ssh -p "$SSH_PORT" -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
               -o ConnectTimeout=10 "$host" true >/dev/null 2>&1; then
            exec ssh -p "$SSH_PORT" -o BatchMode=yes \
                -o StrictHostKeyChecking=accept-new -o ConnectTimeout=10 "$host" "$@"
        fi

        # Legacy TCP CLI, if that socket answers.
        if host_port_open "$host" "$TCP_CLI_PORT"; then
            cli_port=${SPANGAP_CLI_PORT:-$TCP_CLI_PORT}
            # Pure-Python TCP CLI — no docker, no IDF, just a socket. Mirrors the
            # in-container `spangap cli` so dev experience is the same from either
            # side.
            exec python3 - "$host" "$cli_port" "$@" <<'PY'
import os, socket, sys, selectors
PROMPT = b"$ "
host = sys.argv[1]
port = int(sys.argv[2])
argv = sys.argv[3:]
try:
    s = socket.create_connection((host, port), timeout=10)
except OSError as e:
    sys.exit(f"spangap cli: connect {host}:{port}: {e}")
s.settimeout(None)

def drain_until_prompt(sock):
    buf = b""
    while not buf.endswith(PROMPT):
        d = sock.recv(4096)
        if not d: break
        buf += d
    return buf

if argv:
    drain_until_prompt(s)
    s.sendall((" ".join(argv) + "\n").encode())
    out = drain_until_prompt(s)
    # Filter the trailing prompt line. drain returns the moment the buffer ends
    # with the prompt, and that prompt is a whole line — "<name> $ " (e.g.
    # "reticulous $ "), not a bare "$ " — so the final line is always the
    # re-emitted prompt. Drop everything after the last newline; none ⇒ the
    # whole response was just the prompt.
    nl = out.rfind(b"\n")
    out = out[:nl + 1] if nl != -1 else b""
    sys.stdout.buffer.write(out); sys.stdout.flush()
    sys.exit(0)

sel = selectors.DefaultSelector()
sel.register(sys.stdin, selectors.EVENT_READ)
sel.register(s, selectors.EVENT_READ)
try:
    while True:
        for key, _ in sel.select():
            if key.fileobj is sys.stdin:
                data = sys.stdin.buffer.read1(4096)
                if not data: sys.exit(0)
                s.sendall(data)
            else:
                data = s.recv(4096)
                if not data: sys.exit(0)
                sys.stdout.buffer.write(data); sys.stdout.flush()
except KeyboardInterrupt:
    pass
PY
        fi

        # ssh port open but the key was refused → authorize it on the device.
        if host_port_open "$host" "$SSH_PORT"; then
            printf '\nReached %s, but its sshd refused this key. In the device serial monitor, authorize it:\n\n' "$host" >&2
            printf '    sshd add %s\n\n' "$(cat "$key.pub")" >&2
            printf 'sshd ships enabled; on an older build also run: sshd enable\n' >&2
            printf "If sshd isn't in your build, rebuild with: spangap build --with spangap/sshd\n" >&2
            printf '\nThen re-run `spangap cli`.\n' >&2
            exit 1
