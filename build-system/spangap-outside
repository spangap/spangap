    # root, where straddles live as flat siblings), creating its GitHub repo
    # (public) first if it doesn't exist yet. This runs entirely on the host —
    # `gh`/`git` and your credentials live here, never in the build container —
    # so it is handled in this arm and NOT forwarded inside. --force rewrites the
    # remote branch (needed after a history rewrite).
    shift
    force=0
    dir=$workspace
    while [ $# -gt 0 ]; do
        case $1 in
            --force) force=1 ;;
            -h|--help)
                printf '%s\n' \
                    "usage: spangap push-all [--force] [DIR]" \
                    "  Push every git repo directly under DIR (default: the workspace root)," \
                    "  creating its GitHub repo (private) first if it doesn't exist yet." \
                    "  --force rewrites the remote branch (needed after a history rewrite)." \
                    "  Requires an authenticated \`gh\`; new repos are created PUBLIC."
                exit 0 ;;
            -*) die "push-all: unknown option: $1 (try --help)" ;;
            *)  dir=$1 ;;
        esac
        shift
    done

    [ -d "$dir" ] || die "push-all: not a directory: $dir"
    command -v gh  >/dev/null 2>&1 || die "push-all: gh not found (install the GitHub CLI)"
    command -v git >/dev/null 2>&1 || die "push-all: git not found"
    gh auth status >/dev/null 2>&1 || die "push-all: gh is not authenticated (run: gh auth login)"

    # git@github.com:owner/repo.git | https://github.com/owner/repo(.git) -> owner/repo
    slug_from_url() { printf '%s' "$1" | sed -E 's#.*github\.com[:/]##; s#\.git$##; s#/$##'; }

    for repo in "$dir"/*/; do
        [ -d "$repo.git" ] || continue                       # skip non-git dirs
        name=$(basename "$repo")

        url=$(git -C "$repo" remote get-url origin 2>/dev/null) || {
            printf '%-24s no origin remote — skipped\n' "$name"; continue; }
        slug=$(slug_from_url "$url")
        [ -n "$slug" ] || { printf '%-24s cannot parse slug from %s — skipped\n' "$name" "$url"; continue; }
        branch=$(git -C "$repo" symbolic-ref --short HEAD 2>/dev/null || echo main)

        # Fast path: nothing new to push if the local tip already equals the
        # remote-tracking tip that `push -u` maintains. A never-pushed repo has no
        # tracking ref and falls through to create/push. --force always proceeds.
        if [ "$force" -eq 0 ]; then
            rtracking="refs/remotes/origin/$branch"
            if git -C "$repo" rev-parse --verify -q "$rtracking" >/dev/null 2>&1 &&
               [ "$(git -C "$repo" rev-parse HEAD)" = "$(git -C "$repo" rev-parse "$rtracking")" ]; then
                printf '%-24s up to date — skipped\n' "$name"; continue
            fi
        fi

        # Create the GitHub repo if it isn't there yet (empty; push happens below).
        if ! gh repo view "$slug" >/dev/null 2>&1; then
            if gh repo create "$slug" --public >/dev/null 2>&1; then
                printf '%-24s created %s (public)\n' "$name" "$slug"
            else
                printf '%-24s FAILED to create %s\n' "$name" "$slug"; continue
            fi
        fi

        # Push the current branch, tracking upstream.
        if [ "$force" -eq 1 ]; then
            if git -C "$repo" push -u --force origin "$branch" >/dev/null 2>&1; then
                printf '%-24s force-pushed %s -> %s\n' "$name" "$branch" "$slug"
            else
                printf '%-24s push FAILED\n' "$name"
            fi
        else
            if git -C "$repo" push -u origin "$branch" >/dev/null 2>&1; then
                printf '%-24s pushed %s -> %s\n' "$name" "$branch" "$slug"
            else
                printf '%-24s push FAILED (non-fast-forward? re-run with --force)\n' "$name"
            fi
        fi
    done
    exit 0
