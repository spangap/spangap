    shift
    # The workspace itself is mandatory — the root `spangap` shim already refuses
    # `monitor` outside one (it's not in the cli/probe outside-workspace set), so
    # by the time we're here $workspace exists and the log/signal files have a
    # home. A *straddle* is not mandatory: fw (for stack decode + the flashme
    # reflash) is resolved lazily by monitor_loop every pass (cwd straddle, else
    # the last build's remembered target), so a monitor started in a fresh
    # workspace before anything is built gains flash + decode the moment the
    # build lands — no restart, and no premature "not in a straddle" warning.
    # Seed an initial value only to decide whether to probe for the toolchain.
    fw=$(monitor_fw)
    if [ $# -gt 0 ]; then
        port=$1; shift
        sticky_set "$PORT_FILE" "$port"
    else
        port=$(sticky_get "$PORT_FILE" SPANGAP_PORT monitor "serial port")
