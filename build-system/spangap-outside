#!/bin/bash
# spangap-outside — host-side dispatcher. Run by the root `spangap` script
# with $SPANGAP_WORKSPACE set to the workspace dir.
#
# Handles everything that has to happen on the host:
#   flash <dev>      flash once and exit. Chain `&& spangap monitor` to watch
#                    the board afterwards. If <dev> is busy, just touch
#                    .spangap-flashme and exit so whichever host is running
#                    `monitor` picks the signal up.
#   monitor <dev>    passive monitor loop; re-flashes when .spangap-flashme
#                    appears and restarts (with a device reset) when
#                    .spangap-resetme appears. Also deletes any .spangap-ping
#                    on sight, so an in-container `spangap show` can detect a
#                    running monitor. Errors if <dev> is busy. Only runs in/under
#                    a workspace. Used on the host owning the board.
#   probe [<dev>]    run esptool flash_id and print chip + flash size, plus
#                    the matching `spangap build --flash-size <MB>` invocation.
#                    Useful for generic builds against unknown hardware.
#   cli [-h host[:port]] [cmd...]
#                    talk to the device. Prefers ssh (.spangap-ssh), else the
#                    TCP CLI (.spangap-tcp); with neither, bootstraps an ed25519
#                    key + writes .spangap-ssh. -h persists the ssh endpoint to
#                    ./.spangap-ssh in the workspace root; subsequent calls omit it.
#   get-deps         git-clone any missing transitive `requires:` siblings
#                    (uses host github creds; container has none). Also runs
#                    automatically as part of `build`.
#   build            same dep-fetch, then forward to spangap-inside.
#   docker <cmd>…    docker-exec <cmd> in the build-env container, raw —
#                    e.g. `spangap docker sh` for an unwrapped shell.
#   shell            synonym for `spangap docker bash`: an interactive bash
#                    in the build-env container. Extra args pass to bash.
#   reset            touch .spangap-resetme so a running `spangap monitor`
#                    restarts and resets the device (clean boot capture). No
#                    container teardown — see reset-workspace for that.
#   reset-workspace  drop this workspace's container + the build-env image
#                    (runs reallyclean inside first so the next build
#                    doesn't inherit a stale CMakeCache that baked in
#                    pre-reset paths).
#   show             last build invocation + the resolved straddle + its
#                    deps in init order.
#   ensure-container build the image (if missing) and start a fresh
#                    container with all the bind mounts. Called by
#                    `spangap init` so first-run latency lands at init
#                    time; exposed as a verb mostly for that hook.
#   ensure-venv      create / refresh the host-side flash/monitor venv
#                    ($workspace/.spangap-venv-<os>-<arch>; per-host so a
#                    shared workspace works across e.g. Mac + Linux VM).
#                    Run automatically by
#                    `spangap init` and lazily by flash/monitor.
#
# Everything else docker-exec's into spangap-inside unchanged.
#
# Serial-port and device-endpoint stickiness: explicit args overwrite
# $SPANGAP_WORKSPACE/.spangap-port-<os>-<arch> (per-host, since /dev paths
# differ) and .spangap-ssh / .spangap-tcp (workspace-wide) respectively, and
# bare invocations read whichever file's there.
set -euo pipefail

# Silence Docker CLI's "What's next:" hint footer, which the docker CLI prints
# after `docker run`/`docker exec` completes. We wrap every device/build verb in
# a docker-exec, so without this the hint trails the output of innocuous
# commands (e.g. a mistyped `spangap flsh`'s usage error). Exported once here so
# all docker invocations below inherit it.
export DOCKER_CLI_HINTS=false

workspace="${SPANGAP_WORKSPACE:?spangap-outside: SPANGAP_WORKSPACE not set (invoke via the root \`spangap\` script)}"

# In-container path of the workspace bind mount. The workspace is mounted UNDER
# the persistent home (~ = /home/spangap) at its own basename, so the whole tree
# the user works on lives under $HOME in the container (e.g. host
# /Users/me/code/foo → /home/spangap/foo). spangap-inside learns it via
# SPANGAP_WORKSPACE, passed on every `docker exec` below; host_to_container and
# the addr2line shim remap host paths against it.
container_ws="/home/spangap/$(basename "$workspace")"

# Decide SPANGAP_QUIET very early so that the host-side phases — git-clone and
# container/image setup — can collapse their verbose output into a single
# status line. (The build's own IDF/Vite output is filtered inside the
# container by spangap-inside, which reads the same -v/--verbose flag off the
# forwarded argv; this var only governs the host-side noise.)
#
# Quiet by default for `build` and `reset-workspace` (the noisy ones — dep
# fetch, image rebuild). -v|--verbose turns the noise back on. `reset-workspace`
# rebuilds the container itself, so it gets the same quiet treatment. Also
# honoured if the caller sets it in the environment (used by `spangap init` to
# gate the docker build noise behind -v/--verbose).
SPANGAP_QUIET=${SPANGAP_QUIET:-}

case "${1:-}" in
    build|reset-workspace)
        SPANGAP_QUIET=1
        case "${2:-}" in
            -v|--verbose) SPANGAP_QUIET= ;;
        esac
        ;;
esac

# Host-side flash/monitor venv. Lives entirely inside the workspace so
# `spangap init` keeps its promise of touching nothing outside it. Pins
# are exact so a working workspace stays working; ensure_venv re-runs pip
# automatically when this string changes between spangap versions.
# Host-specific suffix: a venv's bin/python symlinks back into the host
# system python, so a workspace shared across hosts (e.g. a Linux VM and
# a Mac mounting it) needs one venv per host or the wrong host's python
# gets dereferenced. uname -s -m keeps it readable in `ls`.
VENV="$workspace/.spangap-venv-$(uname -s)-$(uname -m)"
VENV_REQUIREMENTS="esptool==4.8.1 esp-idf-monitor==1.5.0"

# Per-workspace container name. Derived purely from $workspace, so it's stable
# and identical across hosts mounting the same workspace. Defined here (not in
# the docker-management section below) because the monitor path — which exits
# before that section — needs it to wire up the addr2line decode shim.
ws_hash=$(printf '%s' "$workspace" | sha256sum | cut -c1-7)
container="spangap-$ws_hash"

# Per-workspace image tag. The build-env image carries no workspace-specific
# state, so two workspaces off the same build-system/ produce byte-identical
# images — but each workspace's container holds a reference to the image it was
# created from. A shared tag therefore means a stale-hash rebuild here, or a
# `reset-workspace`, can't `docker rmi` the tag while a *different* workspace's
# container still references it ("conflict: ... container <id> is using its
# referenced image"). Scoping the tag to $workspace via ws_hash gives every
# workspace its own image to build, stamp, and remove independently.
IMAGE="spangap-build-env:$ws_hash"

# Host-side toolchain shims (currently just xtensa-esp32-elf-addr2line).
# Prepended to PATH when running esp-idf-monitor so panic backtraces
# symbolicate against the in-container toolchain. See ensure_addr2line_shim.
SHIM_DIR="$VENV/spangap-shims"

# Status-line prefix. Defaults to the invoked subcommand (so `flash` lines
# read "flash:", `build` lines "build:", etc.). The spangap launcher exports
# SPANGAP_PHASE=init around its ensure-* / get-deps calls so the whole
# workspace-bring-up flow reads "init:" regardless of which helper subcommand
# is doing the work.
PFX="${SPANGAP_PHASE:-${1:-spangap}}"
die() { printf '%s: %s\n' "$PFX" "$*" >&2; exit 1; }
log() { printf '%s: %s\n' "$PFX" "$*" >&2; }

# Create the host-side flash/monitor venv if missing, or refresh pins if
# $VENV_REQUIREMENTS changed since last setup. Idempotent + fast in the
# steady state (one stamp-file read, no pip invocation).
ensure_venv() {
    local stamp="$VENV/.spangap-requirements"
    if [ -d "$VENV" ] && [ -f "$stamp" ] \
        && [ "$(cat "$stamp")" = "$VENV_REQUIREMENTS" ]; then
        return 0
    fi
    command -v python3 >/dev/null 2>&1 \
        || die "python3 required for the host-side flash/monitor venv — install python3 (with the venv module) and retry"
    if [ ! -d "$VENV" ]; then
        log "creating host-side flash/monitor venv at $VENV..."
        python3 -m venv "$VENV" \
            || die "python3 -m venv $VENV failed (need the venv module — on Debian/Ubuntu: apt install python3-venv; on Alpine: apk add py3-virtualenv)"
    else
        log "refreshing pins in $VENV..."
    fi
    # --no-cache-dir bypasses ~/.cache/pip/http; without it, a stale or
    # cross-version cache spews `WARNING: Cache entry deserialization
    # failed, entry ignored` lines that --quiet doesn't catch (they go
    # through Python's warnings module, not pip's normal output stream).
    # We install once per workspace, so losing the HTTP cache is cheap.
    # shellcheck disable=SC2086
    "$VENV/bin/pip" install --quiet --disable-pip-version-check --no-cache-dir --upgrade $VENV_REQUIREMENTS \
        || die "pip install $VENV_REQUIREMENTS failed; see output above"
    printf '%s\n' "$VENV_REQUIREMENTS" > "$stamp"
}

# Content hash of build-system/. Stamped into the image at build time via
# --build-arg BUILDSYS_HASH and read back via the org.spangap.buildsys-hash
# label; ensure_container compares fresh-hash to stamp and rebuilds on
# mismatch, so the cached image can never silently outlive its source. Modes
# are not hashed (the Dockerfile forces them on COPY).
buildsys_hash() {
    local ctx=$1
    ( cd "$ctx" && find build-system -type f | LC_ALL=C sort | xargs sha256sum ) \
        | sha256sum | awk '{print $1}'
}

# ---------------------------------------------------------------------------
# straddle + firmware-dir resolution.
# ---------------------------------------------------------------------------

# find_straddle [start]: walk up looking for straddle.yaml, echo its dir.
find_straddle() {
    local cur=${1:-$PWD}
    cur=$(cd "$cur" && pwd)
    while :; do
        [ -f "$cur/straddle.yaml" ] && { printf '%s\n' "$cur"; return 0; }
        [ "$cur" = "/" ] && return 1
        cur=$(dirname "$cur")
    done
}

# project_host_dir <name>: host dir of straddle <name>, or return 1. <name>
# may be an <org>/<repo> or a bare repo — the flat layout names the dir by the
# repo basename either way, so we strip any org/ prefix. A straddle is either
# git-cloned at $workspace/<repo> or lives in the flat --straddles checkout at
# <straddles>/<repo> (the latter is what gets bind-mounted to /straddles inside
# the container). Checks the clone first.
project_host_dir() {
    local name=$1 repo sd
    repo=${name##*/}
    [ -f "$workspace/$repo/straddle.yaml" ] && { printf '%s\n' "$workspace/$repo"; return 0; }
    sd=$(read_straddles)
    [ -n "$sd" ] && [ -f "$sd/$repo/straddle.yaml" ] && { printf '%s\n' "$sd/$repo"; return 0; }
    return 1
}

# The last *explicit* build invocation, remembered at the workspace root so a
# bare `spangap build` repeats it. One line, target first:
#   <org/repo> [--with <org/repo>]... [--without <org/repo>]... [--flash-size N]
# Written by the container's cmd_build (it alone resolves bare tokens to
# straddles); the host reads it here to clone the target/includes and to pick
# the workspace-root default for build/flash/monitor/show.
BUILD_FILE="$workspace/.spangap-build"

# remembered_build_target: echo the target token (first word), or return 1.
remembered_build_target() {
    [ -f "$BUILD_FILE" ] || return 1
    # Tokens are simple (org/repo names, flags) — word-splitting is safe.
    # shellcheck disable=SC2046
    set -- $(head -1 "$BUILD_FILE" 2>/dev/null)
    [ $# -ge 1 ] || return 1
    printf '%s\n' "$1"
}

# remembered_build_includes: echo each --with <org/repo> value, one per line.
remembered_build_includes() {
    [ -f "$BUILD_FILE" ] || return 0
    # shellcheck disable=SC2046
    set -- $(head -1 "$BUILD_FILE" 2>/dev/null)
    while [ $# -gt 0 ]; do
        case $1 in
            -w|--with) [ $# -ge 2 ] && { printf '%s\n' "$2"; shift; } ;;
            -w=*|--with=*) printf '%s\n' "${1#*=}" ;;
        esac
        shift
    done
}

# first_build_positional ARGS...: echo the first non-flag token (the TARGET
# candidate), skipping build flags and the values of value-taking ones. Empty
# (return 1) if there is no positional. Used host-side only to decide what to
# clone / where to set the container workdir; the container does authoritative
# resolution.
first_build_positional() {
    while [ $# -gt 0 ]; do
        case $1 in
            -w|--with|-x|--without|--flash-size)
                shift; [ $# -gt 0 ] && shift ;;
            --) shift; [ $# -gt 0 ] && { printf '%s\n' "$1"; return 0; }; return 1 ;;
            -*) shift ;;
            *) printf '%s\n' "$1"; return 0 ;;
        esac
    done
    return 1
}

# default_straddle: if the user is at the workspace root and the last build's
# target (.spangap-build) resolves to a present straddle, echo its host dir.
# Returns 1 silently otherwise. No buildable check — caller decides whether
# that matters.
default_straddle() {
    [ -n "${workspace:-}" ] || return 1
    [ "$PWD" = "$workspace" ] || return 1
    local t
    t=$(remembered_build_target) || return 1
    project_host_dir "$t"
}

# require_straddle: cmd-name → straddle-dir on stdout, or die.
require_straddle() {
    local cmd=$1
    local s
    if s=$(find_straddle); then
        case $s in
            "$workspace"|"$workspace"/*) ;;
            *) die "straddle $s is not under workspace $workspace" ;;
        esac
        printf '%s\n' "$s"
        return 0
    fi
    # No straddle at/above cwd. From the workspace root, default to the target
    # of the last build (.spangap-build). Any straddle can be a build target
    # (no buildable gate); for a different one, cd into it or name it on a
    # `spangap build <org/repo>` — we don't guess.
    if [ "$PWD" = "$workspace" ]; then
        local t dir
        if t=$(remembered_build_target); then
            dir=$(project_host_dir "$t") \
                || die ".spangap-build names target '$t' but no straddle.yaml for it under $workspace or <straddles> — \`spangap build $t\` to (re)acquire it"
            printf '%s\n' "$dir"
            return 0
        fi
    fi
    die "not inside a straddle (no straddle.yaml at/above $PWD) and no remembered build — cd into the straddle you want to $cmd, or \`spangap build <org/repo>\`"
}

# Pick the dir that holds the IDF project's CMakeLists.txt. Same rule as the
# old shim: try esp-idf/, then ., then idf/. Parsing YAML in shell isn't worth
# the trouble for one lookup.
resolve_firmware_dir() {
    local p=$1 sub
    for sub in esp-idf "" idf; do
        if [ -f "$p${sub:+/$sub}/CMakeLists.txt" ]; then
            printf '%s\n' "$p${sub:+/$sub}"
            return 0
        fi
    done
    return 1
}

# ---------------------------------------------------------------------------
# Sticky $SPANGAP_PORT + device endpoints via workspace-root state files.
# ---------------------------------------------------------------------------

# Port path is per-host (e.g. /dev/cu.usbmodem* on macOS vs /dev/ttyUSB*
# on Linux), so a workspace shared across hosts needs one sticky-port
# file per host.
PORT_FILE="$workspace/.spangap-port-$(uname -s)-$(uname -m)"

# Device endpoints, workspace-wide (the device address is the same from
# anywhere). `spangap cli` prefers ssh, then the TCP CLI; `spangap monitor`
# owns the host-side bridge that fronts these. Each holds "<host-or-ip>:<port>".
SSH_FILE="$workspace/.spangap-ssh"   # ssh, default port 22
TCP_FILE="$workspace/.spangap-tcp"   # TCP CLI, default port 2323

# Host-side LAN bridge (see start_bridge). Script is workspace-wide (static
# content); pid/log are per-host since the bridge is a host-local process — a
# workspace shared across machines would otherwise clash on one pidfile.
FORWARD_SCRIPT="$workspace/.spangap-forward.py"
FORWARD_PID="$workspace/.spangap-forward-$(uname -s)-$(uname -m).pid"
FORWARD_LOG="$workspace/.spangap-forward-$(uname -s)-$(uname -m).log"

# Local straddles override: $workspace/.spangap-straddles holds one host path —
# a flat checkout whose <repo>/ children are the straddles. Instead of
# git-cloning, the whole tree is bind-mounted to /straddles inside the container,
# so the build runs against your working tree without round-tripping through
# github. Written by `spangap init --straddles <dir>`; empty/missing file or
# a path that no longer exists ⇒ silently disabled (fall through to git
# clone as before).
STRADDLES_FILE="$workspace/.spangap-straddles"
read_straddles() {
    [ -f "$STRADDLES_FILE" ] || return 0
    local p
    p=$(head -1 "$STRADDLES_FILE" 2>/dev/null)
    # Trim surrounding whitespace.
    p=${p#"${p%%[![:space:]]*}"}
    p=${p%"${p##*[![:space:]]}"}
    [ -z "$p" ] && return 0
    [ -d "$p" ] || return 0
    printf '%s\n' "$p"
}

# read_or_die <file> <env-var-name> <cmd> <thing>: explicit env wins, else
# state file, else die.
sticky_get() {
    local file=$1 env=$2 cmd=$3 thing=$4
    if [ -n "${!env:-}" ]; then printf '%s\n' "${!env}"; return; fi
    [ -f "$file" ] && { cat "$file"; return; }
    die "no $thing — pass one explicitly first to persist it"
}

sticky_set() {
    printf '%s\n' "$2" > "$1"
}

# Parse "<host>:<port>" (port optional) into the globals EP_HOST / EP_PORT.
# Splits on the LAST colon when the tail is all digits; bracketed IPv6 literals
# ("[::1]:22") keep their inner colons. A bare host keeps the supplied default.
parse_endpoint() {
    local text=$1 default=$2 host port
    text=$(printf '%s' "$text" | tr -d ' \t\n')
    case $text in
        \[*\]*)  host=${text#\[}; host=${host%%\]*}
                 port=${text##*\]}; port=${port#:}
                 [ -n "$port" ] || port=$default ;;
        *:[0-9]*) port=${text##*:}; host=${text%:*}
                 case $port in *[!0-9]*) host=$text; port=$default ;; esac ;;
        *)       host=$text; port=$default ;;
    esac
    EP_HOST=$host; EP_PORT=$port
}

# ---------------------------------------------------------------------------
# Host-side LAN bridge, owned by `spangap monitor` (defined here, above the
# command dispatch, because the monitor path runs before the docker section).
# ---------------------------------------------------------------------------

# Drop the pure-stdlib python TCP relay to disk (idempotent — content is
# static, so an unconditional rewrite is cheaper than a compare). Args are
# "<dhost>:<port>" specs; it listens on 0.0.0.0:<port> and splices each accepted
# connection to <dhost>:<port> (same port number). Bind 0.0.0.0 (not loopback)
# so Docker Desktop's host.docker.internal gateway can reach it; this is a dev
# relay to a device already on the LAN, so it widens nothing. Threads, no deps.
write_forward_script() {
    cat > "$FORWARD_SCRIPT" <<'PY'
import socket, sys, threading, signal

def pipe(src, dst):
    try:
        while True:
            data = src.recv(65536)
            if not data:
                break
            dst.sendall(data)
    except OSError:
        pass
    finally:
        try: dst.shutdown(socket.SHUT_WR)
        except OSError: pass

def handle(client, dhost, dport):
    try:
        up = socket.create_connection((dhost, dport), timeout=10)
    except OSError as e:
        print(f"spangap-forward: {dhost}:{dport}: {e}", flush=True)
        client.close()
        return
    t = threading.Thread(target=pipe, args=(client, up), daemon=True)
    t.start()
    pipe(up, client)
    client.close(); up.close()

def serve(lport, dhost, dport):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        srv.bind(("0.0.0.0", lport))
    except OSError as e:
        print(f"spangap-forward: bind :{lport}: {e}", flush=True)
        return
    srv.listen(64)
    while True:
        try:
            client, _ = srv.accept()
        except OSError:
            return
        threading.Thread(target=handle, args=(client, dhost, dport),
                         daemon=True).start()

# Each arg is "<dhost>:<port>" — listen on :port, splice to dhost:port.
specs = []
for a in sys.argv[1:]:
    dhost, _, p = a.rpartition(":")
    specs.append((dhost, int(p)))
for dhost, p in specs:
    threading.Thread(target=serve, args=(p, dhost, p), daemon=True).start()
print(f"spangap-forward: relaying {specs}", flush=True)
signal.pause()
PY
}

# A container on Docker Desktop can't route to the Mac's LAN segment — "host"
# networking is the VM's namespace and gvproxy proxies internet egress but not
# the host's local subnet (see the docker run comment). So the in-container
# `spangap cli` reaches the device by connecting to host.docker.internal:<port>,
# where this bridge — running on the Mac, the one machine actually on that LAN —
# accepts and splices to the device. It forwards whatever endpoints are
# configured in .spangap-ssh (ssh) and .spangap-tcp (TCP CLI). Darwin-only — on a
# native Linux host the bridge network reaches the LAN directly, so it's a no-op.

# bridge_specs: emit one "<dhost>:<port>" line per configured endpoint.
bridge_specs() {
    local f
    for f in "$SSH_FILE" "$TCP_FILE"; do
        [ -f "$f" ] || continue
        case $f in *-ssh) parse_endpoint "$(cat "$f")" 22 ;; *) parse_endpoint "$(cat "$f")" 2323 ;; esac
        printf '%s:%s\n' "$EP_HOST" "$EP_PORT"
    done
}

# start_bridge: bring up (or refresh) the forwarder for the configured endpoints.
# Idempotent: a re-run is a liveness check and only restarts when the spec set
# changed. The pidfile is two lines: pid, then the space-joined spec set.
start_bridge() {
    [ "$(uname -s 2>/dev/null)" = Darwin ] || return 0
    local specs want
    specs=$(bridge_specs | tr '\n' ' '); specs=${specs% }
    [ -z "$specs" ] && return 0          # nothing configured yet
    want=$specs

    if [ -f "$FORWARD_PID" ]; then
        local pid have
        pid=$(sed -n 1p "$FORWARD_PID" 2>/dev/null)
        have=$(sed -n 2p "$FORWARD_PID" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            [ "$have" = "$want" ] && return 0
            kill "$pid" 2>/dev/null || true   # endpoints changed — restart
        fi
    fi

    command -v python3 >/dev/null 2>&1 || {
        log "skipping LAN bridge: python3 not on PATH"
        return 0
    }
    write_forward_script
    # shellcheck disable=SC2086
    nohup python3 "$FORWARD_SCRIPT" $specs >"$FORWARD_LOG" 2>&1 &
    local pid=$!
    printf '%s\n%s\n' "$pid" "$want" > "$FORWARD_PID"
    log "LAN bridge up (pid $pid): host.docker.internal → $specs"
}

# stop_bridge: tear the forwarder down (called on `spangap monitor` exit).
stop_bridge() {
    [ -f "$FORWARD_PID" ] || return 0
    local pid; pid=$(sed -n 1p "$FORWARD_PID" 2>/dev/null)
    [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
    rm -f "$FORWARD_PID"
}

# ---------------------------------------------------------------------------
# Port-busy probe. Lets `flash` decide between flashing locally and just
# signalling a remote `monitor` via flashme.
# ---------------------------------------------------------------------------
port_busy() {
    # If the path doesn't exist, no one's holding it open by definition.
    # (lsof on Linux silently treats a nonexistent path as a no-op pattern
    # and lists ALL open files, exiting 0 — looks like "busy" but isn't.)
    [ -e "$1" ] || return 1
    if command -v lsof >/dev/null 2>&1; then
        lsof -t -- "$1" >/dev/null 2>&1
    elif command -v fuser >/dev/null 2>&1; then
        fuser -s "$1" 2>/dev/null
    else
        return 1
    fi
}

# ---------------------------------------------------------------------------
# Flash + monitor inner loop. Absorbs scripts/flasher's daemon mode.
# ---------------------------------------------------------------------------

kill_monitor() {
    # esp-idf-monitor has no console script — we invoke it via
    # `python -m esp_idf_monitor`, so the module name (underscored) is
    # what appears in /proc/*/cmdline. Pattern accepts either spelling
    # in case a future version ships a script.
    #
    # Anchor on the leading executable so we kill ONLY the python child,
    # not the `script -q $fifo <python> -m esp_idf_monitor ...` wrapper
    # (whose own argv contains the python invocation as a substring).
    # SIGTERMing `script` directly makes the parent bash print
    # "Terminated: 15" when its subshell dies by signal; killing only the
    # child lets script exit cleanly with the child's status, no message.
    pkill -f '^[^ ]*python[^ ]* -m esp[-_]idf[-_]monitor' 2>/dev/null || true
}

# Toolchain binaries we'll accept inside the container, in priority order.
# esp-idf-monitor always shells out to `xtensa-esp32-elf-addr2line` (its
# hardcoded default prefix — spangap doesn't pass --toolchain-prefix), but
# ESP-IDF v5.x ships the *unified* xtensa toolchain, whose binary is actually
# `xtensa-esp-elf-addr2line`. addr2line just reads DWARF line tables, so the
# unified build decodes an esp32/s2/s3 ELF fine. We probe these names and shim
# whichever exists to the fixed name the monitor calls.
_A2L_CANDIDATES='xtensa-esp32-elf-addr2line xtensa-esp-elf-addr2line xtensa-esp32s3-elf-addr2line xtensa-esp32s2-elf-addr2line'

# ensure_addr2line_shim: drop a host-side `xtensa-esp32-elf-addr2line` that
# forwards to the toolchain inside the build-env container. esp-idf-monitor's
# panic decoder shells out to that name (via PATH) to turn a crash backtrace
# into file:line. The toolchain only exists inside the linux build-env
# container — on a Mac (or any host without the ESP toolchain) it's nowhere on
# PATH, so backtraces stay as raw hex. This shim bridges the gap by
# docker-exec'ing the container's copy, rewriting the ELF path argument to its
# container mount point on the way through.
#
# Best-effort: it needs a *running* container to resolve the toolchain path and
# to serve the exec calls. We don't spin one up just for decode — if none is
# running (or the toolchain can't be resolved) we remove any stale shim and
# return 0, leaving the monitor to run exactly as before (live log, no stack
# decode). Regenerated on every `spangap monitor` so the baked container /
# toolchain path can't go stale. Echoes one of: "ok", "nocontainer", "notool".
ensure_addr2line_shim() {
    local shim="$SHIM_DIR/xtensa-esp32-elf-addr2line"
    if ! docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null | grep -q true; then
        rm -f "$shim" 2>/dev/null || true
        printf 'nocontainer\n'; return 0
    fi
    # Resolve the real toolchain binary once (sourcing export.sh puts it on
    # PATH). Bake the absolute path into the shim so each call is a bare docker
    # exec with no per-call env setup.
    local a2l
    a2l=$(docker exec "$container" bash -lc '
        . "$IDF_PATH/export.sh" >/dev/null 2>&1
        for c in '"$_A2L_CANDIDATES"'; do
            p=$(command -v "$c" 2>/dev/null) && { printf "%s\n" "$p"; exit 0; }
        done
        exit 1' 2>/dev/null) || a2l=""
    if [ -z "$a2l" ]; then
        rm -f "$shim" 2>/dev/null || true
        printf 'notool\n'; return 0
    fi
    # Translate against what the *container* actually has mounted, not the
    # current .spangap-straddles. The /straddles bind mount is fixed when the
    # container is created and recorded in its org.spangap.straddles label;
    # the .spangap-straddles file can drift from it (toggling --straddles on/off,
    # or comparing both modes, without `spangap reset-workspace`). Translating against the
    # file instead of the live mount would hand the container a path that isn't
    # mounted there → addr2line can't open the ELF → silent no-decode. The label
    # is the source of truth.
    local sd
    sd=$(docker inspect -f '{{ index .Config.Labels "org.spangap.straddles" }}' \
        "$container" 2>/dev/null) || sd=""
    mkdir -p "$SHIM_DIR"
    {
        printf '%s\n' '#!/bin/bash'
        printf '%s\n' '# AUTO-GENERATED by spangap-outside (ensure_addr2line_shim). Forwards to the'
        printf '%s\n' '# build-env toolchain so esp-idf-monitor can decode panic backtraces on a'
        printf '%s\n' '# host with no native ESP toolchain. Regenerated each `spangap monitor`.'
        printf '%s\n' 'set -e'
        printf 'container=%q\n' "$container"
        printf 'a2l=%q\n' "$a2l"
        printf 'workspace=%q\n' "$workspace"
        printf 'container_ws=%q\n' "$container_ws"
        printf 'straddles=%q\n' "$sd"
        cat <<'SHIM'
# addr2line's only path argument is the ELF (-e <path>); bare addresses pass
# through untouched. Rewrite any arg that lives under the workspace / straddles
# checkout to its container mount ($container_ws/... or /straddles/...).
args=()
for a in "$@"; do
    case $a in
        "$workspace")   args+=("$container_ws") ;;
        "$workspace"/*) args+=("$container_ws/${a#"$workspace"/}") ;;
        *)
            if [ -n "$straddles" ] && { [ "$a" = "$straddles" ] || case $a in "$straddles"/*) true ;; *) false ;; esac; }; then
                [ "$a" = "$straddles" ] && args+=(/straddles) || args+=("/straddles/${a#"$straddles"/}")
            else
                args+=("$a")
            fi
            ;;
    esac
done
exec docker exec -i "$container" "$a2l" "${args[@]}"
SHIM
    } > "$shim"
    chmod +x "$shim"
    printf 'ok\n'
}

# run_monitor <port> <fw> <log> [extra-flags]: foreground esp-idf-monitor in
# a PTY, tee-stripped to <log>. Returns when monitor exits (Ctrl-], or
# someone kills it — the watcher below does that on flashme).
run_monitor() {
    local port=$1 fw=$2 log=$3 extra=${4:-}
    local fifo=/tmp/spangap-flash.$$.$RANDOM.fifo
    mkfifo "$fifo"
    # Stripped stream to file ONLY when we have a workspace to log into.
    # `script` already pumps the PTY back to the terminal in colour; tee'ing
    # the stripped stream there too duplicates every line.
    local stripper=""
    if [ -n "$log" ]; then
        perl -pe 'BEGIN{$|=1} s/\e\[[0-9;?]*[a-zA-Z]//g' < "$fifo" > "$log" &
        stripper=$!
    else
        # No log target — drain the fifo into /dev/null so the writer doesn't block.
        cat "$fifo" >/dev/null &
        stripper=$!
    fi
    # Find the app ELF for panic-backtrace symbolication. It's the only
    # .elf at build/ root (bootloader/partition ELFs live in subdirs).
    # Optional — esp-idf-monitor still runs without one. Skipped when we
    # have no firmware dir (warning was printed at startup).
    local elf=""
    if [ -n "$fw" ]; then
        for e in "$fw/build"/*.elf; do
            [ -f "$e" ] && { elf=$e; break; }
        done
    fi
    (
        # esp-idf-monitor calls os.getcwd() at import time (config loader);
        # if the user's shell is sitting in a since-deleted dir, that raises
        # FileNotFoundError before monitor can even start. Land in $HOME (or
        # / if HOME is gone too) before the per-straddle cd below.
        cd "${HOME:-/}" 2>/dev/null || cd /
        [ -n "$fw" ] && cd "$fw"
        # Put the addr2line shim on PATH so esp-idf-monitor's panic decoder
        # finds it (no-op if ensure_addr2line_shim skipped — dir just absent).
        export PATH="$SHIM_DIR:$PATH"
        # shellcheck disable=SC2086
        # exec so the subshell IS script — no parent bash to print
        # "Terminated: 15" when kill_monitor SIGTERMs us on reflash. The
        # || true is moot under exec; kept on the outer subshell. 2>/dev/null
        # absorbs any residual job-control chatter on platforms that emit it
        # despite the exec.
        exec script -q "$fifo" "$VENV/bin/python" -m esp_idf_monitor -p "$port" ${extra} ${elf:+"$elf"}
    ) 2>/dev/null || true
    # `script` puts the tty in raw mode; if it's killed by signal (see
    # kill_monitor) it doesn't always restore ONLCR etc. Re-sanitise so the
    # next log lines don't staircase down the screen.
    [ -t 1 ] && stty sane 2>/dev/null || true
    wait "$stripper" 2>/dev/null || true
    rm -f "$fifo"
}

# do_flash <port> <fw> <log>: read flasher_args.json, esptool, return 0/1.
do_flash() {
    local port=$1 fw=$2 log=$3
    local args_json="$fw/build/flasher_args.json"
    if [ ! -f "$args_json" ]; then
        log "no build artifacts at $args_json"
        echo "         run \`spangap build\` first" >&2
        return 1
    fi

    : > "$log"
    kill_monitor
    sleep 0.3

    local chip baud before after
    read -r chip baud before after < <(python3 - "$args_json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
ex = d.get("extra_esptool_args", {})
print(
    ex.get("chip", "auto"),
    ex.get("baud", 460800),
    ex.get("before", "default_reset"),
    ex.get("after", "hard_reset"),
)
PY
    )

    local -a wf_args=()
    while IFS= read -r line; do wf_args+=("$line"); done < <(python3 - "$args_json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
out = list(d.get("write_flash_args", []))
ff = d.get("flash_files") or {}
for offset, fname in sorted(ff.items(), key=lambda kv: int(kv[0], 16)):
    out += [offset, fname]
for a in out: print(a)
PY
    )
    if [ "${#wf_args[@]}" -eq 0 ]; then
        log "flasher_args.json has no flash_files"
        return 1
    fi

    log "chip=$chip port=$port baud=$baud project=$fw"
    local rc=0
    (
        cd "$fw/build"
        "$VENV/bin/esptool.py" --chip "$chip" -p "$port" -b "$baud" \
            --before "$before" --after "$after" \
            write_flash "${wf_args[@]}"
    ) 2>&1 | tee /tmp/spangap-esptool.log
    rc=${PIPESTATUS[0]}

    if [ "$rc" -ne 0 ]; then
        mv /tmp/spangap-esptool.log "$log"
        log "esptool failed (rc=$rc); see $log"
        return 1
    fi
    rm -f /tmp/spangap-esptool.log
    return 0
}

# monitor_loop <port> <fw> <initial_flash:1|0>: forever — passively monitor
# until .spangap-flashme appears (then flash + re-monitor) or .spangap-resetme
# appears (then restart the monitor with the device reset, no reflash).
# Ctrl-C / TERM bails cleanly.
monitor_loop() {
    local port=$1 fw=$2 do_initial=$3
    # Signal + log files live at the workspace root so the host and the
    # in-container `spangap flash` reach them identically ($workspace/... vs
    # $container_ws/...), and so the stripped-output log target always exists (the
    # workspace dir is always present, unlike a not-yet-built build/).
    #   .spangap-flashme  request a reflash
    #   .spangap-resetme  request a monitor restart that resets the device
    #   .spangap-ping     readiness probe — deleted on sight, nothing else; its
    #                     disappearance is how in-container `spangap show` learns
    #                     a monitor is running and able to flash
    #   .spangap-log      stripped monitor / esptool output
    # Flashing still needs a firmware dir (build artifacts); the resetme restart
    # and the live monitor both work without one.
    local flashme="$workspace/.spangap-flashme"
    local resetme="$workspace/.spangap-resetme"
    local ping="$workspace/.spangap-ping"
    local log="$workspace/.spangap-log"

    trap 'kill_monitor; exit 0' INT TERM
    # Don't drop a present flashme on startup: a pending signal from another
    # host is exactly when this loop is supposed to flash.

    local pending=$do_initial
    while true; do
        local reset_flags="--no-reset"
        if [ -f "$resetme" ]; then
            # Restart the monitor with the device reset (clean boot capture),
            # no reflash. Remove the trigger up front so the watcher below
            # doesn't instantly re-fire on it.
            rm -f "$resetme"
            reset_flags=""
        elif [ "$pending" = "1" ] || [ -f "$flashme" ]; then
            local rm_pid=""
            if [ -f "$flashme" ]; then
                # Hand the 3s grace + removal to a detached shell so the flash
                # starts now instead of waiting it out; the window only lets
                # other hosts' flashers latch the same signal before it goes.
                ( sleep 3; rm -f "$flashme" ) &
                rm_pid=$!
            fi
            if [ -n "$fw" ] && do_flash "$port" "$fw" "$log"; then
                reset_flags=""
                sleep 2
            else
                [ -n "$fw" ] || log "flashme seen but not in a straddle — can't flash (no build artifacts)"
                sleep 2
                pending=0
                continue
            fi
            pending=0
            # The flash already ran alongside the grace period; make sure the
            # consumed flashme is gone before arming the watcher so it doesn't
            # instantly re-fire. Rarely blocks (do_flash outlasts the 3s).
            [ -n "$rm_pid" ] && wait "$rm_pid" 2>/dev/null || true
        fi

        # Watcher: nuke the running monitor the instant either signal appears,
        # so the next loop iteration consumes it (reflash or reset-restart).
        ( while [ ! -f "$flashme" ] && [ ! -f "$resetme" ]; do
              # Answer readiness probes without disturbing the live monitor:
              # delete the ping and keep polling (no kill_monitor, no break).
              [ -f "$ping" ] && rm -f "$ping"
              sleep 1
          done
          kill_monitor
        ) &
        local watcher=$!

        if [ -n "$reset_flags" ]; then
            if [ -n "$fw" ]; then
                log "passive monitor (--no-reset; Ctrl-] exits, \`spangap flash\` re-flashes)"
            else
                log "passive monitor (--no-reset; Ctrl-] exits)"
            fi
        else
            log "monitor (Ctrl-] exits, \`spangap flash\` re-flashes)"
        fi
        # Start a fresh logfile on every monitor (re)start — initial attach,
        # post-flash, or post-reset — so .spangap-log always reflects only the
        # current boot. run_monitor's perl redirect also opens $log with `>`,
        # but truncate here explicitly so the guarantee doesn't ride on that
        # side effect (and holds even if a start path ever skips the stripper).
        : > "$log"
        run_monitor "$port" "$fw" "$log" "$reset_flags"

        # A signal present means the watcher killed monitor to drive the next
        # iteration — keep looping so it gets consumed. Otherwise the user
        # (Ctrl-]) or the hardware ended the monitor; don't fight them — exit
        # so a single Ctrl-] actually quits.
        if [ -f "$flashme" ] || [ -f "$resetme" ]; then
            wait "$watcher" 2>/dev/null || true
            sleep 1
            continue
        fi
        kill "$watcher" 2>/dev/null || true
        wait "$watcher" 2>/dev/null || true
        log "monitor exited — bye"
        return 0
    done
}

# ---------------------------------------------------------------------------
# Command dispatch (outside).
# ---------------------------------------------------------------------------

case ${1:-} in
ensure-venv)
    ensure_venv
    exit 0
    ;;
# NOTE: `reset` is intentionally NOT handled here. It now lives in
# spangap-inside (it must work from inside the container too, reached via
# `spangap docker claude`), so we let it fall through to the in-container
# dispatch below — `ensure_container` then `docker exec ... spangap reset`,
# which touches the same workspace-root .spangap-resetme marker. (Tearing the
# workspace's container/image down is still the host-only `spangap
# reset-workspace`.)
flash)
    shift
    proj=$(require_straddle flash)
    if [ $# -gt 0 ]; then
        port=$1; shift
        sticky_set "$PORT_FILE" "$port"
    else
        port=$(sticky_get "$PORT_FILE" SPANGAP_PORT flash "serial port")
    fi
    fw=$(resolve_firmware_dir "$proj") \
        || die "no CMakeLists.txt in $proj or its esp-idf/ subdir"
    flashme="$workspace/.spangap-flashme"
    if port_busy "$port"; then
        touch "$flashme"
        log "$port busy — signaled $flashme; waiting for a monitor to pick it up..."
        for _ in 1 2 3 4 5; do
            sleep 1
            [ -f "$flashme" ] || { log "flashing."; exit 0; }
        done
        die "$port was busy but nobody is flashing when I signal to. Start \`spangap monitor\` on a host with the port."
    fi
    ensure_venv
    # Flash once and exit. To watch the device afterwards, chain a monitor:
    #   spangap flash <port> && spangap monitor
    do_flash "$port" "$fw" "$workspace/.spangap-log" || exit 1
    # We just flashed directly, so clear any pending flashme — otherwise a
    # monitor that starts later would treat the stale signal as a fresh
    # reflash request and re-flash a board that's already current. (The
    # monitor loop consumes flashme itself on the signalled path; this covers
    # the port-free direct flash, which never goes through it.)
    rm -f "$flashme"
    exit 0
    ;;
monitor)
    shift
    # monitor stays useful outside a straddle: you lose stack decode + the
    # flashme reflash signal, but the live log is still worth attaching to.
    # Warn loudly so the user knows what they're giving up.
    #
    # Resolution order:
    #   1. straddle.yaml at/above cwd (must be under workspace)
    #   2. workspace-root invocation falls back to the last build's target
    #      (.spangap-build; same default flash/build use via require_straddle)
    #   3. neither → "no straddle context" warning, monitor still attaches
    proj=""
    if cand=$(find_straddle 2>/dev/null) \
        && case $cand in "$workspace"|"$workspace"/*) true ;; *) false ;; esac; then
        proj=$cand
    elif cand=$(default_straddle 2>/dev/null); then
        proj=$cand
    fi
    if [ -n "$proj" ]; then
        fw=$(resolve_firmware_dir "$proj") \
            || die "no CMakeLists.txt in $proj or its esp-idf/ subdir"
    else
        log "Warning: not in a straddle dir — cannot decode stack on crash, cannot be signalled to flash."
        fw=""
    fi
    if [ $# -gt 0 ]; then
        port=$1; shift
        sticky_set "$PORT_FILE" "$port"
    else
        port=$(sticky_get "$PORT_FILE" SPANGAP_PORT monitor "serial port")
    fi
    port_busy "$port" && die "$port is busy — another monitor/flasher owns it"
    ensure_venv
    # Wire up panic-backtrace decode: a host `xtensa-esp32-elf-addr2line` shim
    # that forwards to the build-env toolchain. Needs a straddle (for the ELF)
    # and a running container; otherwise it's a graceful no-op.
    if [ -n "$fw" ]; then
        case $(ensure_addr2line_shim) in
            nocontainer) log "note: build-env container not running — panic backtraces won't decode to file:line (run a build, or \`spangap ensure-container\`, first)" ;;
            notool)      log "note: no xtensa addr2line found in the build-env container — backtraces won't decode" ;;
        esac
    fi
    # The monitor owns the host-side bridge: bring it up for whatever endpoints
    # are configured (.spangap-ssh / .spangap-tcp), and tear it down on exit
    # (Ctrl-], INT/TERM via monitor_loop's `exit 0`, or normal return all fire
    # the EXIT trap). Darwin-only inside start_bridge/stop_bridge.
    trap stop_bridge EXIT
    start_bridge
    monitor_loop "$port" "$fw" 0
    exit 0
    ;;
probe)
    # Identify the chip + flash size of a connected device. Useful for
    # picking the right `spangap build --flash-size <MB>` for generic builds.
    shift
    if [ $# -gt 0 ]; then
        port=$1; shift
        sticky_set "$PORT_FILE" "$port"
    else
        port=$(sticky_get "$PORT_FILE" SPANGAP_PORT probe "serial port")
    fi
    port_busy "$port" && die "$port is busy — another monitor/flasher owns it"
    ensure_venv
    if ! out=$("$VENV/bin/esptool.py" -p "$port" flash_id 2>&1); then
        printf '%s\n' "$out" >&2
        die "esptool flash_id failed on $port"
    fi
    chip=$(printf '%s\n' "$out" | sed -n 's/^Chip is //p' | head -1)
    crystal=$(printf '%s\n' "$out" | sed -n 's/^Crystal is //p' | head -1)
    mac=$(printf '%s\n' "$out" | sed -n 's/^MAC: //p' | head -1)
    flash=$(printf '%s\n' "$out" | sed -n 's/^Detected flash size: //p' | head -1)
    flash_mb=$(printf '%s' "$flash" | sed -n 's/^\([0-9]*\)MB$/\1/p')
    printf '\n'
    printf 'Port:        %s\n' "$port"
    printf 'Chip:        %s\n' "${chip:-unknown}"
    [ -n "$crystal" ] && printf 'Crystal:     %s\n' "$crystal"
    [ -n "$mac" ]     && printf 'MAC:         %s\n' "$mac"
    printf 'Flash size:  %s\n' "${flash:-unknown}"
    if [ -n "$flash_mb" ]; then
        printf '\nBuild with:  spangap build --flash-size %s\n' "$flash_mb"
    else
        printf '\n%s: could not parse flash size from esptool output\n' "$PFX" >&2
    fi
    exit 0
    ;;
cli)
    shift
    while [ $# -gt 0 ]; do
        case $1 in
            -h) [ $# -ge 2 ] || die "-h needs a hostname"
                parse_endpoint "$2" 22
                printf '%s:%s\n' "$EP_HOST" "$EP_PORT" > "$SSH_FILE"
                shift 2 ;;
            --) shift; break ;;
            *)  break ;;
        esac
    done

    # ssh first, then the legacy TCP CLI, else bootstrap. On the host we sit on
    # the device's LAN, so dial it directly — no host.docker.internal bridge
    # (that's the in-container path).
    if [ -f "$SSH_FILE" ]; then
        parse_endpoint "$(cat "$SSH_FILE")" 22
        exec ssh -p "$EP_PORT" \
            -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
            -o ConnectTimeout=10 "$EP_HOST" "$@"
    fi

    if [ ! -f "$TCP_FILE" ]; then
        # Bootstrap: generate a key (no passphrase, no prompts), ask for the
        # device, persist .spangap-ssh, and print the line to authorize the key
        # in the device serial monitor.
        key="$HOME/.ssh/id_ed25519"
        [ -f "$key" ] || { mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
            ssh-keygen -t ed25519 -N "" -f "$key" -q; }
        printf 'spangap cli: device hostname or IP: ' >&2
        read -r dhost
        [ -n "$dhost" ] || die "no host entered"
        parse_endpoint "$dhost" 22
        printf '%s:%s\n' "$EP_HOST" "$EP_PORT" > "$SSH_FILE"
        printf '\nWrote %s → %s:%s\n\n' ".spangap-ssh" "$EP_HOST" "$EP_PORT"
        printf 'Now, in the device serial monitor, authorize this key:\n\n'
        printf '    sshd add %s\n\n' "$(cat "$key.pub")"
        printf 'sshd is enabled by default; on an older build also run: sshd enable\n'
        printf 'If sshd is not in your build, rebuild with: spangap build --with spangap/sshd\n'
        printf '\nThen re-run `spangap cli` to connect over ssh.\n'
        exit 0
    fi

    parse_endpoint "$(cat "$TCP_FILE")" 2323
    host=$EP_HOST
    cli_port=${SPANGAP_CLI_PORT:-$EP_PORT}
    # Pure-Python TCP CLI — no docker, no IDF, just a socket. Mirrors the
    # in-container `spangap cli` so dev experience is the same from either
    # side.
    exec python3 - "$host" "$cli_port" "$@" <<'PY'
import os, socket, sys, selectors
PROMPT = b"$ "
host = sys.argv[1]
port = int(sys.argv[2])
argv = sys.argv[3:]
try:
    s = socket.create_connection((host, port), timeout=10)
except OSError as e:
    sys.exit(f"spangap cli: connect {host}:{port}: {e}")
s.settimeout(None)

def drain_until_prompt(sock):
    buf = b""
    while not buf.endswith(PROMPT):
        d = sock.recv(4096)
        if not d: break
        buf += d
    return buf

if argv:
    drain_until_prompt(s)
    s.sendall((" ".join(argv) + "\n").encode())
    out = drain_until_prompt(s)
    # Filter the trailing prompt line. drain returns the moment the buffer ends
    # with the prompt, and that prompt is a whole line — "<name> $ " (e.g.
    # "reticulous $ "), not a bare "$ " — so the final line is always the
    # re-emitted prompt. Drop everything after the last newline; none ⇒ the
    # whole response was just the prompt.
    nl = out.rfind(b"\n")
    out = out[:nl + 1] if nl != -1 else b""
    sys.stdout.buffer.write(out); sys.stdout.flush()
    sys.exit(0)

sel = selectors.DefaultSelector()
sel.register(sys.stdin, selectors.EVENT_READ)
sel.register(s, selectors.EVENT_READ)
try:
    while True:
        for key, _ in sel.select():
            if key.fileobj is sys.stdin:
                data = sys.stdin.buffer.read1(4096)
                if not data: sys.exit(0)
                s.sendall(data)
            else:
                data = s.recv(4096)
                if not data: sys.exit(0)
                sys.stdout.buffer.write(data); sys.stdout.flush()
except KeyboardInterrupt:
    pass
PY
    ;;
esac

# ---------------------------------------------------------------------------
# Docker daemon + container management. Everything below this point needs
# the build-env container running.
# ---------------------------------------------------------------------------

# ws_hash / container are defined up in the config section (the monitor path
# needs them before this point).
# Persistent per-user home: a single bind mount at /home/spangap inside
# the container. `pip install --user`, `npm install -g`, ccache, the
# Claude CLI's auth + history, shell history, dotfiles — everything that
# would normally live in $HOME persists across container recreations and
# is shared across workspaces. spangap_home is created on demand below.
spangap_home="${HOME}/.spangap"

# In SPANGAP_QUIET mode, ensure_container prints a single
# "setting up Docker container" line at its first real work step
# (image rebuild, container recreate, etc.) instead of the verbose
# "stale image — rebuilding" / "building $IMAGE..." / docker build
# output. No-op outside quiet mode and after the first call.
SPANGAP_SETUP_ANNOUNCED=0
announce_container_setup() {
    [ -z "$SPANGAP_QUIET" ] && return
    [ "$SPANGAP_SETUP_ANNOUNCED" = "1" ] && return
    log "setting up Docker container"
    SPANGAP_SETUP_ANNOUNCED=1
}

ensure_daemon() {
    docker info >/dev/null 2>&1 && return 0
    if ! command -v docker >/dev/null 2>&1; then
        die "docker not on PATH. Install Docker Desktop (mac) or the docker CLI (linux) and try again."
    fi
    case $(uname -s 2>/dev/null) in
        Darwin) die "docker daemon not reachable. Start Docker Desktop and retry." ;;
        Linux)  die "docker daemon not reachable. Start it: doas service docker start  (or: sudo systemctl start docker)" ;;
        *)      die "docker daemon not reachable. Start your docker daemon and retry." ;;
    esac
}

ensure_container() {
    ensure_daemon

    # The spangap build-system straddle (Dockerfile + build-system/) is the
    # build context. With a flat --straddles checkout it lives at
    # <straddles>/spangap; without one it's git-cloned into $workspace/spangap.
    # No symlink either way — the checkout itself is the source of truth.
    local straddles
    straddles=$(read_straddles)
    local ctx="$workspace/spangap"
    [ -n "$straddles" ] && [ -d "$straddles/spangap" ] && ctx="$straddles/spangap"
    local local_hash=""
    [ -f "$ctx/build-system/Dockerfile" ] && local_hash=$(buildsys_hash "$ctx")

    # Drop a stale image before anything else — if build-system/ has changed
    # since the image was built, the container on top of it is stale too.
    if [ -n "$local_hash" ] && docker image inspect "$IMAGE" >/dev/null 2>&1; then
        local stamp
        stamp=$(docker image inspect --format \
            '{{ index .Config.Labels "org.spangap.buildsys-hash" }}' \
            "$IMAGE" 2>/dev/null) || stamp=""
        if [ "$stamp" != "$local_hash" ]; then
            announce_container_setup
            [ -z "$SPANGAP_QUIET" ] \
                && log "$IMAGE is stale (build-system/ changed since image build) — rebuilding"
            if docker inspect "$container" >/dev/null 2>&1; then
                docker rm -f "$container" >/dev/null
            fi
            docker rmi "$IMAGE" >/dev/null
        fi
    fi

    local state=missing s
    if s=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null); then
        state=$s
    fi
    case $state in
        running)
            # On macOS, recreating the host workspace dir leaves Docker
            # Desktop's grpc-fuse share pointing at the gone inode; same
            # on Linux if the workspace was rm'd + recreated under the
            # bind mount. We probe for the workspace marker file because
            # `test -d "$container_ws"` can return true even on a dangling
            # mount (the mount point's directory entry outlives the
            # underlying inode). The marker file can only be visible
            # through a live mount. --workdir / so we don't get derailed
            # by chdir into a stale workspace mount, which fails with an OCI
            # "container breakout" error before `test` ever runs.
            if docker exec --workdir / "$container" \
                    test -f "$container_ws/spangap.workspace.yaml" >/dev/null 2>&1; then
                # Also recreate if .spangap-straddles changed since the
                # container was started — the bind mount for the straddles
                # checkout is baked in at `docker run` time.
                local stored_sd
                stored_sd=$(docker inspect --format \
                    '{{ index .Config.Labels "org.spangap.straddles" }}' \
                    "$container" 2>/dev/null) || stored_sd=""
                if [ "$straddles" = "$stored_sd" ]; then
                    return 0
                fi
                announce_container_setup
                [ -z "$SPANGAP_QUIET" ] \
                    && log ".spangap-straddles changed since container start — recreating"
                docker rm -f "$container" >/dev/null
            else
                announce_container_setup
                docker rm -f "$container" >/dev/null
            fi
            ;;
        missing) ;;
        *) announce_container_setup; docker rm -f "$container" >/dev/null ;;
    esac

    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        [ -n "$local_hash" ] \
            || die "can't build $IMAGE: no Dockerfile at $ctx/build-system/Dockerfile"
        announce_container_setup
        if [ -n "$SPANGAP_QUIET" ]; then
            # Quiet build: capture the output to a temp log and only surface it
            # if the build fails (dump the whole thing in place, then drop the
            # temp file), so a one-off failure is debuggable without -v.
            local build_log="$workspace/.spangap-build-$(uname -s)-$(uname -m).log"
            if ! docker build -t "$IMAGE" \
                    --build-arg "BUILDSYS_HASH=$local_hash" \
                    -f "$ctx/build-system/Dockerfile" "$ctx" >"$build_log" 2>&1; then
                cat "$build_log" >&2
                rm -f "$build_log"
                die "docker build failed"
            fi
            rm -f "$build_log"
        else
            log "building $IMAGE (one-time, just a moment)..."
            docker build -t "$IMAGE" \
                --build-arg "BUILDSYS_HASH=$local_hash" \
                -f "$ctx/build-system/Dockerfile" "$ctx" \
                || die "docker build failed"
        fi
    fi

    announce_container_setup
    mkdir -p "$spangap_home"

    # Bind-mount the flat --straddles checkout at /straddles — one whole-tree
    # mount, so every straddle shows up at /straddles/<repo> as a real,
    # container-native dir. No symlinks and no host paths inside the container:
    # the build navigates /straddles/<repo>, and `file:../../<sibling>` resolves
    # to /straddles/<sibling> because the tree is flat. Adding/removing a straddle
    # under <straddles> needs no `spangap reset-workspace` — the whole-tree mount
    # picks it up live. (No --straddles → straddles are git-cloned as real flat
    # dirs in the workspace, covered by the workspace mount.)
    local straddles_mount=()
    [ -n "$straddles" ] && straddles_mount=(-v "$straddles:/straddles")

    # macOS still ships bash 3.2 where `${empty_array[@]}` trips `set -u`
    # with "unbound variable" — only bash 4+ treats it as zero words.
    # The `${name[@]+"${name[@]}"}` idiom expands to nothing when the
    # array is empty and to the elements otherwise, on both versions.
    #
    # No --network=host. On Docker Desktop (Mac/Windows) it's a no-op for our
    # purposes: "host" is the Linux VM's namespace, not the Mac's, so it never
    # reaches the Mac's LAN segment (e.g. the ESP32's TCP CLI) — the VM has no
    # route to it, and gvproxy proxies internet egress but not the host's local
    # subnet. The container reaches a LAN device by relaying through the Mac at
    # host.docker.internal (a host-side forwarder → device), which works on the
    # default bridge network without host networking. On a native-Linux host
    # --network=host *would* bridge to the LAN, but there the device is reachable
    # directly anyway. Either way the flag buys nothing, so it's gone.
    # The workspace mounts UNDER the persistent home (/home/spangap) at its
    # basename; Docker orders nested bind mounts by depth, so /home/spangap
    # lands first and $container_ws on top of it regardless of -v order.
    docker run -d --name "$container" \
        -v "$spangap_home:/home/spangap" \
        -v "$workspace:$container_ws" \
        ${straddles_mount[@]+"${straddles_mount[@]}"} \
        --workdir "$container_ws" \
        --label spangap.workspace="$workspace" \
        --label org.spangap.straddles="$straddles" \
        "$IMAGE" sleep infinity >/dev/null

    # Pre-create the npm prefix dir (Dockerfile sets NPM_CONFIG_PREFIX
    # but the bind mount hides any dirs the image baked into /home/spangap)
    # and align ownership with the in-container spangap user. Failures are
    # benign on Docker Desktop where the bind mount handles uid mapping
    # for us.
    docker exec -u 0 "$container" sh -c \
        'mkdir -p /home/spangap/.npm-global && chown -R spangap:spangap /home/spangap 2>/dev/null || true'
}

# Host-side require-fetching loop. Runs `spangap list-deps` inside the
# container to enumerate missing siblings, then git-clones each on the host
# (so host github auth is used — the container has no creds). Loops because
# this iteration's siblings may add their own requires:.
# Shared one-spec acquire: <org>/<repo>[@<ref>] → $workspace/<repo>. Only
# ever called for genuinely-missing deps — anything present under the
# --straddles checkout already shows up at /straddles/<repo> inside the
# container, so list-deps never reports it.
#
# --straddles mode is local-only and **never clones**: a --straddles checkout is
# a pinned set of straddles you always build against, so reaching out to github
# for a missing one would silently mix in a different copy. If the repo is in the
# checkout it's already on /straddles (no-op here); if it isn't, that's an error
# telling you to add it to your checkout — we don't fall back to a clone.
# Without --straddles, git-clone into $workspace/<repo> (a real dir the scan
# picks up). Honours SPANGAP_QUIET (single rollup line instead of one per
# repo). Used by both the explicit --with pre-fetch and the list-deps loop.
__clone_announced=0
clone_spec() {
    local spec=$1
    local bare=${spec%@*} ref=
    case $spec in *@*) ref=${spec#*@} ;; esac
    local repo=${bare#*/}
    local dest="$workspace/$repo"
    [ -e "$dest" ] && return 0
    local sd; sd=$(read_straddles)
    if [ -n "$sd" ]; then
        [ -d "$sd/$repo" ] && return 0   # already in the checkout → on /straddles
        die "$bare is not in your --straddles checkout ($sd), and --straddles mode never clones — add it to $sd and retry (or fix its straddle.yaml 'name:' if it's there under another dir name)."
    fi
    if [ -n "$SPANGAP_QUIET" ]; then
        if [ "$__clone_announced" = "0" ]; then
            log "cloning dependencies"
            __clone_announced=1
        fi
        git clone --quiet "https://github.com/${bare}.git" "$dest" >/dev/null 2>&1 \
            || die "git clone https://github.com/${bare}.git failed (host github auth set up?)"
    else
        log "cloning $bare -> $dest"
        git clone --quiet "https://github.com/${bare}.git" "$dest" \
            || die "git clone https://github.com/${bare}.git failed (host github auth set up?)"
    fi
    if [ -n "$ref" ]; then
        git -C "$dest" checkout --quiet "$ref" \
            || die "git checkout '$ref' failed in $dest"
    fi
}

# Walk `spangap build ...` argv; for each --with <org/repo> value, clone
# it onto disk before the container starts listing missing deps. Bare-form
# --with values are left for spangap-inside to validate against the
# workspace. We accept `-w X`, `--with X`, and `--with=X` forms.
prefetch_explicit_includes() {
    while [ $# -gt 0 ]; do
        case $1 in
            -w|--with)
                if [ $# -ge 2 ]; then
                    case $2 in */*) clone_spec "$2" ;; esac
                    shift 2
                else
                    shift
                fi
                ;;
            -w=*|--with=*)
                spec=${1#*=}
                case $spec in */*) clone_spec "$spec" ;; esac
                shift
                ;;
            *) shift ;;
        esac
    done
}

fetch_missing_deps() {
    local container_cwd=$1
    while :; do
        local missing
        # set -e silently swallows `x=$(failing_cmd)` failures, so we
        # explicitly handle list-deps failure with a useful die message.
        # docker exec's own stderr is left alone so the user sees the
        # actual failure (e.g. OCI "container breakout" from a stale mount)
        # before the die line below.
        missing=$(docker exec -e SPANGAP_WORKSPACE="$container_ws" --workdir "$container_cwd" "$container" spangap list-deps) \
            || die "spangap list-deps failed in container $container (see error above)"
        [ -z "$missing" ] && return 0
        for spec in $missing; do
            local bare=${spec%@*}
            local repo=${bare#*/}
            local dest="$workspace/$repo"
            if [ -e "$dest" ]; then
                die "$dest already exists, but $bare wasn't seen as a workspace sibling — wrong 'name:' in its straddle.yaml? wrong dir layout?"
            fi
            clone_spec "$spec"
        done
    done
}

# Cheap commands that don't need docker. Anything not handled here falls
# through to ensure_container + the main dispatch below.
case ${1:-} in
ensure-container)
    # Pre-build the image + create the container without running a
    # straddle build. Used by `spangap init` so the user-facing setup
    # cost lands at init time (when they're already waiting for a
    # workspace to come up) rather than mid-flow on the first build.
    ensure_container
    exit 0
    ;;
reset-workspace)
    shift
    ensure_daemon
    # reallyclean first while the container is still alive: it sweeps every
    # straddle's build/, managed_components/, node_modules/, .quasar/, etc.
    # Those artifacts live under the straddles (at /straddles/<repo> or
    # <workspace>/<repo>), so removing the container without cleaning them
    # first leaves source-realpath addresses baked into CMakeCache that
    # resurface on the next build. reallyclean is workspace-wide and needs no
    # project context, so any cwd works. Best-effort — if it fails we still
    # tear down.
    if docker inspect "$container" >/dev/null 2>&1 \
        && [ "$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null)" = "running" ]; then
        log "running reallyclean across all straddles before container teardown"
        docker exec -e SPANGAP_WORKSPACE="$container_ws" --workdir "$container_ws" "$container" \
            spangap reallyclean >/dev/null 2>&1 || true
    fi
    if docker inspect "$container" >/dev/null 2>&1; then
        log "removing container $container"
        docker rm -f "$container" >/dev/null
    fi
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        log "removing image $IMAGE"
        docker rmi "$IMAGE" >/dev/null
    fi
    # Rebuild the image and start a fresh container now, so `spangap
    # reset-workspace` hands back a ready-to-use container instead of deferring
    # first-run latency to the next command. ensure_container honours
    # SPANGAP_QUIET (set for reset-workspace up top), so docker build output
    # collapses to a single status line unless -v/--verbose.
    ensure_container
    log "reset-workspace complete — container rebuilt."
    exit 0
    ;;
esac

ensure_container

# host_to_container <host-path>: map an absolute host path to its in-container
# equivalent. The two bind mounts are the workspace (at $container_ws =
# /home/spangap/<basename>) and /straddles (the flat --straddles checkout, when
# set), so a path under the workspace becomes $container_ws/<rel> and one under
# the straddles checkout becomes /straddles/<rel>. Used to turn a resolved
# straddle's host dir (which may live in either) into the --workdir for docker exec.
host_to_container() {
    local h=$1 sd
    case $h in
        "$workspace")   printf '%s\n' "$container_ws"; return ;;
        "$workspace"/*) printf '%s/%s\n' "$container_ws" "${h#"$workspace"/}"; return ;;
    esac
    sd=$(read_straddles)
    if [ -n "$sd" ]; then
        case $h in
            "$sd")   printf '/straddles\n'; return ;;
            "$sd"/*) printf '/straddles/%s\n' "${h#"$sd"/}"; return ;;
        esac
    fi
    die "path $h is under neither the workspace ($workspace) nor the --straddles checkout"
}

# Container cwd = host cwd remapped. find_workspace guarantees cwd is under the
# workspace, so this lands at $container_ws/<rel>.
container_cwd=$(host_to_container "$(pwd)")

exec_flags="-i"
[ -t 0 ] && [ -t 1 ] && exec_flags="-it"

# Pre-fetch host-side deps before delegating commands that need a complete
# workspace. `build` is the obvious one; `get-deps` runs the loop and exits.
# `docker <cmd>` is the raw escape hatch: docker-exec <cmd> in the build-env
# container, bypassing the in-container spangap wrapper.
case ${1:-} in
get-deps)
    command -v git >/dev/null 2>&1 || die "git required on host PATH"
    proj=$(require_straddle get-deps)
    # Re-derive container_cwd from the resolved straddle so get-deps also
    # works from the workspace root, resolving the cwd straddle or the last
    # build's target (.spangap-build) via require_straddle.
    container_cwd=$(host_to_container "$proj")
    fetch_missing_deps "$container_cwd"
    log "get-deps done — all requires: present"
    exit 0
    ;;
build)
    command -v git >/dev/null 2>&1 || die "git required on host PATH (for auto-clone + get-deps)"
    shift   # drop 'build'; "$@" is now the build args

    # The cwd straddle (a straddle.yaml at/above cwd, under the workspace), if
    # any — it outranks the remembered default, so `cd <straddle> && build`
    # builds THAT one, not the last target.
    cwd_straddle=""
    if c=$(find_straddle 2>/dev/null) \
        && case $c in "$workspace"|"$workspace"/*) true ;; *) false ;; esac; then
        cwd_straddle=$c
    fi

    # The host-side build target token. Precedence: an explicit leading
    # positional, else the cwd straddle, else the remembered target
    # (.spangap-build) so a bare `build` repeats the last one. The token may be
    # an idf passthrough (e.g. `menuconfig`) — that's fine; only slash-form
    # <org/repo> tokens get cloned, and workdir resolution degrades gracefully
    # when the token names no host straddle. spangap-inside resolves the build
    # authoritatively; this only steers what we clone and the build's workdir.
    explicit_tok=$(first_build_positional "$@") || explicit_tok=""
    target_tok=$explicit_tok
    use_remembered=
    if [ -z "$target_tok" ] && [ -z "$cwd_straddle" ]; then
        target_tok=$(remembered_build_target) || target_tok=""
        use_remembered=1
    fi

    # Acquire the project (clone mode): an <org>/<repo> target not yet present.
    # In --straddles mode clone_spec refuses and points at the checkout.
    case $target_tok in
        */*) project_host_dir "$target_tok" >/dev/null 2>&1 || clone_spec "$target_tok" ;;
    esac

    # Pre-clone any `--with <org>/<repo>` (slash-form) so the included straddle
    # is on disk before the container lists missing deps. The list-deps loop
    # then picks up its transitive requires: like any other sibling. Bare-form
    # `--with X` is left for spangap-inside to validate. On a bare replay the
    # --with set lives in .spangap-build, not argv, so pull it from there too.
    prefetch_explicit_includes "$@"
    if [ -n "$use_remembered" ]; then
        for inc in $(remembered_build_includes); do
            case $inc in
                */*) project_host_dir "$inc" >/dev/null 2>&1 || clone_spec "$inc" ;;
            esac
        done
    fi

    # container workdir: the target's dir if host-resolvable, else the cwd
    # straddle, else the workspace root (the container resolves the target /
    # remembered default itself). list-deps runs here too, so it inspects the
    # same straddle the build will. Also names the "building X" line.
    proj=""
    if proj=$(project_host_dir "$target_tok" 2>/dev/null); then
        :
    elif [ -n "$cwd_straddle" ]; then
        proj=$cwd_straddle
    fi
    if [ -n "$proj" ]; then
        container_cwd=$(host_to_container "$proj")
    else
        container_cwd="$container_ws"
    fi

    fetch_missing_deps "$container_cwd"
    # Quiet-by-default + the -v|--verbose flag now live in spangap-inside, so
    # the in-container build behaves the same however it's reached. We just
    # forward argv unchanged (including -v) and hand the build the host's
    # sticky serial port via $SPANGAP_PORT so its flash hint can name it.
    # The global SPANGAP_QUIET (set near the top of this file, off iff the
    # first build arg is -v/--verbose) still gates the host-side cloning +
    # container-setup phases.
    verbose=""
    for a in "$@"; do
        case $a in -v|--verbose) verbose=1 ;; esac
    done
    sticky_port=""
    [ -f "$PORT_FILE" ] && sticky_port=$(cat "$PORT_FILE")
    # Name what's building: the resolved straddle dir if we have one, else the
    # target token (the container makes the final call).
    if [ -n "$proj" ]; then
        proj_name=$(basename "$proj")
    else
        proj_name=${target_tok:-the remembered build}
    fi
    # The quiet build prints almost nothing until a diagnostic fires, so
    # announce what's building. The verbose build narrates itself.
    [ -z "$verbose" ] && log "building $proj_name"
    # No -t: keep output non-interactive (matches the previous piped path).
    set +e
    docker exec -i -e SPANGAP_PORT="$sticky_port" -e SPANGAP_WORKSPACE="$container_ws" \
        --workdir "$container_cwd" "$container" spangap build "$@"
    rc=$?
    set -e
    exit "$rc"
    ;;
shell)
    # Synonym for `spangap docker bash` — an interactive bash in the
    # build-env container, bypassing the in-container spangap wrapper. Any
    # trailing args are forwarded to bash (e.g. `spangap shell -c '...'`).
    shift
    # shellcheck disable=SC2086
    exec docker exec $exec_flags -e SPANGAP_WORKSPACE="$container_ws" \
        --workdir "$container_cwd" "$container" bash "$@"
    ;;
docker)
    shift
    [ $# -gt 0 ] || die "missing command (e.g. \`spangap docker sh\`)"
    # shellcheck disable=SC2086
    exec docker exec $exec_flags -e SPANGAP_WORKSPACE="$container_ws" \
        --workdir "$container_cwd" "$container" "$@"
    ;;
esac

# Anything outside doesn't understand goes through the in-container spangap
# wrapper, which sources IDF env then dispatches via the Python CLI.
# shellcheck disable=SC2086
exec docker exec $exec_flags -e SPANGAP_WORKSPACE="$container_ws" \
    --workdir "$container_cwd" "$container" spangap "$@"
