    # monitor that starts later would treat the stale signal as a fresh
    # reflash request and re-flash a board that's already current. (The
    # monitor loop consumes flashme itself on the signalled path; this covers
    # the port-free direct flash, which never goes through it.)
    rm -f "$flashme"
    exit 0
