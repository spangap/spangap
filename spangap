#!/bin/sh
# spangap — system-wide entry point. The ONE file users put on their PATH.
#
# Two responsibilities, nothing else:
#
#   `spangap init`     bootstrap a workspace HERE (refuses if cwd is already
#                      in/under one). Drops an empty spangap.workspace.yaml
#                      marker and clones the spangap repo into ./spangap/.
#   everything else    walk up from cwd looking for spangap.workspace.yaml
#                      and exec <ws>/spangap/build-system/spangap-outside
#                      with $SPANGAP_WORKSPACE set and the same argv.
#
# No Docker. Dep surface for `init`: POSIX sh + git + python3 (with the
# `venv` module — git clones the skeleton, python3 sets up the host-side
# flash/monitor venv inside the workspace). All real work lives in the
# per-workspace skeleton, so each workspace pins its own tooling
# independently of the installer.
set -eu

INIT_URL="${SPANGAP_INIT_URL:-https://github.com/spangap/spangap.git}"

die() { printf 'spangap: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
spangap — ESP-32 build system.

Usage:
  spangap init [--repo-path DIR] [<org>/<repo> | <url>]
  spangap <command> [args...]
  spangap --help | -h | help

init  (run outside any workspace; creates one in the current dir):
  --repo-path DIR    Use a local checkout of the spangap tree, laid out flat
                     as <DIR>/<repo>/ (every straddle a direct child). The
                     tree is bind-mounted into the build container (at /repos)
                     instead of straddles being cloned from github.
  <org>/<repo>       Optional project to start from. May also be a full
                     https:// URL. Becomes the default target for `build`,
                     `flash`, `monitor` from the workspace root. Init also
                     fetches the project's transitive deps so the first
                     build is immediate.
  -v, --verbose      Show docker build / git clone / dep-fetch output.
                     Without it, init prints one status line per phase.

Commands (run inside a workspace):
  build [-v|--verbose] [args...] Build the default (or cwd) straddle. Quiet
                                 by default; -v shows the full IDF / Vite
                                 output.
  get-deps                       Fetch missing straddles without building.
  flash [<port>]                 Flash the built firmware once and exit. Port
                                 is sticky. Chain `&& spangap monitor` to watch
                                 the board after flashing.
  monitor [<port>]               Attach the serial monitor (must be in/under
                                 a workspace).
  probe [<port>]                 Print chip + flash size of a connected
                                 board. Works outside a workspace.
  cli [-h <host>] [args...]      Talk to a running device over the network.
                                 Host is sticky like port.
  show                           List the project straddle and its deps in
                                 initialization order.
  reset                          Signal a running monitor to reset the device.
  reset-workspace                Wipe the build state (container + image) and
                                 start fresh.
  docker <cmd> [args...]         Drop into a shell on the build container,
                                 e.g. `spangap docker sh`.

Environment:
  SPANGAP_INIT_URL   Override the git URL cloned by `init` (default:
                     https://github.com/spangap/spangap.git).

See INTERNALS.md for how this hangs together under the hood.
EOF
}

# Walk up from cwd looking for the workspace marker. Echoes the workspace
# dir on stdout and returns 0; returns 1 with no output if none found. Used
# by the dispatcher AND by `init` to refuse nesting.
find_workspace() {
    cur=$(pwd)
    while :; do
        if [ -f "$cur/spangap.workspace.yaml" ]; then
            printf '%s\n' "$cur"
            return 0
        fi
        [ "$cur" = "/" ] && return 1
        cur=$(dirname "$cur")
    done
}

case ${1:-} in
-h|--help|help)
    usage
    exit 0
    ;;
init)
    if ws=$(find_workspace); then
        die "already inside workspace $ws — refusing to nest a new one here"
    fi
    [ -e spangap.workspace.yaml ] && die "spangap.workspace.yaml already exists in $PWD"
    [ -e spangap ] && die "./spangap already exists in $PWD"
    command -v git >/dev/null 2>&1 || die "git required for \`spangap init\` — install git and retry"
    command -v python3 >/dev/null 2>&1 || die "python3 required for \`spangap init\` (used to create the host-side flash/monitor venv) — install python3 (with the venv module) and retry"

    # init args:
    #   --repo-path <dir>   local source-of-truth checkout laid out flat as
    #                       <dir>/<repo>/. When given, the whole tree is
    #                       bind-mounted to /repos in the build container
    #                       (no per-straddle symlinks or clones — including
    #                       the skeleton, run from <dir>/spangap, and the
    #                       project); $workspace/.spangap-repo_path is
    #                       persisted so subsequent `spangap` commands find
    #                       the same tree.
    #   <project>           optional <org/repo> shorthand (→ github.com)
    #                       or a full https://... URL. Lands in a workspace
    #                       sibling so the user can `cd <repo> && spangap
    #                       build` right after init.
    #   -v|--verbose        show the docker build / git clone / dep-fetch
    #                       output. Without it, init prints one status
    #                       line per phase and suppresses the underlying
    #                       commands' output.
    shift
    repo_path_arg=
    project=
    verbose=
    while [ $# -gt 0 ]; do
        case $1 in
            -v|--verbose) verbose=1; shift ;;
            --repo-path)
                [ $# -ge 2 ] || die "spangap init: --repo-path needs a directory"
                repo_path_arg=$2
                shift 2 ;;
            --repo-path=*)
                repo_path_arg=${1#*=}
                shift ;;
            --) shift; break ;;
            -*) die "spangap init: unknown flag '$1'" ;;
            *)
                [ -z "$project" ] || die "spangap init: extra arg '$1' (project already set to '$project')"
                project=$1
                shift ;;
        esac
    done
    # Anything left after `--` is also treated as the project arg.
    if [ $# -gt 0 ]; then
        [ -z "$project" ] || die "spangap init: extra arg '$1' (project already set to '$project')"
        project=$1
    fi

    project_url=
    project_dir=
    if [ -n "$project" ]; then
        case $project in
            *://*)
                project_url=$project ;;
            *@*|*:*|*\ *)
                die "spangap init: project must be 'org/repo' or a URL; got '$project'" ;;
            */*)
                project_url="https://github.com/$project.git" ;;
            *)
                die "spangap init: project must be 'org/repo' or a URL; got '$project'" ;;
        esac
        project_dir=$(basename "$project_url" .git)
        [ -e "$project_dir" ] && die "./$project_dir already exists in $PWD"
    fi

    repo_path=
    if [ -n "$repo_path_arg" ]; then
        [ -d "$repo_path_arg" ] \
            || die "spangap init --repo-path: $repo_path_arg is not a directory"
        repo_path=$(cd "$repo_path_arg" && pwd)
    fi

    # Tag every spangap-outside helper we shell out to below (ensure-venv,
    # ensure-container, get-deps) so their status lines read "init:" rather
    # than the bare subcommand name — the whole flow is one init from the
    # user's point of view.
    export SPANGAP_PHASE=init

    : > spangap.workspace.yaml
    if [ -n "$repo_path" ]; then
        printf '%s\n' "$repo_path" > .spangap-repo_path
        echo "init: wrote .spangap-repo_path = $repo_path" >&2
    fi

    # Skeleton: the spangap build-system straddle. With a flat repo_path it's
    # at <repo_path>/spangap and reached there directly (the whole tree gets
    # bind-mounted to /repos in the container; the host-side dispatcher finds
    # spangap-outside under repo_path) — nothing is dropped in the workspace.
    # Without repo_path, git-clone it into ./spangap/ so the workspace carries
    # its own build system. skel_target is just where init invokes the
    # spangap-outside helpers from below.
    skel_target=
    if [ -n "$repo_path" ] && [ -d "$repo_path/spangap" ]; then
        echo "init: using spangap skeleton from $repo_path/spangap" >&2
        skel_target="$repo_path/spangap"
    else
        echo "init: cloning $INIT_URL into ./spangap/..." >&2
        git clone --quiet "$INIT_URL" spangap
        skel_target="$PWD/spangap"
    fi
    # Seed the workspace with the container assistant-instructions doc as
    # README.md. An in-container `spangap claude` writes a CLAUDE.md that just
    # points here, so this is the substantive file. Copied from the skeleton the
    # workspace was init'd with, so it tracks that build system's version.
    if [ -f "$skel_target/build-system/README.md" ]; then
        cp "$skel_target/build-system/README.md" README.md
        echo "init: wrote README.md (container assistant instructions)" >&2
    fi
    # Delegate venv setup to spangap-outside so the recipe lives in exactly
    # one place (it's also called lazily on flash/monitor for robustness).
    SPANGAP_WORKSPACE="$PWD" "$skel_target/build-system/spangap-outside" ensure-venv \
        || die "host-side flash/monitor venv setup failed (see above)"
    if [ -n "$project_url" ]; then
        # Project: under repo_path (flat, at <repo_path>/<project_dir>) it's
        # already in the /repos bind mount — nothing to place in the
        # workspace. Otherwise git-clone it into the bare project_dir.
        if [ -n "$repo_path" ] && [ -d "$repo_path/$project_dir" ]; then
            echo "init: using $project_dir from repo_path" >&2
        else
            echo "init: cloning $project_dir" >&2
            git clone --quiet "$project_url" "$project_dir"
        fi
        # Remember the project so subsequent commands run from the workspace
        # root (e.g. `spangap build`, `spangap flash`) default to it instead
        # of asking the user to cd. Records the bare project_dir; it's
        # reachable at /repos/<project_dir> (repo_path) or $workspace/<project_dir>
        # (clone) in the container.
        printf '%s\n' "$project_dir" > .spangap-project
    fi
    # Quiet by default — collapse the docker build / git clone /
    # dep-fetch noise into one status line per phase. -v|--verbose
    # turns it all back on. SPANGAP_QUIET propagates into spangap-outside
    # via the env (see the SPANGAP_QUIET=${SPANGAP_QUIET:-} preamble
    # there) and gates the docker build output, clone_spec per-repo
    # logging, etc.
    [ -z "$verbose" ] && export SPANGAP_QUIET=1

    # Pre-build the container so the first real `spangap build` (or
    # `spangap docker sh`, `spangap claude`, ...) doesn't pay the
    # image-build + container-create latency. Init is when the user is
    # already waiting for the workspace to come up, so the cost lands
    # at the natural moment.
    echo "init: building docker container (image build + container create)..." >&2
    SPANGAP_WORKSPACE="$PWD" "$skel_target/build-system/spangap-outside" ensure-container \
        || die "container setup failed (see above)"
    if [ -n "$project_url" ]; then
        # Fetch transitive deps so the workspace is build-ready right
        # after init. With repo_path, every dep checked out there is already
        # visible at /repos/<repo> and list-deps returns nothing (no-op);
        # any dep not in repo_path — and, without repo_path, all of them —
        # is git-cloned into the workspace so the first `spangap build`
        # doesn't pause to fetch them.
        SPANGAP_WORKSPACE="$PWD" "$skel_target/build-system/spangap-outside" get-deps \
            || die "transitive dep fetch failed (see above)"
    fi
    echo "init: workspace initialized at $PWD" >&2
    exit 0
    ;;
esac

# Resolve this script's real location so we can find spangap-outside when
# the user runs `spangap cli` / `spangap probe` outside any workspace.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *)  self=$(dirname "$self")/$link ;;
    esac
done
self_dir=$(cd "$(dirname "$self")" && pwd)
self_outside="$self_dir/build-system/spangap-outside"

if ws=$(find_workspace); then
    # spangap-outside lives in the spangap build-system straddle: under
    # repo_path at <repo_path>/spangap when init was given --repo-path
    # (nothing is dropped in the workspace), else the ./spangap clone.
    rp=
    [ -f "$ws/.spangap-repo_path" ] && rp=$(head -1 "$ws/.spangap-repo_path" 2>/dev/null)
    if [ -n "$rp" ] && [ -x "$rp/spangap/build-system/spangap-outside" ]; then
        outside="$rp/spangap/build-system/spangap-outside"
    else
        outside="$ws/spangap/build-system/spangap-outside"
    fi
    [ -x "$outside" ] \
        || die "spangap-outside not found ($outside) — re-clone or update the workspace skeleton, or check .spangap-repo_path"
    export SPANGAP_WORKSPACE="$ws"
    exec "$outside" "$@"
fi

# No workspace at/above cwd. A small set of commands (`cli`, `probe`) is still
# useful — they only need the host venv + a serial port or a host:port, not a
# built tree. `monitor` is deliberately NOT here: it logs and watches signal
# files in the workspace, so it only runs in/under one. Everything else still
# requires `spangap init`.
case ${1:-} in
    cli|probe)
        [ -x "$self_outside" ] \
            || die "spangap-outside not found at $self_outside — \`spangap $1\` outside a workspace needs the installed repo to remain intact"
        # SPANGAP_WORKSPACE points at $HOME so .spangap-port and friends have
        # somewhere to live; spangap-outside's no-straddle warning still fires.
        export SPANGAP_WORKSPACE="${HOME:-/tmp}"
        exec "$self_outside" "$@"
        ;;
esac

die "not in a spangap workspace (no spangap.workspace.yaml at/above $PWD) — run \`spangap init\` to start one"
