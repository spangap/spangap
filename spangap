#!/bin/sh
# spangap — system-wide entry point. The ONE file users put on their PATH.
#
# Two responsibilities, nothing else:
#
#   `spangap init`     bootstrap a workspace (in cwd, or in an optional [dir]
#                      it creates). Refuses if the target is already in/under a
#                      workspace. Drops an empty spangap.workspace.yaml marker
#                      and clones the spangap repo into ./spangap/. A project is
#                      NOT acquired here — `spangap build <org/repo>` does that.
#   everything else    walk up from cwd looking for spangap.workspace.yaml
#                      and exec <ws>/spangap/build-system/spangap-outside
#                      with $SPANGAP_WORKSPACE set and the same argv.
#
# No Docker. Dep surface for `init`: POSIX sh + git + python3 (with the
# `venv` module — git clones the skeleton, python3 sets up the host-side
# flash/monitor venv inside the workspace). All real work lives in the
# per-workspace skeleton, so each workspace pins its own tooling
# independently of the installer.
set -eu

INIT_URL="${SPANGAP_INIT_URL:-https://github.com/spangap/spangap.git}"

# Launcher contract version. Bumped ONLY when this script's dispatch/bootstrap
# behaviour changes (the init handoff, the env it exports, how it locates
# spangap-outside) — never for changes confined to spangap-outside. A workspace's
# spangap-outside compares this against the copy in its own skeleton and, when
# the skeleton is newer, upgrades the on-PATH launcher in place (or reports it
# isn't writeable). Exported so the running value travels with every exec below.
SPANGAP_LAUNCHER_VERSION=1
export SPANGAP_LAUNCHER_VERSION

die() { printf 'spangap: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
spangap — ESP-32 build system. Assembles + builds "straddles" in a per-workspace
Docker container; nothing but a small flash/monitor venv touches your host.

Usage:
  spangap init [-v] [<dir>]                     bootstrap a workspace
  spangap <command> [args...]                   run a command in a workspace
  spangap            (no command: same as `spangap show`)
  spangap --help | -h | help

Commands (run inside a workspace):
  build [<org/repo>] [args]  build a straddle (last target + --with/--without
                             remembered, so a bare `build` repeats it; -v shows
                             full IDF / Vite output)
  get-deps                   fetch missing dependency straddles without building
  flash [<port>]             flash the built firmware once (port is sticky)
  monitor [<port>]           attach the serial monitor
  probe [<port>]             print chip + flash size of a connected board
  cli [-h host] [args]       talk to a running device over the network (host
                             is sticky like port)
  dev [-h host]              run the browser dev server against a device
  show                       last build invocation + resolved straddle + deps
  reset                      signal a running monitor to reset the device
  reset-workspace            wipe build state (container + image) and rebuild
  docker <cmd> [args]        run a command on the build container (e.g. sh)
  shell                      interactive shell in the build container
  push-all [--force] [dir]   create + push every git repo under dir (default: the
                             workspace) to GitHub; host-only, uses your gh auth
  make-builds <builds-dir>   build every entry in <builds-dir>/builds.yaml and
                             copy each flasher.zip to <builds-dir>/main/<name>.zip

init  (run outside any workspace; creates one):
  <dir>              workspace directory. Created if absent; else init uses cwd.
                     A project is NOT acquired here — name one with
                     `spangap build <org>/<repo>` and it's cloned (with deps)
                     on first build and remembered for a bare `build`.
  -v, --verbose      show docker build / git clone output (one status line per
                     phase otherwise).

Environment:
  SPANGAP_INIT_URL   override the git URL cloned by `init` (default:
                     https://github.com/spangap/spangap.git).

Full docs: build-system/README.md. Internals: INTERNALS.md.
EOF
}

# Walk up from cwd looking for the workspace marker. Echoes the workspace
# dir on stdout and returns 0; returns 1 with no output if none found. Used
# by the dispatcher AND by `init` to refuse nesting.
find_workspace() {
    cur=$(pwd)
    while :; do
        if [ -f "$cur/spangap.workspace.yaml" ]; then
            printf '%s\n' "$cur"
            return 0
        fi
        [ "$cur" = "/" ] && return 1
        cur=$(dirname "$cur")
    done
}

case ${1:-} in
-h|--help|help)
    usage
    exit 0
    ;;
init)
    # init args:
    #   <dir>               optional workspace directory. Created if absent;
    #                       init then runs there. Without it, init uses cwd.
    #                       No <project> arg — `spangap build <org/repo>`
    #                       acquires (clones + remembers) the project.
    #   -v|--verbose        show the docker build / git clone output. Without
    #                       it, init prints one status line per phase and
    #                       suppresses the underlying commands' output.
    shift
    target_dir=
    verbose=
    cleanup_dir=
    while [ $# -gt 0 ]; do
        case $1 in
            -v|--verbose) verbose=1; shift ;;
            --) shift; break ;;
            -*) die "spangap init: unknown flag '$1'" ;;
            *)
                [ -z "$target_dir" ] || die "spangap init: extra arg '$1' (workspace dir already set to '$target_dir')"
                target_dir=$1
                shift ;;
        esac
    done
    # Anything left after `--` is also treated as the workspace-dir arg.
    if [ $# -gt 0 ]; then
        [ -z "$target_dir" ] || die "spangap init: extra arg '$1' (workspace dir already set to '$target_dir')"
        target_dir=$1
    fi

    # Resolve the workspace dir, creating it if asked, then cd in so the rest
    # of init operates on $PWD exactly as the cwd-only form did.
    if [ -n "$target_dir" ]; then
        we_created_dir=
        if [ -e "$target_dir" ]; then
            [ -d "$target_dir" ] \
                || die "spangap init: $target_dir exists and is not a directory"
        else
            mkdir -p "$target_dir" \
                || die "spangap init: could not create workspace directory $target_dir"
            echo "init: created workspace directory $target_dir" >&2
            we_created_dir=1
        fi
        cd "$target_dir" || die "spangap init: could not enter $target_dir"
        # If WE made this dir, we own its cleanup: arm a trap (with the absolute
        # path, post-cd) that rm -rf's it if any fallible step below fails, so a
        # failed init leaves no half-built workspace behind. Disarmed on success.
        # A pre-existing target dir or the cwd form is the user's — never removed.
        if [ -n "$we_created_dir" ]; then
            cleanup_dir=$PWD
            trap 'rm -rf "$cleanup_dir"' EXIT INT TERM HUP
        fi
    fi

    # Clobber/nest guards run against the resolved workspace dir (post-cd).
    if ws=$(find_workspace); then
        die "already inside workspace $ws — refusing to nest a new one here"
    fi
    [ -e spangap.workspace.yaml ] && die "spangap.workspace.yaml already exists in $PWD"
    # Refuse to init inside a clone of the spangap repo itself. Checked before
    # the ./spangap guard below so the repo *root* reports this (clearer) message
    # rather than the generic "./spangap already exists"; the build-system probe
    # also fires from a subdir of the clone, which the root-only ./spangap file
    # would miss — without it init would silently nest a workspace under the
    # build system's own source.
    [ -f build-system/spangap-inside ] && [ -f build-system/spangap-outside ] \
        && die "inside the spangap build-system repo ($PWD) — \`spangap init\` creates a workspace elsewhere; run it in an empty dir (or pass one: spangap init <dir>)"
    # Refuse to nest a workspace inside a straddle. A straddle is a unit of
    # distributable code (marked by straddle.yaml at its root); init creates a
    # *workspace* (the build-env that assembles straddles), not a straddle, so
    # running it here is always a mistake.
    [ -e straddle.yaml ] && die "inside a straddle dir ($PWD) — \`spangap init\` creates a workspace, not a straddle; run it in an empty dir (or pass one: spangap init <dir>)"
    # Leftover ./spangap (e.g. a previous init's clone that failed mid-flow).
    [ -e spangap ] && die "./spangap already exists in $PWD"
    command -v git >/dev/null 2>&1 || die "git required for \`spangap init\` — install git and retry"
    command -v python3 >/dev/null 2>&1 || die "python3 required for \`spangap init\` (used to create the host-side flash/monitor venv) — install python3 (with the venv module) and retry"

    # Tag every spangap-outside helper we shell out to below (ensure-venv,
    # ensure-container) so their status lines read "init:" rather than the
    # bare subcommand name — the whole flow is one init from the user's point
    # of view.
    export SPANGAP_PHASE=init

    # NB: spangap.workspace.yaml — the workspace *marker* — is written LAST,
    # only once every fallible step below (venv, container build) has
    # succeeded. Its presence is what `find_workspace` keys off and what this
    # `init` refuses to clobber, so writing it up front would brick a retry
    # after a mid-flow failure ("spangap.workspace.yaml already exists").

    # Skeleton: the spangap build-system straddle. Git-clone it into ./spangap/
    # so the workspace carries its own build system. skel_target is just where
    # init invokes the spangap-outside helpers from below.
    echo "init: cloning $INIT_URL into ./spangap/..." >&2
    git clone --quiet "$INIT_URL" spangap
    skel_target="$PWD/spangap"
    # Quiet by default — collapse the docker build / git clone noise into one
    # status line per phase. -v|--verbose turns it all back on. SPANGAP_QUIET
    # propagates into spangap-outside via the env (see the ${SPANGAP_QUIET+set}
    # preamble there) and gates the docker build output, clone_spec per-repo
    # logging, etc. Export it either way — empty for verbose — so spangap-outside
    # (which now defaults every verb to quiet) sees the explicit choice rather
    # than re-deriving it from argv that no longer carries init's -v.
    if [ -z "$verbose" ]; then export SPANGAP_QUIET=1; else export SPANGAP_QUIET=; fi

    # Hand the rest of init to spangap-outside's `init-continue`: seed README.md,
    # build the host venv, pre-build the container, and drop the workspace marker
    # last. Those steps live there (not here) so they version with the skeleton
    # the workspace was init'd with, leaving this launcher as pure bootstrap.
    #
    # NOT exec'd: the cleanup trap armed above must survive to rm -rf a
    # workspace dir WE created if init-continue fails partway. On success
    # init-continue writes spangap.workspace.yaml as its final act and returns 0;
    # we then disarm the trap so the finished workspace survives exit. The
    # "marker written last" invariant is preserved across the handoff.
    SPANGAP_WORKSPACE="$PWD" "$skel_target/build-system/spangap-outside" init-continue \
        || die "workspace initialization failed (see above)"
    trap - EXIT INT TERM HUP
    exit 0
    ;;
esac

if ws=$(find_workspace); then
    # spangap-outside lives in the spangap build-system straddle, cloned into
    # the workspace at <ws>/spangap.
    outside="$ws/spangap/build-system/spangap-outside"
    [ -x "$outside" ] \
        || die "spangap-outside not found ($outside) — re-clone or update the workspace skeleton"
    export SPANGAP_WORKSPACE="$ws"
    exec "$outside" "$@"
fi

# No workspace at/above cwd. Every command other than `init` (handled above)
# needs one — including `cli`/`probe`, which read/write sticky state files in
# the workspace. So there's nothing left to dispatch: point the user at `init`.
die "not in a spangap workspace (no spangap.workspace.yaml at/above $PWD) — run \`spangap init\` to start one"
