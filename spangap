#!/bin/sh
# spangap — system-wide entry point. The ONE file users put on their PATH.
#
# Two responsibilities, nothing else:
#
#   `spangap init`     bootstrap a workspace (in cwd, or in an optional [dir]
#                      it creates). Refuses if the target is already in/under a
#                      workspace. Drops an empty spangap.workspace.yaml marker
#                      and clones the spangap repo into ./spangap/. A project is
#                      NOT acquired here — `spangap build <org/repo>` does that.
#   everything else    walk up from cwd looking for spangap.workspace.yaml
#                      and exec <ws>/spangap/build-system/spangap-outside
#                      with $SPANGAP_WORKSPACE set and the same argv.
#
# No Docker. Dep surface for `init`: POSIX sh + git + python3 (with the
# `venv` module — git clones the skeleton, python3 sets up the host-side
# flash/monitor venv inside the workspace). All real work lives in the
# per-workspace skeleton, so each workspace pins its own tooling
# independently of the installer.
set -eu

INIT_URL="${SPANGAP_INIT_URL:-https://github.com/spangap/spangap.git}"

die() { printf 'spangap: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
spangap — ESP-32 build system.

Usage:
  spangap init [--straddles DIR] [<dir>]
  spangap <command> [args...]
  spangap            (no command: same as `spangap show`)
  spangap --help | -h | help

init  (run outside any workspace; creates an empty workspace):
  <dir>              Optional workspace directory. Created if it doesn't exist;
                     init then runs there. Without it, init uses the current
                     dir. A project is NOT acquired at init — name one with
                     `spangap build <org>/<repo>` and it's cloned (with its
                     deps) on first build and remembered for bare `build`.
  --straddles DIR    Use a local checkout of the spangap tree, laid out flat
                     as <DIR>/<repo>/ (every straddle a direct child). The
                     tree is bind-mounted into the build container (at
                     /straddles) instead of straddles being cloned from github.
  -v, --verbose      Show docker build / git clone output. Without it, init
                     prints one status line per phase.

Commands (run inside a workspace):
  build [<org/repo>] [args...]   Build a straddle. Name it as <org>/<repo>
                                 (cloned with its deps if missing), or omit to
                                 reuse the cwd straddle / the last build. The
                                 target + --with/--without are remembered, so a
                                 bare `build` repeats the last one. -v shows the
                                 full IDF / Vite output (quiet by default).
  get-deps                       Fetch missing straddles without building.
  flash [<port>]                 Flash the built firmware once and exit. Port
                                 is sticky. Chain `&& spangap monitor` to watch
                                 the board after flashing.
  monitor [<port>]               Attach the serial monitor (must be in/under
                                 a workspace).
  probe [<port>]                 Print chip + flash size of a connected
                                 board. Works outside a workspace.
  cli [-h <host>] [args...]      Talk to a running device over the network.
                                 Host is sticky like port.
  show                           Show the last build invocation, its resolved
                                 straddle, and its deps in initialization order.
                                 (Bare `spangap` with no command does the same.)
  reset                          Signal a running monitor to reset the device.
  reset-workspace                Wipe the build state (container + image) and
                                 start fresh.
  docker <cmd> [args...]         Drop into a shell on the build container,
                                 e.g. `spangap docker sh`.

Environment:
  SPANGAP_INIT_URL   Override the git URL cloned by `init` (default:
                     https://github.com/spangap/spangap.git).

See INTERNALS.md for how this hangs together under the hood.
EOF
}

# Walk up from cwd looking for the workspace marker. Echoes the workspace
# dir on stdout and returns 0; returns 1 with no output if none found. Used
# by the dispatcher AND by `init` to refuse nesting.
find_workspace() {
    cur=$(pwd)
    while :; do
        if [ -f "$cur/spangap.workspace.yaml" ]; then
            printf '%s\n' "$cur"
            return 0
        fi
        [ "$cur" = "/" ] && return 1
        cur=$(dirname "$cur")
    done
}

case ${1:-} in
-h|--help|help)
    usage
    exit 0
    ;;
init)
    # init args:
    #   <dir>               optional workspace directory. Created if absent;
    #                       init then runs there. Without it, init uses cwd.
    #                       No <project> arg — `spangap build <org/repo>`
    #                       acquires (clones + remembers) the project.
    #   --straddles <dir>   local source-of-truth checkout laid out flat as
    #                       <dir>/<repo>/. When given, the whole tree is
    #                       bind-mounted to /straddles in the build container
    #                       (no per-straddle symlinks or clones — including the
    #                       skeleton, run from <dir>/spangap); the path is
    #                       persisted to $workspace/.spangap-straddles so
    #                       subsequent `spangap` commands find the same tree.
    #   -v|--verbose        show the docker build / git clone output. Without
    #                       it, init prints one status line per phase and
    #                       suppresses the underlying commands' output.
    shift
    straddles_arg=
    target_dir=
    verbose=
    cleanup_dir=
    while [ $# -gt 0 ]; do
        case $1 in
            -v|--verbose) verbose=1; shift ;;
            --straddles)
                [ $# -ge 2 ] || die "spangap init: --straddles needs a directory"
                straddles_arg=$2
                shift 2 ;;
            --straddles=*)
                straddles_arg=${1#*=}
                shift ;;
            --) shift; break ;;
            -*) die "spangap init: unknown flag '$1'" ;;
            *)
                [ -z "$target_dir" ] || die "spangap init: extra arg '$1' (workspace dir already set to '$target_dir')"
                target_dir=$1
                shift ;;
        esac
    done
    # Anything left after `--` is also treated as the workspace-dir arg.
    if [ $# -gt 0 ]; then
        [ -z "$target_dir" ] || die "spangap init: extra arg '$1' (workspace dir already set to '$target_dir')"
        target_dir=$1
    fi

    # Resolve the workspace dir, creating it if asked, then cd in so the rest
    # of init operates on $PWD exactly as the cwd-only form did.
    if [ -n "$target_dir" ]; then
        we_created_dir=
        if [ -e "$target_dir" ]; then
            [ -d "$target_dir" ] \
                || die "spangap init: $target_dir exists and is not a directory"
        else
            mkdir -p "$target_dir" \
                || die "spangap init: could not create workspace directory $target_dir"
            echo "init: created workspace directory $target_dir" >&2
            we_created_dir=1
        fi
        cd "$target_dir" || die "spangap init: could not enter $target_dir"
        # If WE made this dir, we own its cleanup: arm a trap (with the absolute
        # path, post-cd) that rm -rf's it if any fallible step below fails, so a
        # failed init leaves no half-built workspace behind. Disarmed on success.
        # A pre-existing target dir or the cwd form is the user's — never removed.
        if [ -n "$we_created_dir" ]; then
            cleanup_dir=$PWD
            trap 'rm -rf "$cleanup_dir"' EXIT INT TERM HUP
        fi
    fi

    # Clobber/nest guards run against the resolved workspace dir (post-cd).
    if ws=$(find_workspace); then
        die "already inside workspace $ws — refusing to nest a new one here"
    fi
    [ -e spangap.workspace.yaml ] && die "spangap.workspace.yaml already exists in $PWD"
    # Refuse to init inside a clone of the spangap repo itself. Checked before
    # the ./spangap guard below so the repo *root* reports this (clearer) message
    # rather than the generic "./spangap already exists"; the build-system probe
    # also fires from a subdir of the clone, which the root-only ./spangap file
    # would miss — without it init would silently nest a workspace under the
    # build system's own source.
    [ -f build-system/spangap-inside ] && [ -f build-system/spangap-outside ] \
        && die "inside the spangap build-system repo ($PWD) — \`spangap init\` creates a workspace elsewhere; run it in an empty dir (or pass one: spangap init <dir>)"
    # Refuse to nest a workspace inside a straddle. A straddle is a unit of
    # distributable code (marked by straddle.yaml at its root); init creates a
    # *workspace* (the build-env that assembles straddles), not a straddle, so
    # running it here is always a mistake (a flat --straddles checkout has no
    # workspace marker up-tree, so find_workspace won't catch this).
    [ -e straddle.yaml ] && die "inside a straddle dir ($PWD) — \`spangap init\` creates a workspace, not a straddle; run it in an empty dir (or pass one: spangap init <dir>)"
    # Leftover ./spangap (e.g. a previous init's clone that failed mid-flow).
    [ -e spangap ] && die "./spangap already exists in $PWD"
    command -v git >/dev/null 2>&1 || die "git required for \`spangap init\` — install git and retry"
    command -v python3 >/dev/null 2>&1 || die "python3 required for \`spangap init\` (used to create the host-side flash/monitor venv) — install python3 (with the venv module) and retry"

    straddles=
    if [ -n "$straddles_arg" ]; then
        [ -d "$straddles_arg" ] \
            || die "spangap init --straddles: $straddles_arg is not a directory"
        straddles=$(cd "$straddles_arg" && pwd)
    fi

    # Tag every spangap-outside helper we shell out to below (ensure-venv,
    # ensure-container) so their status lines read "init:" rather than the
    # bare subcommand name — the whole flow is one init from the user's point
    # of view.
    export SPANGAP_PHASE=init

    # NB: spangap.workspace.yaml — the workspace *marker* — is written LAST,
    # only once every fallible step below (venv, container build) has
    # succeeded. Its presence is what `find_workspace` keys off and what this
    # `init` refuses to clobber, so writing it up front would brick a retry
    # after a mid-flow failure ("spangap.workspace.yaml already exists"). The
    # intermediate .spangap-straddles below is needed by the spangap-outside
    # helpers we invoke *during* init, so it's written here and simply
    # overwritten on a retry.
    if [ -n "$straddles" ]; then
        printf '%s\n' "$straddles" > .spangap-straddles
        echo "init: wrote .spangap-straddles = $straddles" >&2
    fi

    # Skeleton: the spangap build-system straddle. With a flat --straddles
    # checkout it's at <straddles>/spangap and reached there directly (the whole
    # tree gets bind-mounted to /straddles in the container; the host-side
    # dispatcher finds spangap-outside under the checkout) — nothing is dropped
    # in the workspace. Without --straddles, git-clone it into ./spangap/ so the
    # workspace carries its own build system. skel_target is just where init
    # invokes the spangap-outside helpers from below.
    skel_target=
    if [ -n "$straddles" ] && [ -d "$straddles/spangap" ]; then
        echo "init: using spangap skeleton from $straddles/spangap" >&2
        skel_target="$straddles/spangap"
    else
        echo "init: cloning $INIT_URL into ./spangap/..." >&2
        git clone --quiet "$INIT_URL" spangap
        skel_target="$PWD/spangap"
    fi
    # Seed the workspace with the container assistant-instructions doc as
    # README.md. An in-container `spangap claude` writes a CLAUDE.md that just
    # points here, so this is the substantive file. Copied from the skeleton the
    # workspace was init'd with, so it tracks that build system's version.
    if [ -f "$skel_target/build-system/README.md" ]; then
        cp "$skel_target/build-system/README.md" README.md
        echo "init: wrote README.md (container assistant instructions)" >&2
    fi
    # Delegate venv setup to spangap-outside so the recipe lives in exactly
    # one place (it's also called lazily on flash/monitor for robustness).
    SPANGAP_WORKSPACE="$PWD" "$skel_target/build-system/spangap-outside" ensure-venv \
        || die "host-side flash/monitor venv setup failed (see above)"
    # Quiet by default — collapse the docker build / git clone noise into one
    # status line per phase. -v|--verbose turns it all back on. SPANGAP_QUIET
    # propagates into spangap-outside via the env (see the ${SPANGAP_QUIET+set}
    # preamble there) and gates the docker build output, clone_spec per-repo
    # logging, etc. Export it either way — empty for verbose — so spangap-outside
    # (which now defaults every verb to quiet) sees the explicit choice rather
    # than re-deriving it from argv that no longer carries init's -v.
    if [ -z "$verbose" ]; then export SPANGAP_QUIET=1; else export SPANGAP_QUIET=; fi

    # Pre-build the container so the first real `spangap build` (or
    # `spangap docker sh`, `spangap claude`, ...) doesn't pay the
    # image-build + container-create latency. Init is when the user is
    # already waiting for the workspace to come up, so the cost lands
    # at the natural moment. The project itself (and its deps) is acquired
    # later, by the first `spangap build <org/repo>`.
    echo "init: building docker container (image build + container create)..." >&2
    SPANGAP_WORKSPACE="$PWD" "$skel_target/build-system/spangap-outside" ensure-container \
        || die "container setup failed (see above)"
    # Everything succeeded — now drop the workspace marker. Written last so a
    # failure anywhere above leaves no marker behind: a created-dir init is
    # removed wholesale by the cleanup trap, and the cwd / pre-existing-dir form
    # (no marker, no trap) can simply be re-run in place.
    : > spangap.workspace.yaml
    # Success — disarm the cleanup trap so the finished workspace survives exit.
    trap - EXIT INT TERM HUP
    echo "init: workspace initialized at $PWD" >&2
    exit 0
    ;;
esac

# Resolve this script's real location so we can find spangap-outside when
# the user runs `spangap cli` / `spangap probe` outside any workspace.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *)  self=$(dirname "$self")/$link ;;
    esac
done
self_dir=$(cd "$(dirname "$self")" && pwd)
self_outside="$self_dir/build-system/spangap-outside"

if ws=$(find_workspace); then
    # spangap-outside lives in the spangap build-system straddle: under the
    # straddles checkout at <straddles>/spangap when init was given --straddles
    # (nothing is dropped in the workspace), else the ./spangap clone.
    sd=
    [ -f "$ws/.spangap-straddles" ] && sd=$(head -1 "$ws/.spangap-straddles" 2>/dev/null)
    if [ -n "$sd" ] && [ -x "$sd/spangap/build-system/spangap-outside" ]; then
        outside="$sd/spangap/build-system/spangap-outside"
    else
        outside="$ws/spangap/build-system/spangap-outside"
    fi
    [ -x "$outside" ] \
        || die "spangap-outside not found ($outside) — re-clone or update the workspace skeleton, or check .spangap-straddles"
    export SPANGAP_WORKSPACE="$ws"
    exec "$outside" "$@"
fi

# No workspace at/above cwd. A small set of commands (`cli`, `probe`) is still
# useful — they only need the host venv + a serial port or a host:port, not a
# built tree. `monitor` is deliberately NOT here: it logs and watches signal
# files in the workspace, so it only runs in/under one. Everything else still
# requires `spangap init`.
case ${1:-} in
    cli|probe)
        [ -x "$self_outside" ] \
            || die "spangap-outside not found at $self_outside — \`spangap $1\` outside a workspace needs the installed repo to remain intact"
        # SPANGAP_WORKSPACE points at $HOME so .spangap-port and friends have
        # somewhere to live; spangap-outside's no-straddle warning still fires.
        export SPANGAP_WORKSPACE="${HOME:-/tmp}"
        exec "$self_outside" "$@"
        ;;
esac

die "not in a spangap workspace (no spangap.workspace.yaml at/above $PWD) — run \`spangap init\` to start one"
